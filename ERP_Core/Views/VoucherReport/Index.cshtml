@model ERP_Core.Dtos.VoucherReportViewModel

@{
    ViewData["Title"] = "Voucher Report";
    ViewData["SubTitle"] = "BP, CP, BR, CR aur JV vouchers ka tafseeli statement aur double-entry record.";
}

@section Styles {
    <!-- TomSelect for Searchable Account & Voucher Dropdowns -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />

    <style>
        .filter-bar-modern {
            background: var(--surface, #132420);
            border: 1px solid var(--border, #2C4740);
            border-radius: var(--radius, 10px);
            padding: 16px 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
        }

        .filter-grid-voucher {
            display: grid;
            grid-template-columns: 140px 140px 180px 220px minmax(220px, 1fr) auto;
            gap: 12px;
            align-items: flex-end;
        }

        @@media (max-width: 1200px) {
            .filter-grid-voucher {
                grid-template-columns: 1fr 1fr 1fr;
            }
        }

        @@media (max-width: 768px) {
            .filter-grid-voucher {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 576px) {
            .filter-grid-voucher {
                grid-template-columns: 1fr;
            }
        }

        /* Stat Cards */
        .stat-grid-voucher {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 22px;
        }

        @@media (max-width: 992px) {
            .stat-grid-voucher {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .stat-grid-voucher {
                grid-template-columns: 1fr;
            }
        }

        .stat-box-modern {
            background: linear-gradient(135deg, var(--surface, #132420) 0%, var(--surface2, #1A2F2A) 100%);
            border: 1px solid var(--border, #2C4740);
            border-radius: var(--radius, 10px);
            padding: 16px 18px;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .stat-box-modern:hover {
            transform: translateY(-2px);
            border-color: var(--brass, #C68A3E);
        }

        .stat-box-modern .stat-lbl {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-dim, #9FB6AF);
            margin-bottom: 6px;
        }

        .stat-box-modern .stat-num {
            font-size: 22px;
            font-weight: 700;
            color: var(--text, #EAF1EE);
            line-height: 1.1;
        }

        .stat-box-modern .stat-sub {
            font-size: 11.5px;
            color: var(--text-faint, #5E7873);
            margin-top: 4px;
        }

        .stat-glow-green .stat-num { color: var(--green-text, #6FE0A0); }
        .stat-glow-red .stat-num { color: var(--red-text, #FF8A7A); }
        .stat-glow-brass .stat-num { color: var(--brass-text, #E3AE66); }
        .stat-glow-blue .stat-num { color: #60a5fa; }

        /* Voucher Type Badges */
        .badge-vtype {
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
            display: inline-block;
            letter-spacing: 0.4px;
        }
        .badge-vtype-bp {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.35);
        }
        .badge-vtype-cp {
            background: rgba(198, 138, 62, 0.15);
            color: var(--brass-text, #E3AE66);
            border: 1px solid rgba(198, 138, 62, 0.35);
        }
        .badge-vtype-br {
            background: rgba(16, 185, 129, 0.15);
            color: var(--green-text, #6FE0A0);
            border: 1px solid rgba(16, 185, 129, 0.35);
        }
        .badge-vtype-cr {
            background: rgba(6, 182, 212, 0.15);
            color: #22d3ee;
            border: 1px solid rgba(6, 182, 212, 0.35);
        }
        .badge-vtype-jv {
            background: rgba(168, 85, 247, 0.15);
            color: #c084fc;
            border: 1px solid rgba(168, 85, 247, 0.35);
        }

        /* --------------------------------------------------------------------- */
        /* SINGLE-ROW VOUCHER GROUP STYLING (All entries in 1 row, no line split) */
        /* --------------------------------------------------------------------- */
        .dynamic-table tbody tr.voucher-main-row {
            border-bottom: 1px solid var(--border, #2C4740) !important;
            transition: background-color 0.15s ease;
        }
        .dynamic-table tbody tr.voucher-main-row:hover {
            background-color: rgba(198, 138, 62, 0.08) !important;
        }

        .dynamic-table tbody tr.voucher-main-row td {
            border-bottom: 1px solid var(--border, #2C4740) !important;
            border-top: none !important;
            padding: 8px 10px;
        }

        .dynamic-table tbody tr.voucher-main-row td.v-subcell {
            padding: 0 !important;
            vertical-align: top;
            white-space: normal !important;
        }

        /* Sub-lines for each entry inside the same row: NO separating border line */
        .v-subline {
            min-height: 38px;
            padding: 6px 10px;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            border-bottom: none !important;
            border-top: none !important;
            white-space: normal !important;
            word-break: break-word !important;
            line-height: 1.35;
        }

        .filtered-subline {
            background-color: rgba(198, 138, 62, 0.12);
        }

        /* TomSelect overrides */
        .ts-control {
            background-color: var(--surface2, #1A2F2A) !important;
            border: 1px solid var(--border, #2C4740) !important;
            color: var(--text, #EAF1EE) !important;
            border-radius: 8px !important;
            min-height: 38px !important;
            padding: 6px 12px !important;
            font-size: 13px !important;
        }
        .ts-dropdown {
            background-color: var(--surface, #132420) !important;
            border: 1px solid var(--border, #2C4740) !important;
            color: var(--text, #EAF1EE) !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5) !important;
            z-index: 1050 !important;
        }
        .ts-dropdown .option {
            padding: 8px 12px !important;
            color: var(--text, #EAF1EE) !important;
            font-size: 13px !important;
        }
        .ts-dropdown .option:hover, .ts-dropdown .active {
            background-color: rgba(198, 138, 62, 0.25) !important;
            color: var(--brass-text, #E3AE66) !important;
        }

        /* Universal Print Modal Sizing Fix */
        #printModal .print-paper {
            width: 215mm !important;
            max-width: 96vw !important;
            padding: 8mm 12mm !important;
            box-sizing: border-box !important;
            background: #fff !important;
            color: #000 !important;
        }
        #printModal .print-modal-bar {
            width: 215mm !important;
            max-width: 96vw !important;
        }

        /* Scoped styles for Voucher Print Tables */
        #printModal .print-paper table.voucher-slip-table,
        #printModal .print-paper table.voucher-full-report-table {
            width: 100% !important;
            table-layout: fixed !important;
            border-collapse: collapse !important;
            margin-bottom: 16px !important;
            box-sizing: border-box !important;
        }
        #printModal .print-paper table.voucher-slip-table th,
        #printModal .print-paper table.voucher-full-report-table th {
            background: #f1f5f9 !important;
            color: #0f172a !important;
            border: 1px solid #cbd5e1 !important;
            font-size: 10.5px !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.4px !important;
            padding: 6px 4px !important;
            box-sizing: border-box !important;
        }
        #printModal .print-paper table.voucher-slip-table td,
        #printModal .print-paper table.voucher-full-report-table td {
            border: 1px solid #e2e8f0 !important;
            padding: 6px 6px !important;
            vertical-align: top !important;
            white-space: normal !important;
            word-break: break-word !important;
            overflow-wrap: anywhere !important;
            box-sizing: border-box !important;
            line-height: 1.35 !important;
        }
        #printModal .print-paper table.voucher-slip-table td.num-cell,
        #printModal .print-paper table.voucher-slip-table th.num-cell,
        #printModal .print-paper table.voucher-slip-table tfoot td.num-cell {
            white-space: nowrap !important;
            text-align: right !important;
            padding: 6px 4px !important;
            box-sizing: border-box !important;
            font-size: 12px !important;
            border: 1px solid #cbd5e1 !important;
        }

        #printModal .print-paper table.voucher-full-report-table td.num-cell,
        #printModal .print-paper table.voucher-full-report-table th.num-cell,
        #printModal .print-paper table.voucher-full-report-table tfoot td.num-cell {
            white-space: nowrap !important;
            text-align: right !important;
            padding: 5px 4px !important;
            box-sizing: border-box !important;
            font-size: 11px !important;
            border: 1px solid #cbd5e1 !important;
        }

        /* Multi-page reports: Footer totals appear ONLY ONCE at the very end of the table, never repeating on every page */
        #printModal .print-paper table.voucher-full-report-table tfoot,
        #printModal .print-paper table.voucher-slip-table tfoot,
        table.voucher-full-report-table tfoot,
        table.voucher-slip-table tfoot,
        .pp-table tfoot {
            display: table-row-group !important;
            page-break-inside: avoid !important;
            page-break-after: auto !important;
        }

        @@media print {
            .no-print, .sidebar, .topbar, .filter-bar-modern, .toolbar, .stat-grid-voucher {
                display: none !important;
            }
            body {
                background: #fff !important;
                color: #000 !important;
            }
            .card {
                box-shadow: none !important;
                border: none !important;
                background: #fff !important;
            }
            .table-wrap {
                overflow: visible !important;
            }
            .dynamic-table th, .dynamic-table td {
                color: #000 !important;
                border-color: #ddd !important;
            }

            /* Header on every page; Total Summary ONLY once at the very end */
            thead,
            table.voucher-full-report-table thead,
            .pp-table thead {
                display: table-header-group !important;
            }
            tfoot,
            table.voucher-full-report-table tfoot,
            .pp-table tfoot {
                display: table-row-group !important;
                page-break-after: avoid !important;
            }
            tr {
                page-break-inside: avoid !important;
            }
        }
    </style>
}

<!-- ========================================================================= -->
<!-- TOOLBAR                                                                   -->
<!-- ========================================================================= -->
<div class="toolbar" style="margin-bottom:14px;">
    <div>
        <div class="section-title" style="margin-bottom:2px;">Voucher Report</div>
        <div class="section-desc" style="margin-bottom:0;">
            Bank Payment (BP), Cash Payment (CP), Bank Receipt (BR), Cash Receipt (CR) aur Journal Vouchers (JV) ka tafseeli statement.
        </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button type="button" class="btn brass" onclick="printFilteredVoucherReport()" style="display:inline-flex;align-items:center;gap:6px;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            <span>Print Report</span>
        </button>
        <a href="@Url.Action("ExportCsv", "VoucherReport", new { fromDate = Model.FromDate, toDate = Model.ToDate, voucherType = Model.SelectedVoucherType, voucherNo = Model.SelectedVoucherNo, accountId = Model.SelectedAccountId })" 
           class="btn ghost" style="display:inline-flex;align-items:center;gap:6px;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Export CSV</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:var(--green-dim);color:var(--green-text);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid var(--border);">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background:rgba(239,68,68,0.15);color:var(--red-text,#ef4444);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid rgba(239,68,68,0.3);">
        @TempData["ErrorMessage"]
    </div>
}

<!-- ========================================================================= -->
<!-- FILTER BAR (5 Exact Inputs)                                               -->
<!-- 1. From Date (Default: Today)                                             -->
<!-- 2. To Date (Default: Today)                                               -->
<!-- 3. Voucher Type (BP, CP, BR, CR, JV)                                      -->
<!-- 4. Voucher (Dependent dropdown matching selected type)                    -->
<!-- 5. Chart of Account Option                                                -->
<!-- ========================================================================= -->
<div class="filter-bar-modern no-print">
    <form method="get" asp-controller="VoucherReport" asp-action="Index" id="voucherReportForm">
        <div class="filter-grid-voucher">
            
            <!-- Input 1: From Date (Default Today) -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">From Date</label>
                <input type="date" name="fromDate" id="filterFromDate" value="@Model.FromDate" required
                       style="height:38px;padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;" />
            </div>

            <!-- Input 2: To Date (Default Today) -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">To Date</label>
                <input type="date" name="toDate" id="filterToDate" value="@Model.ToDate" required
                       style="height:38px;padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;" />
            </div>

            <!-- Input 3: Voucher Type (BP, CP, BR, CR, JV) -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">Voucher Type</label>
                <select name="voucherType" id="filterVoucherType"
                        style="height:38px;padding:6px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;">
                    @foreach (var opt in Model.VoucherTypesList)
                    {
                        <option value="@opt.Code" selected="@(string.Equals(Model.SelectedVoucherType ?? "", opt.Code, StringComparison.OrdinalIgnoreCase))">
                            @opt.Name
                        </option>
                    }
                </select>
            </div>

            <!-- Input 4: Voucher (Dependent on selected voucher type) -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">
                    Voucher #
                    <span id="voucherLoadingSpinner" style="display:none;margin-left:4px;color:var(--brass-text);font-size:11px;">(Loading...)</span>
                </label>
                <select name="voucherNo" id="filterVoucherNo" class="searchable-voucher-select" style="width:100%;">
                    <option value="">-- All Vouchers --</option>
                    @foreach (var v in Model.VouchersList)
                    {
                        <option value="@v.VoucherNo" selected="@(string.Equals(Model.SelectedVoucherNo ?? "", v.VoucherNo, StringComparison.OrdinalIgnoreCase))">
                            @v.DisplayText
                        </option>
                    }
                </select>
            </div>

            <!-- Input 5: Chart of Account Option (Transable COA) -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">Chart of Account (COA)</label>
                <select name="accountId" id="filterAccountSelect" class="searchable-account-select" style="width:100%;">
                    <option value="">-- All Chart of Accounts --</option>
                    @foreach (var acc in Model.AccountsList)
                    {
                        <option value="@acc.Id" selected="@(Model.SelectedAccountId == acc.Id)">
                            @acc.DisplayText @(!string.IsNullOrEmpty(acc.NatureName) ? $"({acc.NatureName})" : "")
                        </option>
                    }
                </select>
            </div>

            <!-- Filter Actions -->
            <div style="display:flex;gap:8px;align-items:flex-end;">
                <button type="submit" class="btn brass" style="height:38px;padding:0 18px;font-size:13px;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    Filter Report
                </button>
                <a href="/VoucherReport" class="btn ghost" style="height:38px;padding:0 14px;font-size:13px;display:inline-flex;align-items:center;">
                    Reset
                </a>
            </div>

        </div>
    </form>
</div>

<!-- ========================================================================= -->
<!-- SUMMARY STAT CARDS                                                        -->
<!-- ========================================================================= -->
<div class="stat-grid-voucher no-print">
    <!-- Total Vouchers -->
    <div class="stat-box-modern stat-glow-brass">
        <div class="stat-lbl">TOTAL VOUCHERS</div>
        <div class="stat-num">@Model.TotalVouchersCount</div>
        <div class="stat-sub">Across filtered range</div>
    </div>

    <!-- Total Debit -->
    <div class="stat-box-modern stat-glow-blue">
        <div class="stat-lbl">TOTAL DEBIT</div>
        <div class="stat-num">Rs @Model.TotalDebitAmount.ToString("N2")</div>
        <div class="stat-sub">Total incoming / debit entries</div>
    </div>

    <!-- Total Credit -->
    <div class="stat-box-modern stat-glow-green">
        <div class="stat-lbl">TOTAL CREDIT</div>
        <div class="stat-num">Rs @Model.TotalCreditAmount.ToString("N2")</div>
        <div class="stat-sub">Total outgoing / credit entries</div>
    </div>

    <!-- Double-Entry Balance Check -->
    <div class="stat-box-modern @(Model.IsBalanced ? "stat-glow-green" : "stat-glow-red")">
        <div class="stat-lbl">ENTRY BALANCE STATUS</div>
        <div class="stat-num" style="font-size:19px;">
            @if (Model.IsBalanced)
            {
                <span style="color:var(--green-text);">Balanced ✓</span>
            }
            else
            {
                <span style="color:var(--red-text);">Diff: Rs @(Math.Abs(Model.TotalDebitAmount - Model.TotalCreditAmount).ToString("N2"))</span>
            }
        </div>
        <div class="stat-sub">Debit vs Credit reconciliation</div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- VOUCHERS DATA TABLE (GROUPED: Multiple rows of same voucher in 1 block)    -->
<!-- ========================================================================= -->
<div class="card">
    <div class="card-head" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
        <div>
            <h3 style="margin-bottom:2px;">Voucher Transaction Entries</h3>
            <div style="font-size:12px;color:var(--text-dim);">
                Showing @Model.TotalVouchersCount Vouchers (@Model.TotalLinesCount entries) from @Model.FromDateFormatted to @Model.ToDateFormatted
                @if (!string.IsNullOrWhiteSpace(Model.SelectedVoucherType))
                {
                    <span> | Type: <strong style="color:var(--brass-text);">@Model.SelectedVoucherType</strong></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SelectedVoucherNo))
                {
                    <span> | Voucher #: <strong style="color:var(--text);">@Model.SelectedVoucherNo</strong></span>
                }
                @if (Model.SelectedAccountId.HasValue && !string.IsNullOrWhiteSpace(Model.SelectedAccountName))
                {
                    <span> | COA: <strong style="color:var(--brass-text);">@Model.SelectedAccountCode - @Model.SelectedAccountName</strong></span>
                }
            </div>
        </div>
        <div>
            <span class="badge" style="background:var(--surface2);border:1px solid var(--border);color:var(--text-dim);font-size:12px;padding:6px 12px;">
                @Model.TotalVouchersCount Vouchers · @Model.TotalLinesCount Transaction Lines
            </span>
        </div>
    </div>

    @if (Model.VoucherGroups == null || !Model.VoucherGroups.Any())
    {
        <div style="text-align:center;padding:50px 20px;">
            <div style="width:60px;height:60px;border-radius:50%;background:rgba(198,138,62,0.1);display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px;border:1px solid rgba(198,138,62,0.25);">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--brass-text);">
                    <rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><path d="M6 15h4"/>
                </svg>
            </div>
            <h4 style="font-size:16px;color:var(--text);margin-bottom:6px;">No Vouchers Found</h4>
            <p style="font-size:13px;color:var(--text-dim);max-width:460px;margin:0 auto 16px;">
                Muntakhib kardah dates aur filters ke mutabiq koi voucher daryaft nahi hua. Bara-e-meherbani tareekh ya voucher type tabdeel karein.
            </p>
            <a href="/VoucherReport" class="btn ghost" style="display:inline-flex;align-items:center;gap:6px;">
                <span>View Today's Vouchers</span>
            </a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="dynamic-table" id="voucherReportTable">
                <thead>
                    <tr>
                        <th style="width:105px;">Date</th>
                        <th style="width:130px;">Voucher #</th>
                        <th style="width:75px;text-align:center;">Type</th>
                        <th style="width:110px;">Account Code</th>
                        <th style="width:180px;">Account Title</th>
                        <th>Particulars / Narration</th>
                        <th style="width:120px;">Cheque Details</th>
                        <th style="width:120px;text-align:right;">Debit (Rs)</th>
                        <th style="width:120px;text-align:right;">Credit (Rs)</th>
                        <th style="width:80px;text-align:center;" class="no-print" data-dt-no-sort="true">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int gIdx = 0; gIdx < Model.VoucherGroups.Count; gIdx++)
                    {
                        var vGroup = Model.VoucherGroups[gIdx];
                        var lineCount = vGroup.Lines.Count;
                        var vtype = (vGroup.VoucherType ?? "").ToUpperInvariant();
                        string badgeClass = vtype switch
                        {
                            "BP" => "badge-vtype-bp",
                            "CP" => "badge-vtype-cp",
                            "BR" => "badge-vtype-br",
                            "CR" => "badge-vtype-cr",
                            "JV" => "badge-vtype-jv",
                            _ => "badge-vtype-cp"
                        };

                        <tr class="voucher-main-row" data-voucher-id="@vGroup.VoucherId">
                            <!-- Col 1: Date (single date per voucher) -->
                            <td style="vertical-align:middle;font-weight:600;color:var(--text);">
                                @vGroup.VoucherDateFormatted
                            </td>

                            <!-- Col 2: Voucher # (single code per voucher) -->
                            <td style="vertical-align:middle;">
                                <span class="tcode" style="font-weight:700;">@vGroup.VoucherNo</span>
                            </td>

                            <!-- Col 3: Type (single badge per voucher) -->
                            <td style="vertical-align:middle;text-align:center;">
                                <span class="badge-vtype @badgeClass">@vGroup.VoucherType</span>
                            </td>

                            <!-- Col 4: Account Code(s) -->
                            <td class="v-subcell">
                                @for (int i = 0; i < lineCount; i++)
                                {
                                    var line = vGroup.Lines[i];
                                    <div class="v-subline @(line.IsFilteredAccount ? "filtered-subline" : "")" data-subidx="@i">
                                        <span style="font-size:12px;color:var(--text-dim);font-family:monospace;">@line.AccountCode</span>
                                    </div>
                                }
                            </td>

                            <!-- Col 5: Account Title(s) -->
                            <td class="v-subcell">
                                @for (int i = 0; i < lineCount; i++)
                                {
                                    var line = vGroup.Lines[i];
                                    <div class="v-subline @(line.IsFilteredAccount ? "filtered-subline" : "")" data-subidx="@i">
                                        <strong style="color:var(--text);">@line.AccountName</strong>
                                        @if (line.IsFilteredAccount)
                                        {
                                            <span class="badge" style="background:rgba(198,138,62,0.2);color:var(--brass-text);font-size:10px;margin-left:4px;padding:2px 5px;">Matched</span>
                                        }
                                    </div>
                                }
                            </td>

                            <!-- Col 6: Particulars / Narration(s) -->
                            <td class="v-subcell">
                                @for (int i = 0; i < lineCount; i++)
                                {
                                    var line = vGroup.Lines[i];
                                    <div class="v-subline @(line.IsFilteredAccount ? "filtered-subline" : "")" data-subidx="@i">
                                        <span style="font-size:12.5px;color:var(--text-dim);">@line.Narration</span>
                                        @if (!string.IsNullOrWhiteSpace(line.InvoiceNo))
                                        {
                                            <span style="font-size:11px;color:var(--text-faint);margin-left:4px;">(Inv: @line.InvoiceNo)</span>
                                        }
                                    </div>
                                }
                            </td>

                            <!-- Col 7: Cheque Details -->
                            <td class="v-subcell">
                                @for (int i = 0; i < lineCount; i++)
                                {
                                    var line = vGroup.Lines[i];
                                    <div class="v-subline @(line.IsFilteredAccount ? "filtered-subline" : "")" data-subidx="@i">
                                        @if (!string.IsNullOrWhiteSpace(line.ChequeNo))
                                        {
                                            <div style="font-size:12px;font-weight:600;color:var(--brass-text);">
                                                Chq: @line.ChequeNo @(!string.IsNullOrEmpty(line.ChequeDateFormatted) ? $"({line.ChequeDateFormatted})" : "")
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-faint);font-size:12px;">—</span>
                                        }
                                    </div>
                                }
                            </td>

                            <!-- Col 8: Debit (Rs) -->
                            <td class="v-subcell text-end tnum" style="text-align:right;">
                                @for (int i = 0; i < lineCount; i++)
                                {
                                    var line = vGroup.Lines[i];
                                    <div class="v-subline @(line.IsFilteredAccount ? "filtered-subline" : "")" data-subidx="@i" style="justify-content:flex-end;">
                                        @if (line.Debit > 0)
                                        {
                                            <strong style="color:var(--text);">Rs @line.Debit.ToString("N2")</strong>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-faint);">0.00</span>
                                        }
                                    </div>
                                }
                            </td>

                            <!-- Col 9: Credit (Rs) -->
                            <td class="v-subcell text-end tnum" style="text-align:right;">
                                @for (int i = 0; i < lineCount; i++)
                                {
                                    var line = vGroup.Lines[i];
                                    <div class="v-subline @(line.IsFilteredAccount ? "filtered-subline" : "")" data-subidx="@i" style="justify-content:flex-end;">
                                        @if (line.Credit > 0)
                                        {
                                            <strong style="color:var(--text);">Rs @line.Credit.ToString("N2")</strong>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-faint);">0.00</span>
                                        }
                                    </div>
                                }
                            </td>

                            <!-- Col 10: Action (Single Print Button per voucher) -->
                            <td style="vertical-align:middle;text-align:center;" class="no-print">
                                <button type="button" class="btn ghost" onclick="viewVoucherSlip(@vGroup.VoucherId)" 
                                        title="View / Print Voucher Slip" 
                                        style="padding:5px 11px;font-size:12px;height:auto;border-color:var(--border);white-space:nowrap;display:inline-flex;align-items:center;gap:5px;">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                    <span>Print</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:var(--surface2);font-weight:700;border-top:2px solid var(--border);">
                        <td colspan="7" style="text-align:right;text-transform:uppercase;letter-spacing:0.5px;font-size:12px;color:var(--text-dim);">
                            TOTAL SUMMARY (@Model.TotalVouchersCount Vouchers · @Model.TotalLinesCount Entries):
                        </td>
                        <td style="text-align:right;color:#60a5fa;" class="tnum">
                            Rs @Model.TotalDebitAmount.ToString("N2")
                        </td>
                        <td style="text-align:right;color:var(--green-text);" class="tnum">
                            Rs @Model.TotalCreditAmount.ToString("N2")
                        </td>
                        <td class="no-print"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- JAVASCRIPT: DEPENDENT DROPDOWN & PRINT INTEGRATION                        -->
<!-- ========================================================================= -->
@section Scripts {
    <!-- TomSelect JS -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

    <script>
        let voucherTomSelect = null;
        let accountTomSelect = null;

        // Synchronize heights of sub-entries within each voucher row
        function syncVoucherSublineHeights() {
            if (typeof $ === 'undefined') return;
            $('#voucherReportTable tbody tr.voucher-main-row').each(function () {
                const $row = $(this);
                const $firstSubCol = $row.find('td.v-subcell').first();
                const count = $firstSubCol.find('.v-subline').length;

                for (let i = 0; i < count; i++) {
                    const $sublines = $row.find(`.v-subline[data-subidx="${i}"]`);
                    $sublines.css('min-height', 'auto');
                    let maxH = 0;
                    $sublines.each(function () {
                        const h = $(this).outerHeight();
                        if (h > maxH) maxH = h;
                    });
                    if (maxH > 0) {
                        $sublines.css('min-height', maxH + 'px');
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // 1. Initialize TomSelect on Chart of Accounts
            const accSelect = document.getElementById('filterAccountSelect');
            if (accSelect && window.TomSelect) {
                accountTomSelect = new TomSelect(accSelect, {
                    create: false,
                    placeholder: '-- All Chart of Accounts --',
                    maxOptions: 500,
                    sortField: { field: 'text', direction: 'asc' }
                });
            }

            // 2. Initialize TomSelect on Voucher dropdown
            const vSelect = document.getElementById('filterVoucherNo');
            if (vSelect && window.TomSelect) {
                voucherTomSelect = new TomSelect(vSelect, {
                    create: false,
                    placeholder: '-- All Vouchers --',
                    maxOptions: 500
                });
            }

            // 3. Initialize DataTables for Pagination, Length Menu, and Search
            if (window.jQuery && $.fn && $.fn.DataTable) {
                let dtInstance = null;
                if ($.fn.DataTable.isDataTable('#voucherReportTable')) {
                    dtInstance = $('#voucherReportTable').DataTable();
                } else if (window.ERPDataTables) {
                    dtInstance = window.ERPDataTables.init('#voucherReportTable', {
                        pageLength: 10,
                        lengthMenu: [10, 25, 50, 100],
                        order: []
                    });
                } else {
                    dtInstance = $('#voucherReportTable').DataTable({
                        pageLength: 10,
                        lengthMenu: [10, 25, 50, 100],
                        order: []
                    });
                }

                if (dtInstance) {
                    dtInstance.on('draw', function () {
                        setTimeout(syncVoucherSublineHeights, 10);
                    });
                }
            }

            setTimeout(syncVoucherSublineHeights, 60);

            // 4. Dependent Dropdown: When Voucher Type changes, reload vouchers
            const vTypeSelect = document.getElementById('filterVoucherType');
            if (vTypeSelect) {
                vTypeSelect.addEventListener('change', function () {
                    reloadVouchersDropdown();
                });
            }

            // Also reload if dates change
            const fromDateInput = document.getElementById('filterFromDate');
            const toDateInput = document.getElementById('filterToDate');
            if (fromDateInput) fromDateInput.addEventListener('change', reloadVouchersDropdown);
            if (toDateInput) toDateInput.addEventListener('change', reloadVouchersDropdown);
        });

        // =========================================================================
        // AJAX: RELOAD VOUCHERS DROPDOWN BASED ON VOUCHER TYPE & DATES
        // =========================================================================
        function reloadVouchersDropdown() {
            const vType = document.getElementById('filterVoucherType')?.value || '';
            const fromDate = document.getElementById('filterFromDate')?.value || '';
            const toDate = document.getElementById('filterToDate')?.value || '';
            const spinner = document.getElementById('voucherLoadingSpinner');

            if (spinner) spinner.style.display = 'inline';

            const url = `/VoucherReport/GetVouchersByType?voucherType=${encodeURIComponent(vType)}&fromDate=${encodeURIComponent(fromDate)}&toDate=${encodeURIComponent(toDate)}`;

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    if (spinner) spinner.style.display = 'none';
                    if (data && data.success && data.vouchers) {
                        updateVoucherSelectOptions(data.vouchers);
                    }
                })
                .catch(err => {
                    if (spinner) spinner.style.display = 'none';
                    console.error('Error fetching vouchers for selected type:', err);
                });
        }

        function updateVoucherSelectOptions(vouchers) {
            if (voucherTomSelect) {
                voucherTomSelect.clear();
                voucherTomSelect.clearOptions();
                voucherTomSelect.addOption({ value: '', text: '-- All Vouchers --' });

                vouchers.forEach(v => {
                    voucherTomSelect.addOption({
                        value: v.voucherNo,
                        text: v.displayText || `${v.voucherNo} [${v.voucherType}] — Rs. ${v.amount}`
                    });
                });
                voucherTomSelect.setValue('');
            } else {
                const nativeSelect = document.getElementById('filterVoucherNo');
                if (!nativeSelect) return;
                nativeSelect.innerHTML = '<option value="">-- All Vouchers --</option>';
                vouchers.forEach(v => {
                    const opt = document.createElement('option');
                    opt.value = v.voucherNo;
                    opt.textContent = v.displayText || `${v.voucherNo} [${v.voucherType}] — Rs. ${v.amount}`;
                    nativeSelect.appendChild(opt);
                });
            }
        }

        // =========================================================================
        // PRINT SINGLE VOUCHER SLIP (Fixed Layout matching Image 3)
        // =========================================================================
        function viewVoucherSlip(voucherId) {
            if (!voucherId || voucherId <= 0) return;

            fetch(`/VoucherReport/GetVoucherPrintData?voucherId=${voucherId}`)
                .then(r => r.json())
                .then(data => {
                    if (!data || !data.success || !data.voucher) {
                        alert(data.message || 'Voucher details could not be loaded.');
                        return;
                    }
                    renderVoucherPrintModal(data.voucher);
                })
                .catch(err => {
                    console.error('Error loading voucher print data:', err);
                    alert('Failed to load voucher print data.');
                });
        }

        // All vouchers data serialized from server for printing full report without pagination limits
        const allVouchersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VoucherGroups.Select(g => new {
            voucherId = g.VoucherId,
            voucherNo = g.VoucherNo,
            voucherDate = g.VoucherDateFormatted,
            voucherType = g.VoucherType,
            narration = g.VoucherNarration,
            lines = g.Lines.Select(l => new {
                accountCode = l.AccountCode,
                accountName = l.AccountName,
                narration = l.Narration,
                chequeNo = l.ChequeNo,
                chequeDate = l.ChequeDateFormatted,
                debit = l.Debit,
                credit = l.Credit
            })
        })));

        function renderVoucherPrintModal(v) {
            let linesHtml = '';
            let totalDebit = 0;
            let totalCredit = 0;

            if (v.lines && v.lines.length > 0) {
                v.lines.forEach(l => {
                    totalDebit += (parseFloat(l.debit) || 0);
                    totalCredit += (parseFloat(l.credit) || 0);
                    linesHtml += `
                        <tr style="border-bottom:1px solid #e2e8f0;">
                            <td style="font-family:monospace;font-size:11.5px;color:#334155;padding:6px 6px;vertical-align:top;border:1px solid #cbd5e1;">
                                ${escapeHtml(l.accountCode || '—')}
                            </td>
                            <td style="font-weight:600;color:#0f172a;padding:6px 6px;vertical-align:top;border:1px solid #cbd5e1;">
                                <div style="white-space:normal !important;word-break:break-word !important;overflow-wrap:break-word !important;line-height:1.35 !important;">
                                    ${escapeHtml(l.accountName || '')}
                                </div>
                            </td>
                            <td class="col-desc" style="color:#334155;font-size:11.5px;padding:6px 6px;vertical-align:top;border:1px solid #cbd5e1;">
                                <div style="white-space:normal !important;word-break:break-word !important;overflow-wrap:anywhere !important;line-height:1.35 !important;">
                                    ${escapeHtml(l.narration || '')}
                                </div>
                                ${l.chequeNo ? `<div style="font-size:10.5px;color:#8a5a1e;font-weight:600;margin-top:2px;">Chq: ${escapeHtml(l.chequeNo)} ${l.chequeDate ? `(${escapeHtml(l.chequeDate)})` : ''}</div>` : ''}
                            </td>
                            <td class="num-cell" style="text-align:right;font-weight:600;color:#0f172a;padding:6px 4px;vertical-align:top;border:1px solid #cbd5e1;white-space:nowrap !important;font-size:12px;">
                                ${l.debit > 0 ? 'Rs ' + formatMoney(l.debit) : '—'}
                            </td>
                            <td class="num-cell" style="text-align:right;font-weight:600;color:#0f172a;padding:6px 4px;vertical-align:top;border:1px solid #cbd5e1;white-space:nowrap !important;font-size:12px;">
                                ${l.credit > 0 ? 'Rs ' + formatMoney(l.credit) : '—'}
                            </td>
                        </tr>
                    `;
                });
            }

            const titleMap = {
                'BP': 'BANK PAYMENT VOUCHER',
                'CP': 'CASH PAYMENT VOUCHER',
                'BR': 'BANK RECEIPT VOUCHER',
                'CR': 'CASH RECEIPT VOUCHER',
                'JV': 'JOURNAL VOUCHER'
            };
            const docTitle = titleMap[v.voucherType] || (v.voucherType + ' VOUCHER');

            const compName = v.companyName || '@Html.Raw(Model.CompanyName?.Replace("'", "\\'"))' || 'West Wharf Warehouse';
            const compAddress = v.companyAddress || '@Html.Raw(Model.CompanyAddress?.Replace("'", "\\'"))' || '';
            const compPhone = v.companyPhone || '@Html.Raw(Model.CompanyPhone?.Replace("'", "\\'"))' || '';

            const contentHtml = `
                <div style="font-family:'Inter',sans-serif;color:#111;padding:4px;box-sizing:border-box;">
                    <!-- Dynamic Header from Company Master -->
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #0f172a;padding-bottom:12px;margin-bottom:16px;">
                        <div class="pp-brand" style="line-height:1.2;">
                            <div style="font-size:22px;font-weight:900;letter-spacing:0.5px;color:#111;text-transform:uppercase;">
                                ${escapeHtml(compName)}
                            </div>
                            ${compAddress ? `<div style="font-size:12px;color:#333;font-weight:600;margin-top:4px;">${escapeHtml(compAddress)}</div>` : ''}
                            ${compPhone ? `<div style="font-size:11.5px;color:#444;font-weight:500;margin-top:2px;">${escapeHtml(compPhone)}</div>` : ''}
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:18px;font-weight:800;color:#8a5a1e;letter-spacing:0.5px;">${docTitle}</div>
                            <div style="font-size:13px;font-weight:700;margin-top:4px;">Voucher #: <span style="font-family:monospace;color:#111;">${escapeHtml(v.voucherNo)}</span></div>
                            <div style="font-size:12px;color:#555;margin-top:2px;">Date: <strong style="color:#111;">${escapeHtml(v.voucherDate)}</strong></div>
                        </div>
                    </div>

                    ${v.narration ? `
                    <div style="background:#fdfcf9;border:1px solid #e2ddd3;border-radius:6px;padding:10px 14px;margin-bottom:16px;font-size:13px;">
                        <div style="color:#8a5a1e;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Narration / Remarks:</div>
                        <div style="margin-top:3px;color:#1e293b;font-weight:500;white-space:normal !important;word-break:break-word !important;line-height:1.4;">${escapeHtml(v.narration)}</div>
                    </div>` : ''}

                    <table class="pp-table voucher-slip-table" style="width:100% !important;table-layout:fixed !important;border-collapse:collapse !important;font-size:12px;margin-bottom:18px;box-sizing:border-box !important;">
                        <colgroup>
                            <col style="width: 14% !important;">
                            <col style="width: 20% !important;">
                            <col style="width: 34% !important;">
                            <col style="width: 16% !important;">
                            <col style="width: 16% !important;">
                        </colgroup>
                        <thead>
                            <tr style="background:#f1f5f9;border-bottom:2px solid #0f172a;text-transform:uppercase;font-size:11px;letter-spacing:0.5px;">
                                <th style="padding:7px 6px;text-align:left;border:1px solid #cbd5e1;color:#111;">Code</th>
                                <th style="padding:7px 6px;text-align:left;border:1px solid #cbd5e1;color:#111;">Account Title</th>
                                <th style="padding:7px 6px;text-align:left;border:1px solid #cbd5e1;color:#111;">Particulars</th>
                                <th style="padding:7px 4px;text-align:right;border:1px solid #cbd5e1;color:#111;" class="num-cell">Debit (Rs)</th>
                                <th style="padding:7px 4px;text-align:right;border:1px solid #cbd5e1;color:#111;" class="num-cell">Credit (Rs)</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${linesHtml}
                        </tbody>
                        <tfoot>
                            <tr style="background:#f8fafc;font-weight:700;border-top:2px solid #0f172a;border-bottom:2px solid #0f172a;">
                                <td colspan="3" style="padding:8px 8px;text-align:right;font-size:12px;letter-spacing:0.5px;color:#111;border:1px solid #cbd5e1;">TOTAL AMOUNT:</td>
                                <td class="num-cell" style="padding:8px 4px;text-align:right;color:#1e40af;font-size:12px;font-weight:800;white-space:nowrap !important;border:1px solid #cbd5e1;overflow:hidden;">${totalDebit > 0 ? 'Rs ' + formatMoney(totalDebit) : '—'}</td>
                                <td class="num-cell" style="padding:8px 4px;text-align:right;color:#15803d;font-size:12px;font-weight:800;white-space:nowrap !important;border:1px solid #cbd5e1;overflow:hidden;">${totalCredit > 0 ? 'Rs ' + formatMoney(totalCredit) : '—'}</td>
                            </tr>
                        </tfoot>
                    </table>

                    ${v.amountInWords ? `
                    <div style="font-size:12.5px;color:#334155;margin-top:10px;margin-bottom:24px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:8px 12px;">
                        <strong style="color:#0f172a;">Amount In Words:</strong> <em style="color:#0f172a;font-weight:600;margin-left:4px;">${escapeHtml(v.amountInWords)}</em>
                    </div>` : ''}

                    <div style="display:flex;justify-content:space-between;margin-top:45px;padding-top:10px;">
                        <div style="border-top:1px solid #94a3b8;width:150px;text-align:center;font-size:11.5px;color:#475569;padding-top:4px;">Prepared By</div>
                        <div style="border-top:1px solid #94a3b8;width:150px;text-align:center;font-size:11.5px;color:#475569;padding-top:4px;">Cashier / Munshi</div>
                        <div style="border-top:1px solid #94a3b8;width:150px;text-align:center;font-size:11.5px;color:#475569;padding-top:4px;">Authorized Signature</div>
                    </div>
                </div>
            `;

            if (window.AarhatApp && window.AarhatApp.openPrintModal) {
                window.AarhatApp.openPrintModal(`Voucher Slip — ${v.voucherNo}`, contentHtml);
            } else {
                const w = window.open('', '_blank', 'width=800,height=600');
                if (w) {
                    w.document.write(`<html><head><title>Voucher ${v.voucherNo}</title></head><body>${contentHtml}</body></html>`);
                    w.document.close();
                    w.focus();
                    w.print();
                }
            }
        }

        // =========================================================================
        // PRINT FULL FILTERED REPORT (Layout matching Image 3)
        // =========================================================================
        function printFilteredVoucherReport() {
            const fromDate = '@Model.FromDateFormatted';
            const toDate = '@Model.ToDateFormatted';
            const vType = '@(Model.SelectedVoucherType ?? "All Types")';
            const accName = '@(Model.SelectedAccountName?.Replace("'", "\\'") ?? "All Accounts")';
            const totalVouchers = @Model.TotalVouchersCount;
            const totalDebit = 'Rs @Model.TotalDebitAmount.ToString("N2")';
            const totalCredit = 'Rs @Model.TotalCreditAmount.ToString("N2")';

            if (!allVouchersData || allVouchersData.length === 0) {
                alert('No voucher data available to print.');
                return;
            }

            let rowsHtml = '';
            let grandDebit = 0;
            let grandCredit = 0;

            allVouchersData.forEach(v => {
                const lines = v.lines || [];
                const lineCount = lines.length || 1;
                
                lines.forEach((l, i) => {
                    grandDebit += (parseFloat(l.debit) || 0);
                    grandCredit += (parseFloat(l.credit) || 0);
                    const isFirst = (i === 0);
                    const borderTopStyle = isFirst ? 'border-top: 1.5px solid #0f172a;' : 'border-top: 1px dashed #e2e8f0;';

                    rowsHtml += `
                        <tr style="${borderTopStyle}">
                            ${isFirst ? `<td rowspan="${lineCount}" style="vertical-align:top;font-weight:600;font-size:10.5px;border:1px solid #cbd5e1;background:#fff;padding:5px 4px;">${escapeHtml(v.voucherDate)}</td>` : ''}
                            ${isFirst ? `<td rowspan="${lineCount}" style="vertical-align:top;font-family:monospace;font-weight:700;font-size:10.5px;border:1px solid #cbd5e1;background:#fff;padding:5px 4px;">${escapeHtml(v.voucherNo)}</td>` : ''}
                            ${isFirst ? `<td rowspan="${lineCount}" style="vertical-align:top;text-align:center;font-size:10.5px;font-weight:700;border:1px solid #cbd5e1;background:#fff;padding:5px 4px;">${escapeHtml(v.voucherType)}</td>` : ''}
                            <td style="font-family:monospace;font-size:10.5px;color:#334155;border:1px solid #cbd5e1;padding:5px 4px;vertical-align:top;">${escapeHtml(l.accountCode || '—')}</td>
                            <td style="font-weight:600;color:#0f172a;font-size:10.5px;border:1px solid #cbd5e1;padding:5px 4px;vertical-align:top;">
                                <div style="white-space:normal !important;word-break:break-word !important;line-height:1.35;">${escapeHtml(l.accountName || '')}</div>
                            </td>
                            <td class="col-desc" style="font-size:10.5px;color:#334155;border:1px solid #cbd5e1;padding:5px 4px;vertical-align:top;">
                                <div style="white-space:normal !important;word-break:break-word !important;overflow-wrap:anywhere !important;line-height:1.35;">
                                    ${escapeHtml(l.narration || '')}
                                </div>
                                ${l.chequeNo ? `<div style="font-size:9.5px;color:#8a5a1e;font-weight:600;margin-top:2px;">Chq: ${escapeHtml(l.chequeNo)} ${l.chequeDate ? `(${escapeHtml(l.chequeDate)})` : ''}</div>` : ''}
                            </td>
                            <td class="num-cell" style="text-align:right;font-weight:600;font-size:11px;border:1px solid #cbd5e1;padding:5px 4px;vertical-align:top;white-space:nowrap !important;">${l.debit > 0 ? 'Rs ' + formatMoney(l.debit) : '—'}</td>
                            <td class="num-cell" style="text-align:right;font-weight:600;font-size:11px;border:1px solid #cbd5e1;padding:5px 4px;vertical-align:top;white-space:nowrap !important;">${l.credit > 0 ? 'Rs ' + formatMoney(l.credit) : '—'}</td>
                        </tr>
                    `;
                });
            });

            const compName = '@Html.Raw(Model.CompanyName?.Replace("'", "\\'"))' || 'West Wharf Warehouse';
            const compAddress = '@Html.Raw(Model.CompanyAddress?.Replace("'", "\\'"))' || '';
            const compPhone = '@Html.Raw(Model.CompanyPhone?.Replace("'", "\\'"))' || '';

            const reportHtml = `
                <div style="font-family:'Inter',sans-serif;color:#111;padding:4px;box-sizing:border-box;">
                    <!-- Dynamic Header from Company Master -->
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #0f172a;padding-bottom:12px;margin-bottom:16px;">
                        <div class="pp-brand" style="line-height:1.2;">
                            <div style="font-size:22px;font-weight:900;letter-spacing:0.5px;color:#111;text-transform:uppercase;">
                                ${escapeHtml(compName)}
                            </div>
                            ${compAddress ? `<div style="font-size:12px;color:#333;font-weight:600;margin-top:4px;">${escapeHtml(compAddress)}</div>` : ''}
                            ${compPhone ? `<div style="font-size:11.5px;color:#444;font-weight:500;margin-top:2px;">${escapeHtml(compPhone)}</div>` : ''}
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:18px;font-weight:800;color:#8a5a1e;letter-spacing:0.5px;">VOUCHER REPORT</div>
                            <div style="font-size:12px;color:#333;margin-top:3px;">Period: <strong>${fromDate}</strong> to <strong>${toDate}</strong></div>
                            <div style="font-size:11.5px;color:#555;margin-top:2px;">Type: <strong>${vType}</strong> | COA: <strong>${accName}</strong></div>
                        </div>
                    </div>

                    <div style="display:flex;gap:20px;margin-bottom:16px;background:#f8fafc;padding:10px 16px;border-radius:6px;font-size:12.5px;border:1px solid #e2e8f0;">
                        <div>Total Vouchers: <strong>${totalVouchers}</strong></div>
                        <div>Total Debit: <strong style="color:#1e40af;">${totalDebit}</strong></div>
                        <div>Total Credit: <strong style="color:#15803d;">${totalCredit}</strong></div>
                    </div>

                    <table class="pp-table voucher-full-report-table" style="width:100% !important;table-layout:fixed !important;border-collapse:collapse !important;font-size:11px;margin-bottom:18px;box-sizing:border-box !important;">
                        <colgroup>
                            <col style="width: 9% !important;">
                            <col style="width: 11% !important;">
                            <col style="width: 5% !important;">
                            <col style="width: 10% !important;">
                            <col style="width: 15% !important;">
                            <col style="width: 20% !important;">
                            <col style="width: 15% !important;">
                            <col style="width: 15% !important;">
                        </colgroup>
                        <thead>
                            <tr style="background:#f1f5f9;border-bottom:2px solid #0f172a;text-transform:uppercase;font-size:10px;letter-spacing:0.5px;">
                                <th style="padding:6px 4px;text-align:left;border:1px solid #cbd5e1;">Date</th>
                                <th style="padding:6px 4px;text-align:left;border:1px solid #cbd5e1;">Voucher #</th>
                                <th style="padding:6px 4px;text-align:center;border:1px solid #cbd5e1;">Type</th>
                                <th style="padding:6px 4px;text-align:left;border:1px solid #cbd5e1;">Code</th>
                                <th style="padding:6px 4px;text-align:left;border:1px solid #cbd5e1;">Account Title</th>
                                <th style="padding:6px 4px;text-align:left;border:1px solid #cbd5e1;">Particulars / Narration</th>
                                <th style="padding:6px 4px;text-align:right;border:1px solid #cbd5e1;" class="num-cell">Debit (Rs)</th>
                                <th style="padding:6px 4px;text-align:right;border:1px solid #cbd5e1;" class="num-cell">Credit (Rs)</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${rowsHtml}
                        </tbody>
                        <tfoot>
                            <tr style="background:#f8fafc;font-weight:700;border-top:2px solid #0f172a;border-bottom:2px solid #0f172a;">
                                <td colspan="6" style="padding:7px 6px;text-align:right;font-size:11px;letter-spacing:0.5px;color:#111;border:1px solid #cbd5e1;">TOTAL STATEMENT AMOUNT:</td>
                                <td class="num-cell" style="padding:7px 4px;text-align:right;color:#1e40af;font-size:11px;font-weight:800;white-space:nowrap !important;border:1px solid #cbd5e1;overflow:hidden;">Rs ${formatMoney(grandDebit)}</td>
                                <td class="num-cell" style="padding:7px 4px;text-align:right;color:#15803d;font-size:11px;font-weight:800;white-space:nowrap !important;border:1px solid #cbd5e1;overflow:hidden;">Rs ${formatMoney(grandCredit)}</td>
                            </tr>
                        </tfoot>
                    </table>

                    <div style="display:flex;justify-content:space-between;margin-top:45px;padding-top:10px;">
                        <div style="border-top:1px solid #94a3b8;width:150px;text-align:center;font-size:11.5px;color:#475569;padding-top:4px;">Prepared By</div>
                        <div style="border-top:1px solid #94a3b8;width:150px;text-align:center;font-size:11.5px;color:#475569;padding-top:4px;">Verified By</div>
                        <div style="border-top:1px solid #94a3b8;width:150px;text-align:center;font-size:11.5px;color:#475569;padding-top:4px;">Authorized Signature</div>
                    </div>
                </div>
            `;

            if (window.AarhatApp && window.AarhatApp.openPrintModal) {
                window.AarhatApp.openPrintModal('Print Voucher Report', reportHtml);
            } else {
                window.print();
            }
        }

        // Helper utilities
        function formatMoney(num) {
            return Number(num || 0).toLocaleString('en-PK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>
}
