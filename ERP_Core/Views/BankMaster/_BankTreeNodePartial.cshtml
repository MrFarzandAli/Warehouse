@model ERP_Core.Dtos.BankTreeNodeDto

<div class="tree-node" style="margin:8px 0;">
    <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;font-size:13px;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="@(Model.Type == "Cash" ? "var(--green)" : "var(--teal)")" stroke-width="2">
            @if (Model.Type == "Cash")
            {
                <rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/>
            }
            else
            {
                <path d="M3 21h18M3 10h18M12 3l9 7H3zM5 10v11M9 10v11M15 10v11M19 10v11"/>
            }
        </svg>

        <span style="font-weight:600;color:var(--text);">@Model.Name</span>

        @if (!string.IsNullOrEmpty(Model.Code))
        {
            <span style="font-size:11px;color:var(--teal-text);background:var(--teal-dim);padding:2px 7px;border-radius:4px;border:1px solid var(--border);">COA: @Model.Code</span>
        }

        @if (!string.IsNullOrEmpty(Model.AccountNo))
        {
            <span style="font-size:11px;color:var(--text-dim);font-family:monospace;">Acc: @Model.AccountNo</span>
        }

        @if (!string.IsNullOrEmpty(Model.AccountName))
        {
            <span style="font-size:11.5px;color:var(--text-faint);">(Title: @Model.AccountName)</span>
        }

        <span class="badge @(Model.Type == "Cash" ? "badge-brass" : "badge-teal")" style="margin-left:auto;">
            @Model.Type
        </span>

        <button type="button" class="btn ghost" style="padding:4px 8px;font-size:11px;" title="Edit" onclick="editBank(@Model.Id, '@Model.Name.Replace("'", "\\'")', 0, '@Model.AccountNo.Replace("'", "\\'")', '@Model.AccountName.Replace("'", "\\'")', '', '', '@Model.Code', @(Model.Type == "Cash" ? "true" : "false"), @(Model.Active ? "true" : "false"))">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
    </div>

    @if (Model.Children != null && Model.Children.Any())
    {
        <div style="margin-left:26px;padding-left:14px;border-left:2px dashed var(--border);margin-top:6px;">
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync("_BankTreeNodePartial", child)
            }
        </div>
    }
</div>
