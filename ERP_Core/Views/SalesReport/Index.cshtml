@model ERP_Core.Dtos.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
    ViewData["SubTitle"] = "Supplier (Boat / Catch) aur Customer (Buyer / خریدار) wise bikri, commission revenue aur settlement report.";
}

@section Styles {
    <!-- TomSelect CSS for Searchable Dropdown -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />

    <style>
        .filter-bar-modern {
            background: var(--surface, #132420);
            border: 1px solid var(--border, #2C4740);
            border-radius: var(--radius, 10px);
            padding: 16px 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
        }

        .filter-grid-unified {
            display: grid;
            grid-template-columns: 160px 160px minmax(320px, 1fr) auto;
            gap: 16px;
            align-items: flex-end;
        }

        @@media (max-width: 992px) {
            .filter-grid-unified {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 576px) {
            .filter-grid-unified {
                grid-template-columns: 1fr;
            }
        }

        /* Stat Cards Matching Supplier Payable stat-grid-payable */
        .stat-grid-payable {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 22px;
        }

        @@media (max-width: 992px) {
            .stat-grid-payable {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .stat-grid-payable {
                grid-template-columns: 1fr;
            }
        }

        .stat-box-modern {
            background: linear-gradient(135deg, var(--surface, #132420) 0%, var(--surface2, #1A2F2A) 100%);
            border: 1px solid var(--border, #2C4740);
            border-radius: var(--radius, 10px);
            padding: 16px 18px;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .stat-box-modern:hover {
            transform: translateY(-2px);
            border-color: var(--brass, #C68A3E);
        }

        .stat-box-modern .stat-lbl {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-dim, #9FB6AF);
            margin-bottom: 6px;
        }

        .stat-box-modern .stat-num {
            font-size: 22px;
            font-weight: 700;
            color: var(--text, #EAF1EE);
            line-height: 1.1;
        }

        .stat-box-modern .stat-sub {
            font-size: 11.5px;
            color: var(--text-faint, #5E7873);
            margin-top: 4px;
        }

        .stat-glow-green .stat-num { color: var(--green-text, #6FE0A0); }
        .stat-glow-red .stat-num { color: var(--red-text, #FF8A7A); }
        .stat-glow-brass .stat-num { color: var(--brass-text, #E3AE66); }

        /* Party Header Banner */
        .party-banner {
            background: rgba(198, 138, 62, 0.08);
            border: 1px solid rgba(198, 138, 62, 0.35);
            border-radius: var(--radius, 10px);
            padding: 14px 18px;
            margin-bottom: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        /* Outstanding Balance Summary Box at bottom of Report */
        .outstanding-box {
            background: linear-gradient(135deg, rgba(198,138,62,0.12) 0%, rgba(198,138,62,0.04) 100%);
            border: 1px solid rgba(198,138,62,0.45);
            border-radius: 8px;
            padding: 14px 20px;
            margin-top: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
        }

        /* TomSelect Dark Overrides */
        .ts-wrapper .ts-control {
            background-color: var(--surface2, #1A2F2A) !important;
            border: 1px solid var(--border, #2C4740) !important;
            color: var(--text, #EAF1EE) !important;
            border-radius: 8px !important;
            font-size: 13px !important;
            min-height: 38px !important;
            padding: 7px 12px !important;
        }

        .ts-wrapper.focus .ts-control {
            border-color: var(--brass, #C68A3E) !important;
            box-shadow: 0 0 0 2px rgba(198, 138, 62, 0.25) !important;
        }

        .ts-wrapper .ts-control input {
            color: var(--text, #EAF1EE) !important;
        }

        .ts-wrapper .ts-control .item {
            color: var(--text, #EAF1EE) !important;
        }

        .ts-dropdown {
            background-color: #0E1A17 !important;
            border: 1px solid rgba(198, 138, 62, 0.4) !important;
            border-radius: 8px !important;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.75) !important;
            color: #EAF1EE !important;
            z-index: 999999 !important;
        }

        .ts-dropdown .optgroup-header {
            color: #C68A3E !important;
            background: #132420 !important;
            font-size: 11.5px !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.5px !important;
            padding: 6px 12px !important;
            border-bottom: 1px solid rgba(198, 138, 62, 0.25) !important;
        }

        .ts-dropdown .option {
            color: #EAF1EE !important;
            padding: 9px 14px !important;
            font-size: 13px !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
        }

        .ts-dropdown .option.active, .ts-dropdown .option:hover {
            background-color: #1B302B !important;
            color: #E3AE66 !important;
        }

        .ts-dropdown .option.selected {
            background-color: #2F6F5E !important;
            color: #FFFFFF !important;
            font-weight: 600 !important;
        }
    </style>
}

<!-- Page Toolbar -->
<div class="toolbar" style="margin-bottom:14px;">
    <div>
        <div class="section-title" style="margin-bottom:2px;">Sales &amp; Settlement Report</div>
        <div class="section-desc" style="margin-bottom:0;">
            Supplier (Boat / Catch) aur Customer (Buyer / خریدار) wise bikri, commission revenue aur settlement report.
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:var(--green-dim);color:var(--green-text);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid var(--border);">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background:rgba(239,68,68,0.15);color:var(--red-text,#ef4444);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid rgba(239,68,68,0.3);">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Subtabs (Sales Summary vs Individual Party Sales Report) -->
<div class="subtabs no-print" style="margin-bottom:16px;">
    <button type="button" class="subtab-btn @(Model.IsPartyReportView ? "" : "active")" id="salesTabSummaryBtn" onclick="switchSalesTab('summary')">
        All Sales Summary
    </button>
    <button type="button" class="subtab-btn @(Model.IsPartyReportView ? "active" : "")" id="salesTabReportBtn" onclick="switchSalesTab('report')">
        @if (Model.IsSingleCustomerView)
        {
            <span>Customer Sales Report: @Model.SelectedCustomerName</span>
        }
        else if (Model.IsSingleSupplierView)
        {
            <span>Supplier Sales Report: @Model.SelectedSupplierName</span>
        }
        else
        {
            <span>Party Sales Report</span>
        }
    </button>
</div>

<!-- ========================================================================= -->
<!-- FILTER BAR (From Date, To Date, Single Supplier/Customer Dropdown)        -->
<!-- ========================================================================= -->
<div class="filter-bar-modern no-print">
    <form method="get" asp-controller="SalesReport" asp-action="Index" id="salesFilterForm">
        <div class="filter-grid-unified">
            <!-- Field 1: From Date -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">From Date</label>
                <input type="date" name="fromDate" id="filterFromDate" value="@Model.FromDate" required
                       style="height:38px;padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;" />
            </div>

            <!-- Field 2: To Date -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">To Date</label>
                <input type="date" name="toDate" id="filterToDate" value="@Model.ToDate" required
                       style="height:38px;padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;" />
            </div>

            <!-- Field 3: Combined Select Supplier or Customer Dropdown -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">
                    Select Supplier or Customer
                </label>
                <select name="partyKey" id="filterPartySelect" class="searchable-select">
                    <option value="">-- All Suppliers &amp; Customers (Summary) --</option>
                    <optgroup label="🐟 Suppliers (Boats / Farmers / ماہی گیر)">
                        @foreach (var s in Model.SuppliersList)
                        {
                            <option value="s_@s.Id" selected="@(Model.PartyType == "supplier" && Model.SelectedSupplierId == s.Id)">
                                [Supplier] @s.DisplayText
                            </option>
                        }
                    </optgroup>
                    <optgroup label="🛍️ Customers (Buyers / خریدار)">
                        @foreach (var c in Model.CustomersList)
                        {
                            <option value="c_@c.Id" selected="@(Model.PartyType == "customer" && Model.SelectedCustomerId == c.Id)">
                                [Customer] @c.DisplayText
                            </option>
                        }
                    </optgroup>
                </select>
            </div>

            <!-- Filter Actions -->
            <div style="display:flex;gap:8px;align-items:flex-end;">
                <button type="submit" class="btn brass" style="height:38px;padding:0 18px;font-size:13px;display:inline-flex;align-items:center;gap:6px;">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    Filter Report
                </button>
                <a href="/SalesReport" class="btn ghost" style="height:38px;padding:0 14px;font-size:13px;display:inline-flex;align-items:center;">
                    Reset
                </a>
                <button type="button" class="btn brass" id="btnSalesPrintReport" onclick="printSalesReport()" style="height:38px;padding:0 16px;font-size:13px;display:inline-flex;align-items:center;gap:6px;">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18h12v4H6zM6 14h12"/></svg>
                    Print
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ========================================================================= -->
<!-- STAT CARDS (ADAPTIVE: CUSTOMER PURCHASE VS SUPPLIER SETTLEMENT)           -->
<!-- ========================================================================= -->
@if (Model.IsSingleCustomerView)
{
    <!-- Customer Perspective Stats -->
    <div class="stat-grid-payable">
        <div class="stat-box-modern stat-glow-green">
            <div class="stat-lbl">TOTAL CUSTOMER PURCHASES</div>
            <div class="stat-num tnum" style="color:var(--green-text);">
                Rs @Model.TotalGrossSale.ToString("N0")
            </div>
            <div class="stat-sub">Total amount purchased across @Model.TotalLotsCount lots</div>
        </div>

        <div class="stat-box-modern">
            <div class="stat-lbl">TOTAL WEIGHT PURCHASED</div>
            <div class="stat-num tnum">@Model.TotalWeightKg.ToString("N1") Kg</div>
            <div class="stat-sub">Across @Model.TotalBillsCount Bill(s) / Auctions</div>
        </div>

        <div class="stat-box-modern stat-glow-brass">
            <div class="stat-lbl">TOTAL PURCHASED LOTS</div>
            <div class="stat-num tnum" style="color:var(--brass-text);">
                @Model.TotalLotsCount Lots
            </div>
            <div class="stat-sub">Average Rate: Rs @(Model.TotalWeightKg > 0 ? (Model.TotalGrossSale / Model.TotalWeightKg).ToString("N1") : "0.0") / Kg</div>
        </div>

        <div class="stat-box-modern">
            <div class="stat-lbl">BUYER / CUSTOMER</div>
            <div class="stat-num" style="font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                @(Model.SelectedCustomerName ?? "Customer")
            </div>
            <div class="stat-sub">City: @(Model.SelectedCustomerCity ?? "-") &bull; Phone: @(Model.SelectedCustomerPhone ?? "-")</div>
        </div>
    </div>
}
else
{
    <!-- Supplier & Consolidated Settlement Stats -->
    <div class="stat-grid-payable">
        <div class="stat-box-modern stat-glow-green">
            <div class="stat-lbl">
                @(Model.IsSingleSupplierView ? "OUR COMMISSION (SALES)" : "AARHAT NET SALES (COMMISSION)")
            </div>
            <div class="stat-num tnum" style="color:var(--green-text);">
                Rs @Model.TotalCommissionSales.ToString("N0")
            </div>
            <div class="stat-sub">
                Our Sales is Commission (~@Model.AverageCommissionRate% of turnover)
            </div>
        </div>

        <div class="stat-box-modern">
            <div class="stat-lbl">TOTAL AUCTION TURNOVER</div>
            <div class="stat-num tnum">Rs @Model.TotalGrossSale.ToString("N0")</div>
            <div class="stat-sub">Total Sale (Receivable from Buyers)</div>
        </div>

        <div class="stat-box-modern stat-glow-red">
            <div class="stat-lbl">DEDUCTED EXPENSES</div>
            <div class="stat-num tnum" style="color:var(--red-text);">Rs @Model.TotalExpenses.ToString("N0")</div>
            <div class="stat-sub">Labour: Rs @Model.TotalLabourExpense.ToString("N0") &bull; Ice: Rs @Model.TotalIceExpense.ToString("N0")@(Model.TotalDeposit > 0 ? $" • Martey: Rs {Model.TotalDeposit:N0}" : "")</div>
        </div>

        <div class="stat-box-modern stat-glow-brass">
            <div class="stat-lbl">NET PAYABLE TO SUPPLIERS</div>
            <div class="stat-num tnum font-weight-bold" style="color:var(--brass-text);">
                Rs @Model.TotalNetPayable.ToString("N0")
            </div>
            <div class="stat-sub">Net Payable Due to Boat accounts</div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- SUBTAB 1: SALES & SETTLEMENT SUMMARY (DATA TABLE VIEW)                    -->
<!-- ========================================================================= -->
<div id="salesSummaryView" style="display:@(Model.IsPartyReportView ? "none" : "block");">
    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
            <h3 style="font-size:15px;font-weight:600;margin:0;color:var(--text);">All Sales &amp; Settlement Summary</h3>
            <div style="font-size:12px;color:var(--text-dim);">Period: @Model.FromDateFormatted &mdash; @Model.ToDateFormatted</div>
        </div>

        <div class="table-wrap">
            <table class="dynamic-table" id="allSalesTable">
                <thead>
                    <tr>
                        <th style="width:40px;text-align:center;">#</th>
                        <th style="width:85px;">Date</th>
                        <th style="width:75px;">Bill #</th>
                        <th style="width:135px;max-width:135px;">Supplier (Boat)</th>
                        <th style="max-width:175px;">Buyer(s)</th>
                        <th style="text-align:right;">Weight (Kg)</th>
                        <th style="text-align:right;">Gross Catch (Dr)</th>
                        <th style="text-align:right;">Commission (Sales)</th>
                        <th style="text-align:right;">Expenses</th>
                        <th style="text-align:right;">Martey</th>
                        <th style="text-align:right;">Net Payable</th>
                        <th style="width:65px;text-align:center;">Status</th>
                        <th class="no-sort" style="width:95px;text-align:center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int idx = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td style="text-align:center;color:var(--text-dim);font-weight:600;">@idx</td>
                                <td style="white-space:nowrap;">@item.BillDateFormatted</td>
                                <td>
                                    <a href="/NewBill?billNo=@item.BillNo" style="font-weight:700;color:var(--brass-text);text-decoration:none;">
                                        @item.BillNo
                                    </a>
                                </td>
                                <td style="max-width:135px;">
                                    <div style="font-weight:700;white-space:normal;word-break:break-word;line-height:1.25;">@item.SupplierName</div>
                                    @if (item.SupplierCity != "-")
                                    {
                                        <div style="font-size:11px;color:var(--text-dim);margin-top:2px;">@item.SupplierCity</div>
                                    }
                                </td>
                                <td style="max-width:175px;">
                                    <div style="white-space:normal;word-break:break-word;line-height:1.35;max-width:175px;" title="@item.CustomerNames">
                                        @item.CustomerNames
                                    </div>
                                    <div style="font-size:11px;color:var(--text-dim);margin-top:2px;">@item.LotsCount lot(s) &bull; @item.TotalCrates crates</div>
                                </td>
                                <td class="tnum" style="text-align:right;color:var(--text-dim);white-space:nowrap;">
                                    @(item.TotalWeightKg > 0 ? item.TotalWeightKg.ToString("N1") : "-")
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:#2eccb6;white-space:nowrap;">
                                    Rs @item.GrossSaleAmount.ToString("N0")
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:var(--green-text);white-space:nowrap;">
                                    <div>Rs @item.CommissionAmount.ToString("N0")</div>
                                    <div style="font-size:10px;color:var(--text-dim);font-weight:normal;">@item.CommissionPercent%</div>
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:var(--red-text);white-space:nowrap;">
                                    <div>- Rs @item.TotalExpense.ToString("N0")</div>
                                    @if (item.TotalExpense > 0)
                                    {
                                        <div style="font-size:10px;color:var(--text-dim);font-weight:normal;">
                                            L:@item.LabourExpense.ToString("N0") | I:@item.IceExpense.ToString("N0")
                                        </div>
                                    }
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:var(--red-text);white-space:nowrap;">
                                    <div>@(item.Deposit > 0 ? $"- Rs {item.Deposit:N0}" : "Rs 0")</div>
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;font-size:13.5px;color:var(--brass-text);white-space:nowrap;">
                                    Rs @item.NetPayableAmount.ToString("N0")
                                </td>
                                <td style="text-align:center;">
                                    @if (string.Equals(item.Status, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-green">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-brass">@(string.IsNullOrEmpty(item.Status) ? "Due" : item.Status)</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <button type="button" class="btn ghost btn-sm" style="padding:4px 10px;font-size:11.5px;"
                                            onclick="viewBillReport(@item.BillId, 'supplier', @(item.SupplierId ?? 0))" title="Print Catch Bill">
                                        View Bill
                                    </button>
                                </td>
                            </tr>
                            idx++;
                        }
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:700;background:var(--surface2);border-top:2px solid var(--border);">
                        <th style="padding:12px 14px !important;text-align:center;"></th>
                        <th style="color:var(--text);font-weight:700;padding:12px 14px !important;text-align:left;" colspan="4">Total Settlement Summary:</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--text-dim);padding:12px 14px !important;">@Model.TotalWeightKg.ToString("N1")</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:#2eccb6;padding:12px 14px !important;">Rs @Model.TotalGrossSale.ToString("N0")</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--green-text);padding:12px 14px !important;">Rs @Model.TotalCommissionSales.ToString("N0")</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--red-text);padding:12px 14px !important;">- Rs @Model.TotalExpenses.ToString("N0")</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--red-text);padding:12px 14px !important;">- Rs @Model.TotalDeposit.ToString("N0")</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--brass-text);font-size:13.5px;padding:12px 14px !important;">Rs @Model.TotalNetPayable.ToString("N0")</th>
                        <th style="padding:12px 14px !important;"></th>
                        <th style="padding:12px 14px !important;"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- SUBTAB 2: INDIVIDUAL PARTY SALES REPORT (SUPPLIER OR CUSTOMER)             -->
<!-- ========================================================================= -->
<div id="salesReportView" style="display:@(Model.IsPartyReportView ? "block" : "none");">
    <div class="card">
        @if (Model.IsSingleCustomerView)
        {
            <!-- ========================================================================= -->
            <!-- CUSTOMER SALES REPORT BANNER & TABLE                                      -->
            <!-- ========================================================================= -->
            <div class="party-banner">
                <div>
                    <h3 style="font-size:16px;font-weight:700;color:var(--brass-text);margin:0;">
                        @Model.SelectedCustomerName
                    </h3>
                    <div style="font-size:12px;color:var(--text-dim);margin-top:3px;">
                        City: <strong>@(Model.SelectedCustomerCity ?? "-")</strong> &nbsp;|&nbsp;
                        Phone: <strong>@(Model.SelectedCustomerPhone ?? "-")</strong> &nbsp;|&nbsp;
                        COA Code: <span class="tcode">@(Model.SelectedCustomerAccountCode ?? "-")</span>
                    </div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:11.5px;color:var(--text-dim);">Customer Purchase Period:</div>
                    <div style="font-size:13px;font-weight:600;color:var(--text);">
                        @Model.FromDateFormatted &mdash; @Model.ToDateFormatted
                    </div>
                </div>
            </div>

            <!-- Customer Individual Purchase Lots Table (All Lots in Date Range) -->
            <div class="table-wrap">
                <table class="dynamic-table" id="customerSalesTable">
                    <thead>
                        <tr>
                            <th style="width:40px;text-align:center;">#</th>
                            <th style="width:90px;">Date</th>
                            <th style="width:80px;">Bill #</th>
                            <th style="width:85px;text-align:center;">Lot #</th>
                            <th>Fish Variety (جنس)</th>
                            <th style="width:110px;text-align:center;">Weight (Md-Kg-P)</th>
                            <th style="width:95px;text-align:right;">Net Wt (Kg)</th>
                            <th style="width:95px;text-align:right;">Rate / Kg</th>
                            <th style="width:125px;text-align:right;">Total (Rs)</th>
