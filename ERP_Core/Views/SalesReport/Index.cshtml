        else
        {
            <!-- No Party Selected Prompt -->
            <div style="text-align:center;padding:48px 24px;">
                <div style="width:64px;height:64px;border-radius:50%;background:rgba(198,138,62,0.1);display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px;border:1px solid rgba(198,138,62,0.3);">
                    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--brass-text);">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                    </svg>
                </div>
                <h3 style="font-size:16px;font-weight:600;color:var(--text);margin-bottom:6px;">Koi Party Select Nahi Hai</h3>
                <p style="font-size:13px;color:var(--text-dim);max-width:480px;margin:0 auto 18px;">
                    Upar diye gaye dropdown <strong>Select Supplier or Customer</strong> se koi bhi Supplier ya Customer chun kar <strong>Filter Report</strong> dabayein.
                </p>
                <button type="button" class="btn brass" onclick="switchSalesTab('summary')">
