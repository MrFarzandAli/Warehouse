                            <td class="sales-num" style="font-weight:700;">${totalWeight}</td>
                            <td class="sales-num" style="font-weight:700;">${totalGross}</td>
                            <td class="sales-num" style="color:#0f5132;font-weight:700;">- ${totalComm}</td>
                            <td class="sales-num" style="color:#842029;font-weight:700;">${totalExp}</td>
                            <td class="sales-num" style="color:#842029;font-weight:700;">- ${totalDeposit}</td>
                            <td class="sales-num" style="font-weight:800;">${netPayable}</td>
                        </tr>
                    </tfoot>
                </table>

                <div style="display:flex;justify-content:flex-end;margin-top:18px;margin-bottom:20px;">
                    <div style="background:#e8f5e9;border:2px solid #2e7d32;border-radius:8px;padding:12px 24px;text-align:right;min-width:300px;display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:13.5px;font-weight:800;color:#1b5e20;letter-spacing:0.5px;">TOTAL COMMISSION:</span>
                        <strong style="font-size:22px;color:#1b5e20;margin-left:20px;">${totalComm}</strong>
                    </div>
                </div>

                <div class="pp-sign" style="margin-top:35px;">
                    <div>Prepared By</div>
                    <div>Verified By</div>
                    <div>Accountant</div>
                </div>
            `;

            if (window.AarhatApp && window.AarhatApp.openPrintModal) {
                window.AarhatApp.openPrintModal("Print Sales Report — Consolidated", content);
            } else {
                window.print();
            }
        }
    </script>
}
