@section Scripts {
    <!-- TomSelect JS -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

    <script>
        let partyTomSelect = null;

        // Subtab Navigation
        function switchSalesTab(tab) {
            const summaryView = document.getElementById('salesSummaryView');
            const reportView = document.getElementById('salesReportView');
            const btnSummary = document.getElementById('salesTabSummaryBtn');
            const btnReport = document.getElementById('salesTabReportBtn');

            if (tab === 'summary') {
                if (summaryView) summaryView.style.display = 'block';
                if (reportView) reportView.style.display = 'none';
                if (btnSummary) btnSummary.classList.add('active');
                if (btnReport) btnReport.classList.remove('active');
            } else {
                if (summaryView) summaryView.style.display = 'none';
                if (reportView) reportView.style.display = 'block';
                if (btnSummary) btnSummary.classList.remove('active');
                if (btnReport) btnReport.classList.add('active');
            }

            setTimeout(function () {
                if (window.jQuery && jQuery.fn.DataTable) {
                    jQuery('.dynamic-table').each(function () {
                        if (jQuery.fn.DataTable.isDataTable(this)) {
                            jQuery(this).DataTable().columns.adjust().draw();
                        }
                    });
                }
            }, 80);
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Searchable Dropdown for Combined Supplier & Customer
            const selectEl = document.getElementById('filterPartySelect');
            if (selectEl && typeof TomSelect !== 'undefined') {
                partyTomSelect = new TomSelect(selectEl, {
                    placeholder: '-- Select Supplier or Customer --',
                    allowEmptyOption: true,
                    create: false,
                    maxItems: 1,
                    plugins: ['dropdown_input', 'optgroup_columns']
                });
            }
        });

        // Open EXACT Bill Report from New Bill via /NewBill/GetBillJson/{id}
        function viewBillReport(billId, partyType, partyId) {
            if (!billId || billId <= 0) return;

            fetch('/NewBill/GetBillJson/' + billId)
                .then(res => res.json())
                .then(res => {
                    if (!res || !res.success || !res.data) {
                        alert(res?.message || 'Failed to load bill for viewing.');
                        return;
                    }

                    const d = res.data;
                    const isCustomer = (partyType === 'customer');

                    if (isCustomer) {
                        // Exact Customer Purchase Slip from New Bill
                        let custLots = (d.lots || []);
                        if (partyId && Number(partyId) > 0) {
                            const filtered = custLots.filter(l => l.customerId == partyId);
                            if (filtered.length > 0) custLots = filtered;
                        }
                        const custName = (custLots.length > 0 && custLots[0].customerName)
                            ? custLots[0].customerName
                            : (d.customerName || '@(Model.SelectedCustomerName?.Replace("'", "\\'") ?? "Customer")');

                        if (window.AarhatApp && typeof window.AarhatApp.printCustomerBillInvoice === 'function') {
                            window.AarhatApp.printCustomerBillInvoice(
                                d.billNo,
                                custName,
                                d.supplierName || 'General Boat Catch',
                                d.dateFormatted,
                                custLots,
                                d.voucherNo || '',
                                d.status || 'Due',
                                false
                            );
                        } else if (custLots.length > 0 && window.AarhatApp && typeof window.AarhatApp.printBillItemReport === 'function') {
                            const l = custLots[0];
                            window.AarhatApp.printBillItemReport(
                                d.billNo,
                                d.dateFormatted,
                                d.supplierName,
                                l.lotNo,
                                l.fishName,
                                custName,
                                l.weightStr,
                                l.weightKg,
                                l.ratePerKg,
                                l.amount,
                                d.voucherNo,
                                d.status,
                                false
                            );
                        } else {
                            window.open('/NewBill?billNo=' + d.billNo, '_blank');
                        }
                    } else {
                        // Exact Catch Bill from New Bill
                        const lots = (d.lots || []).map(l => ({
                            lotNo: l.lotNo,
                            fish: l.fishName,
                            customer: l.customerName,
                            weightStr: l.weightStr || '',
                            weight: l.weightKg,
                            rate: l.ratePerKg,
                            amount: l.amount
                        }));

                        if (window.AarhatApp && typeof window.AarhatApp.printBillInvoice === 'function') {
                            window.AarhatApp.printBillInvoice(
                                d.billNo,
                                d.supplierName || 'General Boat Catch',
                                d.dateFormatted,
                                d.totalGrossAmount,
                                d.commissionAmount,
                                d.totalExpense,
                                d.netPayable,
                                lots,
                                d.deposit,
                                d.status,
                                d.paidToSupplier,
                                d.labourExpense,
                                d.iceExpense
                            );
                        } else {
                            window.open('/NewBill?billNo=' + d.billNo, '_blank');
                        }
                    }
                })
                .catch(err => {
                    console.error("Error viewing bill:", err);
                    alert("Error loading bill report: " + err);
                });
        }

        // Print Report Dispatcher: Customer Sales Report, Supplier Sales Report, or Consolidated Report
        function printSalesReport() {
            const isCustomer = @(Model.IsSingleCustomerView ? "true" : "false");
            const isSupplier = @(Model.IsSingleSupplierView ? "true" : "false");

            if (isCustomer) {
                printSingleCustomerSalesReportModal();
            } else if (isSupplier) {
                printSingleSupplierSalesReportModal();
            } else {
                printConsolidatedSummaryModal();
            }
        }

        // 1. Single Customer Individual Purchase Report (All Lots in Date Range)
        function printSingleCustomerSalesReportModal() {
            const fromDate = '@Model.FromDateFormatted';
            const toDate = '@Model.ToDateFormatted';
            const customerName = '@(Model.SelectedCustomerName?.Replace("'", "\\'") ?? "Customer")';
            const city = '@(Model.SelectedCustomerCity?.Replace("'", "\\'") ?? "-")';
            const phone = '@(Model.SelectedCustomerPhone?.Replace("'", "\\'") ?? "-")';
            const totalGross = 'Rs @Model.TotalGrossSale.ToString("N0")';
            const totalWeight = '@Model.TotalWeightKg.ToString("N2")';

            let rowsHtml = '';
            @if (Model.Items != null)
            {
                int pIdx = 1;
                foreach (var i in Model.Items)
                {
                    <text>
                    rowsHtml += `
                        <tr>
                            <td class="sales-center" style="font-size:10.5px;padding:6px 3px;">@pIdx</td>
                            <td class="sales-center" style="font-size:10.5px;padding:6px 3px;">@i.BillDateFormatted</td>
                            <td class="sales-center" style="font-family:monospace;font-weight:700;font-size:10.5px;padding:6px 3px;">@i.BillNo</td>
                            <td class="sales-center" style="font-family:monospace;font-weight:700;font-size:10.5px;padding:6px 3px;color:#8a5a1e;">@(string.IsNullOrWhiteSpace(i.LotNo) ? $"LOT-{pIdx}" : i.LotNo)</td>
                            <td class="sales-name" style="font-size:10.5px;padding:6px 6px;font-weight:600;">
                                <div style="white-space:normal;word-break:break-word;overflow-wrap:anywhere;line-height:1.35;">@(string.IsNullOrWhiteSpace(i.FishNames) ? "Fish Catch" : i.FishNames?.Replace("'", "\\'"))</div>
                            </td>
                            <td class="sales-center" style="font-family:monospace;font-weight:700;color:#8a5a1e;font-size:10.5px;padding:6px 3px;">@(string.IsNullOrWhiteSpace(i.WeightStr) ? "-" : i.WeightStr)</td>
                            <td class="sales-num" style="font-size:10.5px;padding:6px 4px;">@(i.RatePerKg > 0 ? $"Rs {i.RatePerKg:N1}" : "-")</td>
                            <td class="sales-num" style="font-size:10.5px;font-weight:700;padding:6px 4px;color:#111;">Rs @i.GrossSaleAmount.ToString("N0")</td>
                        </tr>
                    `;
                    </text>
                    pIdx++;
                }
            }

            const content = `
                <style>
                    #printModal .print-paper {
                        width: 215mm !important;
                        max-width: 96vw !important;
                        padding: 8mm 10mm !important;
                        box-sizing: border-box !important;
                    }
                    #printModal .print-modal-bar {
                        width: 215mm !important;
                        max-width: 96vw !important;
                    }
                    .sales-doc-tbl {
                        width: 100% !important;
                        border-collapse: collapse !important;
                        table-layout: fixed !important;
                        box-sizing: border-box !important;
                        margin-top: 14px;
                    }
                    .sales-doc-tbl th,
                    .sales-doc-tbl td {
                        box-sizing: border-box !important;
                        vertical-align: middle !important;
                    }
                    .sales-doc-tbl th {
                        background: #f4f6f5 !important;
                        color: #153229 !important;
                        font-weight: 700 !important;
                        font-size: 10px !important;
                        text-transform: uppercase !important;
                        padding: 6px 3px !important;
                        border: 1px solid #c5d6cf !important;
                        line-height: 1.2 !important;
                        text-align: center !important;
                    }
                    .sales-doc-tbl td {
                        padding: 6px 4px !important;
                        font-size: 10.5px !important;
                        border: 1px solid #dde5e2 !important;
                        line-height: 1.3 !important;
                    }
                    .sales-doc-tbl tfoot td {
                        background: #f4f8f6 !important;
                        font-weight: 700 !important;
                        border-top: 2px solid #153229 !important;
                        font-size: 11px !important;
                        padding: 8px 4px !important;
                    }
                    .sales-num {
                        text-align: right !important;
                        white-space: nowrap !important;
                        font-variant-numeric: tabular-nums !important;
                    }
                    .sales-center {
                        text-align: center !important;
                    }
