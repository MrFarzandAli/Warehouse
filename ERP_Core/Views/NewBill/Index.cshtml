    document.addEventListener('DOMContentLoaded', function () {
        initSupplierSelect();
        initLotSelects(document.getElementById('billLotBody'));
        initModalAccountSelect();
        recalcBillTotals();

        // Sync hidden lot-customer inputs when party changes
        const mainSupSelect = document.getElementById('billSupplierSelect');
        if (mainSupSelect) {
            mainSupSelect.addEventListener('change', function () {
                const partyVal = this.value;
                document.querySelectorAll('.lot-customer').forEach(inp => inp.value = partyVal);
            });
            if (mainSupSelect.tomselect) {
                mainSupSelect.tomselect.on('change', function (val) {
                    document.querySelectorAll('.lot-customer').forEach(inp => inp.value = val);
                });
            }
        }

        // Validate party selection before form submission
        document.getElementById('newBillForm')?.addEventListener('submit', function (e) {
            const supId = document.getElementById('billSupplierSelect')?.value;
            if (!supId || supId === '0' || supId.trim() === '') {
                e.preventDefault();
                alert('Please select a Party before saving the bill.');
                const supTs = document.getElementById('billSupplierSelect')?.tomselect;
                if (supTs) supTs.focus();
                return false;
            }
        });

        // Quick Modal Keyboard Accessibility (Escape to close, Enter to submit)
        ['quickSupplierModal', 'quickCustomerModal', 'quickFishModal'].forEach(function(modalId) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            modal.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    if (modalId === 'quickSupplierModal') closeQuickSupplierModal();
                    else if (modalId === 'quickCustomerModal') closeQuickCustomerModal();
                    else if (modalId === 'quickFishModal') closeQuickFishModal();
                } else if (e.key === 'Enter' && e.target && e.target.tagName === 'INPUT') {
                    e.preventDefault();
                    if (modalId === 'quickSupplierModal') submitQuickSupplier();
                    else if (modalId === 'quickCustomerModal') submitQuickCustomer();
                    else if (modalId === 'quickFishModal') submitQuickFish();
                }
            });
        });

        // Fast Data Entry: Auto-Focus, Selection, and Navigation Engine
        document.addEventListener('focusin', function(e) {
            const target = e.target;
            if (!target) return;

            if (target.classList.contains('lot-weight-str')) {
                target._segTypedCount = 0;
                ensureWeightFormat(target);
                setTimeout(() => {
                    selectWeightSegment(target, 0);
                }, 20);
            } else if (target.classList.contains('lot-rate') || ['expLabour', 'expIce', 'expFreight', 'expOther', 'expDeposit', 'commAmtInput', 'commPct'].includes(target.id)) {
                setTimeout(() => {
                    if (typeof target.select === 'function') target.select();
                }, 20);
            }
        });

        document.addEventListener('mouseup', function(e) {
            const target = e.target;
            if (!target) return;

            if (target.classList.contains('lot-weight-str')) {
                target._segTypedCount = 0;
                setTimeout(() => {
                    const seg = getWeightSegment(target);
                    selectWeightSegment(target, seg);
                }, 10);
            } else if (target.classList.contains('lot-rate') || ['expLabour', 'expIce', 'expFreight', 'expOther', 'expDeposit', 'commAmtInput', 'commPct'].includes(target.id)) {
                if (target.value === '0' || target.value === '0.0') {
                    setTimeout(() => {
                        if (typeof target.select === 'function') target.select();
                    }, 10);
                }
            }
        });

        document.addEventListener('keydown', function(e) {
            const target = e.target;
            if (!target) return;

            if (target.classList.contains('lot-weight-str')) {
                handleWeightKeydown(e, target);
            } else if (target.classList.contains('lot-rate')) {
                handleRateKeydown(e, target);
            } else if (['expLabour', 'expIce', 'expFreight', 'expOther', 'expDeposit', 'commAmtInput', 'commPct'].includes(target.id)) {
                handleExpenseKeydown(e, target);
            }
        });

        document.addEventListener('focusout', function(e) {
            const target = e.target;
            if (!target) return;

            if (target.classList.contains('lot-rate')) {
                if (!target.value || target.value.trim() === '') {
                    target.value = '0';
                    recalcBillTotals();
                }
            } else if (['expLabour', 'expIce', 'expFreight', 'expOther', 'expDeposit', 'commAmtInput'].includes(target.id)) {
                if (!target.value || target.value.trim() === '') {
                    target.value = '0';
                    if (target.id === 'commAmtInput') onCommAmtChanged();
                    else recalcBillTotals();
                }
            } else if (target.id === 'commPct') {
                if (!target.value || target.value.trim() === '') {
                    target.value = '6.0';
                    onCommPctChanged();
                }
            }
        });
    });
</script>
