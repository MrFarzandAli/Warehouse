    function printBillById(id) {
        fetch('/NewBill/GetBillJson/' + id)
            .then(res => res.json())
            .then(res => {
                if (res.success && res.data) {
                    const d = res.data;
                    const lots = (d.lots || []).map(l => ({
                        lotNo: l.lotNo,
                        fish: l.fishName,
                        customer: l.customerName,
                        weightStr: l.weightStr || '',
                        weight: l.weightKg,
                        rate: l.ratePerKg,
                        amount: l.amount
                    }));

                    AarhatApp.printBillInvoice(
                        d.billNo,
                        d.supplierName || 'General Boat Catch',
                        d.dateFormatted,
                        d.totalGrossAmount,
                        d.commissionAmount,
                        d.totalExpense,
                        d.netPayable,
                        lots,
                        d.deposit,
                        d.status,
                        d.paidToSupplier,
                        d.labourExpense,
                        d.iceExpense,
                        d.freightExpense,
                        d.otherExpense,
                        d.farmerIceExpense
                    );
                } else {
                    alert(res.message || 'Failed to load bill for printing.');
                }
            })
            .catch(err => alert('Error loading bill: ' + err));
    }

