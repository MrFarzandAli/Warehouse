    function toggleBillDetails(billId, btn) {
        const $tr = $('#billRowHeader_' + billId);
        const expandBtn = btn || document.getElementById('expandBtn_' + billId);

        if ($tr.length && $.fn.DataTable && $.fn.DataTable.isDataTable('#recentBillsTable')) {
            const table = $('#recentBillsTable').DataTable();
            const row = table.row($tr);

            if (row.child.isShown()) {
                row.child.hide();
                $tr.removeClass('shown');
                if (expandBtn) expandBtn.classList.remove('expanded');
            } else {
                const template = document.getElementById('billDetailsTemplate_' + billId);
                if (template) {
                    const childRow = row.child(template.innerHTML, 'bill-expand-row-child');
                    childRow.show();
                    $(childRow).find('td').css({
                        'padding': '0',
                        'background': 'var(--bg, #040A09)'
                    });
                    $tr.addClass('shown');
                    if (expandBtn) expandBtn.classList.add('expanded');
                }
            }
            return;
        }

        const detailRow = document.getElementById('billDetails_' + billId);
        if (!detailRow) return;

        const isHidden = detailRow.style.display === 'none' || !detailRow.style.display;
        if (isHidden) {
            detailRow.style.display = 'table-row';
            if (expandBtn) expandBtn.classList.add('expanded');
        } else {
            detailRow.style.display = 'none';
            if (expandBtn) expandBtn.classList.remove('expanded');
        }
    }

