    function updatePaymentPreview() {
        const accSelect = document.getElementById('payAccountIdSelect');
        const selectedOpt = (accSelect && accSelect.selectedIndex >= 0) ? accSelect.options[accSelect.selectedIndex] : null;
        const isBank = selectedOpt ? (selectedOpt.getAttribute('data-isbank') === 'true') : false;
        
        const paymentMode = isBank ? 'Bank' : 'Cash';
        const modeInput = document.getElementById('payPaymentMode');
        if (modeInput) modeInput.value = paymentMode;

        const chqGroup = document.getElementById('payChequeGroup');
        if (chqGroup) {
            chqGroup.style.display = isBank ? 'block' : 'none';
        }

        const partyType = document.getElementById('payPartyType').value;
        const partyName = document.getElementById('payPartyNameDisplay').textContent || 'Party';
        const amt = parseFloat(document.getElementById('payAmountInput').value) || 0;
        const selectedAccName = selectedOpt?.text || (isBank ? 'Bank Account' : 'Cash in Hand');
        const badge = document.getElementById('payVoucherTypeBadge');
        const debitPreview = document.getElementById('payDebitPreview');
        const creditPreview = document.getElementById('payCreditPreview');

        if (partyType === 'Supplier') {
            const vType = isBank ? 'BPV' : 'CPV';
            badge.textContent = vType + ' (Payment Voucher)';
            badge.className = 'badge green';

            debitPreview.innerHTML = `<strong>[DEBIT]</strong> Supplier Payable (${partyName}): <span style="color:var(--text);font-weight:700;">Rs ${amt.toLocaleString()}</span>`;
            creditPreview.innerHTML = `<strong>[CREDIT]</strong> ${selectedAccName}: <span style="color:var(--text);font-weight:700;">Rs ${amt.toLocaleString()}</span>`;
        } else {
            const vType = isBank ? 'BRV' : 'CRV';
            badge.textContent = vType + ' (Receipt Voucher)';
            badge.className = 'badge brass';

            debitPreview.innerHTML = `<strong>[DEBIT]</strong> ${selectedAccName}: <span style="color:var(--text);font-weight:700;">Rs ${amt.toLocaleString()}</span>`;
            creditPreview.innerHTML = `<strong>[CREDIT]</strong> Customer Receivable (${partyName}): <span style="color:var(--text);font-weight:700;">Rs ${amt.toLocaleString()}</span>`;
        }
    }

    function submitPartyPayment() {
        const amount = parseFloat(document.getElementById('payAmountInput').value) || 0;
        if (amount <= 0) {
            alert('Please enter a valid payment amount greater than zero.');
            return;
        }

        const partyId = parseInt(document.getElementById('payPartyId').value) || 0;
        const paymentAccountId = parseInt(document.getElementById('payAccountIdSelect').value) || 0;

        const payload = {
            billId: parseInt(document.getElementById('payBillId').value) || 0,
            billNo: document.getElementById('payBillNo').value,
            lotId: parseInt(document.getElementById('payLotId').value) || null,
            lotNo: document.getElementById('payLotNo').value || null,
            partyType: document.getElementById('payPartyType').value,
            partyId: partyId,
            partyName: document.getElementById('payPartyNameDisplay').textContent,
            paymentMode: document.getElementById('payPaymentMode').value,
            paymentAccountId: paymentAccountId,
            paymentAccountName: document.getElementById('payAccountIdSelect').options[document.getElementById('payAccountIdSelect').selectedIndex]?.text,
            amount: amount,
            paymentDate: document.getElementById('payDateInput').value,
            chequeNo: document.getElementById('payChequeInput').value,
            narration: document.getElementById('payNarrationInput').value
        };

        const submitBtn = document.getElementById('paySubmitBtn');
        const submitText = document.getElementById('paySubmitBtnText');
        submitBtn.disabled = true;
        submitText.textContent = 'Posting Voucher...';

        fetch('/NewBill/PostPartyPayment', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            submitBtn.disabled = false;
            submitText.textContent = 'Post Payment Voucher';

            if (data.success) {
                closePaymentModal();
                alert('Success! ' + data.message + ' (Voucher: ' + data.voucherNo + ')');
                // Reload page to reflect updated accounting balances and status
                window.location.reload();
            } else {
                alert('Error: ' + (data.message || 'Failed to post payment voucher.'));
            }
        })
        .catch(err => {
        submitBtn.disabled = false;
        submitText.textContent = 'Post Payment Voucher';
        alert('Network error while posting payment: ' + err);
    });
}

