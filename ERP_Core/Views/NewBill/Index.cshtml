@section Scripts {
    <!-- TomSelect JS -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<script>
    // Helper functions for Searchable Dropdowns (TomSelect)
    function initSupplierSelect() {
        const el = document.getElementById('billSupplierSelect');
        if (el && typeof TomSelect !== 'undefined' && !el.tomselect) {
            new TomSelect(el, {
                placeholder: '-- Select Supplier / Boat --',
                allowEmptyOption: true,
                create: false,
                maxItems: 1,
                plugins: ['dropdown_input']
            });
        }
    }

    function initLotSelects(container) {
        if (typeof TomSelect === 'undefined' || !container) return;

        const fishSelects = container.querySelectorAll('select.lot-fish');
        fishSelects.forEach(sel => {
            if (!sel.tomselect) {
                new TomSelect(sel, {
                    placeholder: '-- Select Fish --',
                    allowEmptyOption: true,
                    create: false,
                    maxItems: 1,
                    dropdownParent: 'body',
                    plugins: ['dropdown_input']
                });
            }
        });

        const custSelects = container.querySelectorAll('select.lot-customer');
        custSelects.forEach(sel => {
            if (!sel.tomselect) {
                const ts = new TomSelect(sel, {
                    placeholder: '-- Select Customer / Buyer --',
                    allowEmptyOption: true,
                    create: false,
                    maxItems: 1,
                    dropdownParent: 'body',
                    plugins: ['dropdown_input']
                });
                ts.on('change', function () {
                    recalcBillTotals();
                });
            }
        });
    }

    function destroyLotSelects(container) {
        if (!container) return;
        const selects = container.querySelectorAll('select.lot-fish, select.lot-customer');
        selects.forEach(sel => {
            if (sel.tomselect) {
                sel.tomselect.destroy();
            }
        });
    }

    function initModalAccountSelect() {
        const el = document.getElementById('payAccountIdSelect');
        if (el && typeof TomSelect !== 'undefined' && !el.tomselect) {
            const ts = new TomSelect(el, {
                placeholder: '-- Select Account --',
                allowEmptyOption: false,
                create: false,
                maxItems: 1,
                dropdownParent: 'body',
                plugins: ['dropdown_input']
            });
            ts.on('change', function () {
                updatePaymentPreview();
            });
        }
    }

    // Cached lists for dynamic row insertion
    let fishOptionsHtml = `<option value="">-- Select Item / Commodity --</option>@foreach (var f in Model.FishList) { <text><option value="@f.Id">@Html.Raw(f.DisplayName)</option></text> }`;
    let customerOptionsHtml = `<option value="">-- Select Party --</option>@foreach (var c in Model.CustomersList) { <text><option value="@c.Id">@Html.Raw(c.DisplayName)</option></text> }`;

    let lotCounter = @Model.Lots.Count;

    // Maund-Kg-Pao Parser
    // Format: MMM-KKK-P (e.g. 002-010-2 = 2*40 + 10 + 0.5 = 90.5 Kg)
    // 3rd place: 0=0g, 1=250g, 2=500g, 3=750g
    function parseMaundWeight(str) {
        if (!str) return 0;
        const s = str.toString().trim();
        const parts = s.split(/[- :]/).filter(p => p.length > 0);
        if (parts.length === 3) {
            const m = parseFloat(parts[0]) || 0;
            const k = parseFloat(parts[1]) || 0;
            const p = parseFloat(parts[2]) || 0;
            let paoKg = 0;
            if (p === 1 || p === 25 || p === 250) paoKg = 0.25;
            else if (p === 2 || p === 50 || p === 500) paoKg = 0.50;
            else if (p === 3 || p === 75 || p === 750) paoKg = 0.75;
            else if (p > 0 && p < 1) paoKg = p;
            else if (p >= 100) paoKg = p / 1000;
            return (m * 40) + k + paoKg;
        } else if (parts.length === 2) {
            const m = parseFloat(parts[0]) || 0;
            const k = parseFloat(parts[1]) || 0;
            return (m * 40) + k;
        }
        return parseFloat(s) || 0;
    }

    // Maund-Kg-Pao Formatter Helper
    function formatKgToMaund(weightKg) {
        const w = parseFloat(weightKg) || 0;
        if (w <= 0) return "000-00-0";
        const maund = Math.floor(w / 40);
        const rem = w - (maund * 40);
        const kg = Math.floor(rem);
        const paoRem = rem - kg;
        let pao = 0;
        if (paoRem >= 0.70) pao = 3;
        else if (paoRem >= 0.45) pao = 2;
        else if (paoRem >= 0.20) pao = 1;
        return `${String(maund).padStart(3, '0')}-${String(kg).padStart(2, '0')}-${pao}`;
    }

    // --- Maund-Kg-Pao Segment Engine & Keyboard Navigation ---
    function getWeightSegment(input) {
        const selStart = input.selectionStart || 0;
        if (selStart <= 3) return 0; // Maund (000)
        if (selStart <= 6) return 1; // Kg (00)
        return 2; // Pao (0)
    }

    function selectWeightSegment(input, segIdx) {
        ensureWeightFormat(input);
        if (segIdx === 0) {
            input.setSelectionRange(0, 3);
        } else if (segIdx === 1) {
            input.setSelectionRange(4, 6);
        } else {
            input.setSelectionRange(7, input.value.length);
        }
    }

    function ensureWeightFormat(input) {
        let val = (input.value || '').trim();
        if (!val || val === '0') {
            input.value = "000-00-0";
            return;
        }
        const parts = val.split(/[- :]/).filter(p => p.length > 0);
        if (parts.length === 3) {
            const m = parseInt(parts[0]) || 0;
            const k = parseInt(parts[1]) || 0;
            const p = parseInt(parts[2]) || 0;
            input.value = `${String(m).padStart(3, '0')}-${String(k).padStart(2, '0')}-${p}`;
        } else if (parts.length === 2) {
            const m = parseInt(parts[0]) || 0;
            const k = parseInt(parts[1]) || 0;
            input.value = `${String(m).padStart(3, '0')}-${String(k).padStart(2, '0')}-0`;
        } else if (parts.length === 1 && !val.includes('-')) {
            const num = parseFloat(parts[0]) || 0;
            if (num > 0) {
                const m = Math.floor(num / 40);
                const rem = num - (m * 40);
                const k = Math.floor(rem);
                const paoRem = rem - k;
                let p = 0;
                if (paoRem >= 0.70) p = 3;
                else if (paoRem >= 0.45) p = 2;
                else if (paoRem >= 0.20) p = 1;
                input.value = `${String(m).padStart(3, '0')}-${String(k).padStart(2, '0')}-${p}`;
            } else {
                input.value = "000-00-0";
            }
        }
    }

    function normalizeMaundInput(input) {
        ensureWeightFormat(input);
        recalcBillTotals();
    }

    function handleWeightKeydown(e, input) {
        ensureWeightFormat(input);
        const seg = getWeightSegment(input);

        if (e.key === 'ArrowRight') {
            e.preventDefault();
            if (seg === 0) {
                selectWeightSegment(input, 1);
            } else if (seg === 1) {
                selectWeightSegment(input, 2);
            } else {
                const tr = input.closest('tr');
                const rateInp = tr ? tr.querySelector('.lot-rate') : null;
                if (rateInp) {
                    rateInp.focus();
                    rateInp.select();
                }
            }
            return;
        }

        if (e.key === 'ArrowLeft') {
            e.preventDefault();
            if (seg === 2) {
                selectWeightSegment(input, 1);
            } else if (seg === 1) {
                selectWeightSegment(input, 0);
            } else {
                const tr = input.closest('tr');
                const custTs = tr ? tr.querySelector('select.lot-customer')?.tomselect : null;
                if (custTs) custTs.focus();
            }
            return;
        }

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            const tr = input.closest('tr');
            const nextTr = tr ? tr.nextElementSibling : null;
            if (nextTr) {
                const nextWeight = nextTr.querySelector('.lot-weight-str');
                if (nextWeight) {
                    nextWeight.focus();
                    selectWeightSegment(nextWeight, 0);
                }
            } else {
                addNewLotRow();
                const newTr = document.querySelector('#billLotBody tr:last-child');
                if (newTr) {
                    const nextWeight = newTr.querySelector('.lot-weight-str');
                    if (nextWeight) {
                        nextWeight.focus();
                        selectWeightSegment(nextWeight, 0);
                    }
                }
            }
            return;
        }

        if (e.key === 'ArrowUp') {
            e.preventDefault();
            const tr = input.closest('tr');
            const prevTr = tr ? tr.previousElementSibling : null;
            if (prevTr) {
                const prevWeight = prevTr.querySelector('.lot-weight-str');
                if (prevWeight) {
                    prevWeight.focus();
                    selectWeightSegment(prevWeight, 0);
                }
            }
            return;
        }

        // Delimiters (Hyphen, Dot, Colon, Space, Enter) advance to next segment
        if (e.key === '-' || e.key === '.' || e.key === ':' || e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            if (seg === 0) {
                selectWeightSegment(input, 1);
            } else if (seg === 1) {
                selectWeightSegment(input, 2);
            } else {
                const tr = input.closest('tr');
                const rateInp = tr ? tr.querySelector('.lot-rate') : null;
                if (rateInp) {
                    rateInp.focus();
                    rateInp.select();
                }
            }
            return;
        }

        // Backspace / Delete resets current segment to 000 or 00 or 0
        if (e.key === 'Backspace' || e.key === 'Delete') {
            e.preventDefault();
            input._segTypedCount = 0;
            const parts = input.value.split('-');
            while (parts.length < 3) parts.push('0');
            if (seg === 0) parts[0] = '000';
            else if (seg === 1) parts[1] = '00';
            else parts[2] = '0';
            input.value = `${parts[0]}-${parts[1]}-${parts[2]}`;
            selectWeightSegment(input, seg);
            recalcBillTotals();
            return;
        }

        // Numeric Digits (0-9)
        if (/^[0-9]$/.test(e.key)) {
            e.preventDefault();
            const digit = e.key;
            const parts = input.value.split('-');
            while (parts.length < 3) parts.push('0');

            const isFullSel = (seg === 0 && input.selectionStart === 0 && input.selectionEnd >= 3) ||
                              (seg === 1 && input.selectionStart === 4 && input.selectionEnd >= 6) ||
                              (seg === 2 && input.selectionStart === 7);

            if (isFullSel || input._lastSeg !== seg) {
                input._segTypedCount = 0;
                input._lastSeg = seg;
            }

            input._segTypedCount = (input._segTypedCount || 0) + 1;

            if (seg === 0) {
                // 1st Place (Maund): Allows 3 complete digits (e.g. 8 -> 008, 88 -> 088, 888 -> 888)
                if (input._segTypedCount === 1) {
                    parts[0] = '00' + digit;
                } else if (input._segTypedCount === 2) {
                    parts[0] = '0' + parts[0].slice(-1) + digit;
                } else {
                    parts[0] = parts[0].slice(-2) + digit;
                }
                input.value = `${parts[0]}-${parts[1]}-${parts[2]}`;

                if (input._segTypedCount >= 3) {
                    input._segTypedCount = 0;
                    selectWeightSegment(input, 1);
                } else {
                    input.setSelectionRange(3, 3);
                }
            } else if (seg === 1) {
                // 2nd Place (Kg): 2 digits max (00 to 39 kg, 1 Maund = 40Kg)
                if (input._segTypedCount === 1) {
                    parts[1] = '0' + digit;
                } else {
                    parts[1] = parts[1].slice(-1) + digit;
                }
                input.value = `${parts[0]}-${parts[1]}-${parts[2]}`;

                if (input._segTypedCount >= 2) {
                    input._segTypedCount = 0;
                    selectWeightSegment(input, 2);
                } else {
                    input.setSelectionRange(6, 6);
                }
            } else if (seg === 2) {
                // 3rd Place (Pao): 1 digit (0..3) -> auto-advances to Rate / Kg
                parts[2] = digit;
                input.value = `${parts[0]}-${parts[1]}-${parts[2]}`;
                input._segTypedCount = 0;

                const tr = input.closest('tr');
                const rateInp = tr ? tr.querySelector('.lot-rate') : null;
                if (rateInp) {
                    rateInp.focus();
                    rateInp.select();
                } else {
                    input.setSelectionRange(7, input.value.length);
                }
            }

            recalcBillTotals();
            return;
        }
    }

    function handleRateKeydown(e, input) {
        if (e.key === 'Enter') {
            e.preventDefault();
            // Enter on rate column ALWAYS creates/moves to next lot row
            const tr = input.closest('tr');
            const tbody = document.getElementById('billLotBody');
            const isLastRow = !tr || !tr.nextElementSibling;

            if (isLastRow) {
                addNewLotRow();
                const newTr = tbody ? tbody.lastElementChild : null;
                if (newTr) {
                    const fishTs = newTr.querySelector('select.lot-fish')?.tomselect;
                    if (fishTs) {
                        fishTs.focus();
                    } else {
                        const weightInp = newTr.querySelector('.lot-weight-str');
                        if (weightInp) {
                            weightInp.focus();
                            selectWeightSegment(weightInp, 0);
                        }
                    }
                }
            } else {
                const nextTr = tr.nextElementSibling;
                const fishTs = nextTr.querySelector('select.lot-fish')?.tomselect;
                if (fishTs) {
                    fishTs.focus();
                } else {
                    const nextWeight = nextTr.querySelector('.lot-weight-str');
                    if (nextWeight) {
                        nextWeight.focus();
                        selectWeightSegment(nextWeight, 0);
                    }
                }
            }
            return;
        }

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            const tr = input.closest('tr');
            const nextTr = tr ? tr.nextElementSibling : null;
            if (nextTr) {
                const nextRate = nextTr.querySelector('.lot-rate');
                if (nextRate) {
                    nextRate.focus();
                    nextRate.select();
                }
            } else {
                addNewLotRow();
                const newTr = document.querySelector('#billLotBody tr:last-child');
                if (newTr) {
                    const newRate = newTr.querySelector('.lot-rate');
                    if (newRate) {
                        newRate.focus();
                        newRate.select();
                    }
                }
            }
            return;
        }

        if (e.key === 'ArrowUp') {
            e.preventDefault();
            const tr = input.closest('tr');
            const prevTr = tr ? tr.previousElementSibling : null;
            if (prevTr) {
                const prevRate = prevTr.querySelector('.lot-rate');
                if (prevRate) {
                    prevRate.focus();
                    prevRate.select();
                }
            }
            return;
        }

        if (e.key === 'ArrowLeft') {
            if (input.selectionStart === 0 || input.selectionStart === input.selectionEnd) {
                e.preventDefault();
                const tr = input.closest('tr');
                const weightInp = tr ? tr.querySelector('.lot-weight-str') : null;
                if (weightInp) {
                    weightInp.focus();
                    selectWeightSegment(weightInp, 2);
                }
                return;
            }
        }

        if (e.key === 'ArrowRight') {
            if (input.selectionEnd >= input.value.length || input.selectionStart === input.selectionEnd) {
                e.preventDefault();
                const tr = input.closest('tr');
                const nextTr = tr ? tr.nextElementSibling : null;
                if (nextTr) {
                    const nextWeight = nextTr.querySelector('.lot-weight-str');
                    if (nextWeight) {
                        nextWeight.focus();
                        selectWeightSegment(nextWeight, 0);
                    }
                } else {
                    addNewLotRow();
                    const newTr = document.querySelector('#billLotBody tr:last-child');
                    if (newTr) {
                        const nextWeight = newTr.querySelector('.lot-weight-str');
                        if (nextWeight) {
                            nextWeight.focus();
                            selectWeightSegment(nextWeight, 0);
                        }
                    }
                }
                return;
            }
        }

        // Overwrite default 0 on number keystroke
        if (/^[0-9]$/.test(e.key)) {
            if (input.value === '0' || input.value === '0.0' || (input.selectionStart === 0 && input.selectionEnd >= input.value.length)) {
                input.value = e.key;
                e.preventDefault();
                recalcBillTotals();
            }
        }
    }

    function handleExpenseKeydown(e, input) {
        const expenseFields = ['commPct', 'commAmtInput', 'expLabour', 'expIce', 'expFarmerIce', 'expFreight', 'expOther', 'expDeposit', 'billRemarksInput'];
        const currentIdx = expenseFields.indexOf(input.id);

        if (e.key === 'Enter' || e.key === 'ArrowDown') {
            if (currentIdx !== -1 && currentIdx < expenseFields.length - 1) {
                e.preventDefault();
                const nextEl = document.getElementById(expenseFields[currentIdx + 1]);
                if (nextEl) {
                    nextEl.focus();
                    if (typeof nextEl.select === 'function') nextEl.select();
                }
                return;
            }
        }

        if (e.key === 'ArrowUp') {
            if (currentIdx > 0) {
                e.preventDefault();
                const prevEl = document.getElementById(expenseFields[currentIdx - 1]);
                if (prevEl) {
                    prevEl.focus();
                    if (typeof prevEl.select === 'function') prevEl.select();
                }
                return;
            }
        }

        // Overwrite default 0 on number keystroke
        if (/^[0-9]$/.test(e.key)) {
            if (input.value === '0' || (input.selectionStart === 0 && input.selectionEnd >= input.value.length)) {
                input.value = e.key;
                e.preventDefault();
                if (input.id === 'commPct') onCommPctChanged();
                else if (input.id === 'commAmtInput') onCommAmtChanged();
                else recalcBillTotals();
            }
        }
    }

    function switchBillTab(tab) {
        const entryView = document.getElementById('billEntryView');
        const reportView = document.getElementById('billReportView');
        const entryBtn = document.getElementById('billTabEntryBtn');
        const reportBtn = document.getElementById('billTabReportBtn');

        if (tab === 'entry') {
            entryView.style.display = 'block';
            reportView.style.display = 'none';
            entryBtn.classList.add('active');
            reportBtn.classList.remove('active');
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#recentBillsTable')) {
                $('#recentBillsTable').DataTable().columns.adjust();
            }
        } else {
            entryView.style.display = 'none';
            reportView.style.display = 'block';
            entryBtn.classList.remove('active');
            reportBtn.classList.add('active');
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#reportBillsTable')) {
                $('#reportBillsTable').DataTable().columns.adjust();
            }
        }
    }

    function addNewLotRow() {
        const tbody = document.getElementById('billLotBody');
        if (!tbody) return;

        lotCounter++;
        const rowIdx = tbody.children.length;
        const rowId = 'billRow_' + lotCounter;
        const selectedPartyId = document.getElementById('billSupplierSelect')?.value || '';

        const tr = document.createElement('tr');
        tr.id = rowId;

        tr.innerHTML = `
            <td style="text-align:center;color:var(--text-faint);font-weight:600;">${rowIdx + 1}</td>
            <td>
                <input type="text" class="lot-input lot-no" readonly name="Lots[${rowIdx}].LotNo" value="LOT-${1000 + lotCounter}" placeholder="LOT-1001" style="font-family:monospace;" />
            </td>
            <td>
                <select class="lot-select lot-fish" name="Lots[${rowIdx}].FishId" required>
                    ${fishOptionsHtml}
                </select>
                <input type="hidden" class="lot-customer" name="Lots[${rowIdx}].CustomerId" value="${selectedPartyId}" />
            </td>
            <td>
                <input type="text" class="lot-input lot-weight-str tnum" name="Lots[${rowIdx}].WeightStr" value="000-00-0" placeholder="000-00-0" required style="text-align:center;font-family:monospace;font-weight:700;letter-spacing:1px;" oninput="recalcBillTotals()" onblur="normalizeMaundInput(this)" />
                <input type="hidden" class="lot-weight" name="Lots[${rowIdx}].WeightKg" value="0" />
                <div style="text-align:center;">
                    <span class="maund-badge lot-kg-badge">0.0 Kg</span>
                </div>
            </td>
            <td>
                <input type="number" step="1" min="1" class="lot-input lot-rate tnum" name="Lots[${rowIdx}].RatePerKg" value="0" required style="text-align:right;" oninput="recalcBillTotals()" />
            </td>
            <td class="lot-amount tnum" style="text-align:right;font-weight:700;color:var(--text);">
                <span class="lot-amount-display">Rs 0</span>
                <input type="hidden" class="lot-amount-input" name="Lots[${rowIdx}].Amount" value="0" />
            </td>
            <td style="text-align:center;">
                <button type="button" class="btn ghost icon-only" onclick="removeLotRow('${rowId}')" title="Remove lot" style="padding:4px 6px;color:var(--red-text);">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </td>
        `;

        tbody.appendChild(tr);

        // Initialize searchable dropdowns for the new row
        initLotSelects(tr);

        reindexLots();
        recalcBillTotals();
    }

    function removeLotRow(rowId) {
        const row = document.getElementById(rowId);
        if (row) {
            destroyLotSelects(row);
            row.remove();
            reindexLots();
            recalcBillTotals();
        }
    }

    function reindexLots() {
        const rows = document.querySelectorAll('#billLotBody tr');
        rows.forEach((r, idx) => {
            if (r.cells[0]) r.cells[0].textContent = idx + 1;
            const inputs = r.querySelectorAll('input, select');
            inputs.forEach(inp => {
                const name = inp.getAttribute('name');
                if (name && name.startsWith('Lots[')) {
                    inp.setAttribute('name', name.replace(/Lots\[\d+\]/, `Lots[${idx}]`));
                }
            });
        });
    }

    function recalcBillTotals() {
        let grossTotal = 0;
        let totalKg = 0;
        let cashSaleTotal = 0;
        let cashLotsCount = 0;
        const rows = document.querySelectorAll('#billLotBody tr');

        rows.forEach(r => {
            const weightStrInp = r.querySelector('.lot-weight-str');
            const weightHidden = r.querySelector('.lot-weight');
            const kgBadge = r.querySelector('.lot-kg-badge');
            const rateInp = r.querySelector('.lot-rate');
            const amtCell = r.querySelector('.lot-amount');

            const weightStr = weightStrInp ? weightStrInp.value : "000-00-0";
            const calculatedKg = parseMaundWeight(weightStr);

            if (weightHidden) weightHidden.value = calculatedKg;
            if (kgBadge) {
                kgBadge.textContent = (calculatedKg > 0 ? calculatedKg.toFixed(2) : "0.0") + " Kg";
            }

            const rate = parseFloat(rateInp ? rateInp.value : 0) || 0;
            const amount = Math.round(calculatedKg * rate);

            const amtDisplay = r.querySelector('.lot-amount-display');
            if (amtDisplay) {
                amtDisplay.textContent = "Rs " + amount.toLocaleString();
            } else if (amtCell) {
                amtCell.textContent = "Rs " + amount.toLocaleString();
            }

            const amtHidden = r.querySelector('.lot-amount-input');
            if (amtHidden) {
                amtHidden.value = amount;
            }
            grossTotal += amount;
            totalKg += calculatedKg;

            // Check if Customer is CASH SALE
            const custSel = r.querySelector('.lot-customer');
            let custText = '';
            if (custSel) {
                if (custSel.tomselect) {
                    const selVal = custSel.tomselect.getValue();
                    const opt = custSel.tomselect.options[selVal];
                    custText = opt ? (opt.text || opt.name || opt.DisplayName || '') : '';
                } else if (custSel.options && custSel.selectedIndex >= 0) {
                    custText = custSel.options[custSel.selectedIndex].text || '';
                }
            }
            if (custText && custText.toUpperCase().includes('CASH')) {
                cashSaleTotal += amount;
                cashLotsCount++;
            }
        });

        // Update Total Weight & Total Sale
        const totalWeightCell = document.getElementById('totalWeightCell');
        const maundStr = formatKgToMaund(totalKg);
        const kgStr = (totalKg > 0 ? totalKg.toFixed(2) : "0.0") + " Kg";

        const totalWeightMaund = document.getElementById('totalWeightMaund');
        const totalWeightKgBadge = document.getElementById('totalWeightKgBadge');
        if (totalWeightMaund && totalWeightKgBadge) {
            totalWeightMaund.textContent = maundStr;
            totalWeightKgBadge.textContent = kgStr;
        } else if (totalWeightCell) {
            totalWeightCell.innerHTML = `
                <div id="totalWeightMaund" style="font-family:monospace;font-weight:700;font-size:13px;color:var(--brass-text);letter-spacing:0.5px;">${maundStr}</div>
                <div style="text-align:center;margin-top:2px;">
                    <span class="maund-badge" id="totalWeightKgBadge" style="font-size:11px;">${kgStr}</span>
                </div>`;
        }

        const billTotalCell = document.getElementById('billTotalCell');
        if (billTotalCell) billTotalCell.textContent = "Rs " + Math.round(grossTotal).toLocaleString();

        // Update Cash Sale summary cell in table footer
        const billCashCell = document.getElementById('billCashSaleCell');
        if (billCashCell) {
            if (cashSaleTotal > 0) {
                billCashCell.innerHTML = `<span class="badge" style="background:rgba(16,185,129,0.15);color:var(--green-text);border:1px solid rgba(16,185,129,0.3);font-size:11.5px;font-weight:700;padding:3px 8px;">Cash Sale: Rs ${Math.round(cashSaleTotal).toLocaleString()} (${cashLotsCount} lots)</span>`;
            } else {
                billCashCell.innerHTML = '';
            }
        }

        // Update Cash Sale in Box 3 Settlement
        const boxLineCash = document.getElementById('boxLineCashSale');
        const settleCash = document.getElementById('settleCashSale');
        if (boxLineCash && settleCash) {
            if (cashSaleTotal > 0) {
                boxLineCash.style.display = 'flex';
                settleCash.textContent = "Rs " + Math.round(cashSaleTotal).toLocaleString() + ` (${cashLotsCount} lots)`;
            } else {
                boxLineCash.style.display = 'none';
            }
        }

        const commBase = document.getElementById('commBase');
        if (commBase) commBase.textContent = "Rs " + Math.round(grossTotal).toLocaleString();

        const settleTotal = document.getElementById('settleTotal');
        if (settleTotal) settleTotal.textContent = "Rs " + Math.round(grossTotal).toLocaleString();

        // Calculate Commission & Settlement
        calculateAndRenderCommission(grossTotal);
    }

    // Tracks the active mode of commission calculation: 'pct' or 'amt'
    let commCalculationMode = 'pct';

    function onCommPctChanged() {
        commCalculationMode = 'pct';
        const grossTotal = getBillGrossTotal();
        const commPctVal = parseFloat(document.getElementById('commPct').value) || 0;
        const commAmt = Math.round(grossTotal * (commPctVal / 100));
        
        const commAmtInp = document.getElementById('commAmtInput');
        if (commAmtInp) commAmtInp.value = commAmt;
        
        recalcSettlementOnly(grossTotal, commAmt);
    }

    function onCommAmtChanged() {
        commCalculationMode = 'amt';
        const grossTotal = getBillGrossTotal();
        const commAmtInp = document.getElementById('commAmtInput');
        const commAmt = parseFloat(commAmtInp ? commAmtInp.value : 0) || 0;
        
        const commPctInp = document.getElementById('commPct');
        if (commPctInp) {
            const calculatedPct = grossTotal > 0 ? ((commAmt / grossTotal) * 100) : 0;
            commPctInp.value = calculatedPct % 1 === 0 ? calculatedPct.toFixed(0) : calculatedPct.toFixed(2);
        }
        
        recalcSettlementOnly(grossTotal, commAmt);
    }

    function getBillGrossTotal() {
        let grossTotal = 0;
        const rows = document.querySelectorAll('#billLotBody tr');
        rows.forEach(r => {
            const weightStrInp = r.querySelector('.lot-weight-str');
            const rateInp = r.querySelector('.lot-rate');
            const weightStr = weightStrInp ? weightStrInp.value : "000-00-0";
            const calculatedKg = parseMaundWeight(weightStr);
            const rate = parseFloat(rateInp ? rateInp.value : 0) || 0;
            grossTotal += Math.round(calculatedKg * rate);
        });
        return grossTotal;
    }

    function calculateAndRenderCommission(grossTotal) {
        let commAmt = 0;
        const commAmtInp = document.getElementById('commAmtInput');
        const commPctInp = document.getElementById('commPct');

        if (commCalculationMode === 'amt') {
            commAmt = parseFloat(commAmtInp ? commAmtInp.value : 0) || 0;
            if (commPctInp) {
                const calculatedPct = grossTotal > 0 ? ((commAmt / grossTotal) * 100) : 0;
                commPctInp.value = calculatedPct % 1 === 0 ? calculatedPct.toFixed(0) : calculatedPct.toFixed(2);
            }
        } else {
            const commPctVal = parseFloat(commPctInp ? commPctInp.value : 0) || 0;
            commAmt = Math.round(grossTotal * (commPctVal / 100));
            if (commAmtInp) commAmtInp.value = commAmt;
        }

        recalcSettlementOnly(grossTotal, commAmt);
    }

    function recalcSettlementOnly(grossTotal, commAmt) {
        const commBase = document.getElementById('commBase');
        if (commBase) commBase.textContent = "Rs " + Math.round(grossTotal).toLocaleString();

        const settleTotal = document.getElementById('settleTotal');
        if (settleTotal) settleTotal.textContent = "Rs " + Math.round(grossTotal).toLocaleString();

        const settleComm = document.getElementById('settleComm');
        if (settleComm) settleComm.textContent = "- Rs " + Math.round(commAmt).toLocaleString();

        // Calculate Expenses (Labour + Ice + Farmer Ice + Freight + Other)
        const expLabour = parseFloat(document.getElementById('expLabour')?.value) || 0;
        const expIce = parseFloat(document.getElementById('expIce')?.value) || 0;
        const expFarmerIce = parseFloat(document.getElementById('expFarmerIce')?.value) || 0;
        const expFreight = parseFloat(document.getElementById('expFreight')?.value) || 0;
        const expOther = parseFloat(document.getElementById('expOther')?.value) || 0;
        const totalExp = expLabour + expIce + expFarmerIce + expFreight + expOther;

        const expTotalSpan = document.getElementById('expTotal');
        if (expTotalSpan) expTotalSpan.textContent = "Rs " + totalExp.toLocaleString();

        const settleExp = document.getElementById('settleExp');
        if (settleExp) settleExp.textContent = "- Rs " + totalExp.toLocaleString();

        // Calculate Deposit / Martey
        const expDeposit = parseFloat(document.getElementById('expDeposit')?.value) || 0;
        const settleDeposit = document.getElementById('settleDeposit');
        if (settleDeposit) settleDeposit.textContent = "- Rs " + Math.round(expDeposit).toLocaleString();

        // Calculate Net Payable
        const netPayable = Math.max(0, grossTotal - commAmt - totalExp - expDeposit);
        const settleNet = document.getElementById('settleNet');
        if (settleNet) settleNet.textContent = "Rs " + Math.round(netPayable).toLocaleString();
    }

