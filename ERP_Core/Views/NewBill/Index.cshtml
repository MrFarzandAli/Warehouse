    function openSupplierPaymentModal(billId, supplierId, supplierName, billNo, netPayable, remainingPayable) {
        let rawRemaining = (remainingPayable !== undefined && remainingPayable !== null) ? Number(remainingPayable) : Number(netPayable);
        const remaining = Math.round(rawRemaining);

        if (remaining <= 0) {
            alert(`Bill #${billNo} ki full payment pehle hi ada ho chuki he. Mazeed payment allow nahi he.`);
            return;
        }

        document.getElementById('payBillId').value = billId || 0;
        document.getElementById('payBillNo').value = billNo || '';
        document.getElementById('payLotId').value = '';
        document.getElementById('payLotNo').value = '';
        document.getElementById('payPartyType').value = 'Supplier';
        document.getElementById('payPartyId').value = supplierId || 0;

        // UI Texts
        document.getElementById('payModalTitle').textContent = 'Pay to Supplier (سپلائر کو ادائیگی)';
        document.getElementById('payModalSubTitle').textContent = 'Post Cash/Bank Payment Voucher into Accounts';
        document.getElementById('payPartyRoleLbl').textContent = 'Supplier / Boat';
        document.getElementById('payPartyNameDisplay').textContent = supplierName || 'Supplier';
        document.getElementById('payBillNoDisplay').textContent = billNo || '';
        document.getElementById('payLotWrap').style.display = 'none';
        document.getElementById('payAmountRefLbl').textContent = 'Baqaya Payable';
        document.getElementById('payRefAmountDisplay').textContent = 'Rs ' + remaining.toLocaleString();
        
        const amtInput = document.getElementById('payAmountInput');
        amtInput.max = remaining;
        amtInput.value = remaining;
        
        document.getElementById('payNarrationInput').value = `Payment to ${supplierName} against Bill #${billNo}`;
        document.getElementById('paySubmitBtnText').textContent = 'Post Payment Voucher';

        // Icon styling
        const iconWrap = document.getElementById('payModalIconWrap');
        iconWrap.style.background = 'rgba(46,125,50,0.18)';
        iconWrap.style.color = 'var(--green-text)';

        updatePaymentPreview();
        document.getElementById('aarhatPaymentModal').style.display = 'flex';
    }

