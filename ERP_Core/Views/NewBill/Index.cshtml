@model ERP_Core.Dtos.NewBillViewModel

@{
    ViewData["Title"] = "New Bill";
    ViewData["SubTitle"] = "Select supplier/boat, add lots with fish varieties, buyers and Maund weight — commission and expense calculate ho jayenge.";
}

@section Styles {
    <!-- TomSelect CSS for Searchable Dropdown -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />

    <style>
        /* TomSelect Dark Overrides (Matching SupplierPayable & CustomerReceivable) */
        .ts-wrapper .ts-control {
            background-color: var(--surface2, #1A2F2A) !important;
            border: 1px solid var(--border, #2C4740) !important;
            color: var(--text, #EAF1EE) !important;
            border-radius: 6px !important;
            font-size: 13px !important;
            min-height: 36px !important;
            padding: 5px 10px !important;
            box-shadow: none !important;
        }

        .ts-wrapper.focus .ts-control {
            border-color: var(--brass, #C68A3E) !important;
            box-shadow: 0 0 0 2px rgba(198, 138, 62, 0.25) !important;
        }

        .ts-wrapper .ts-control input {
            color: var(--text, #EAF1EE) !important;
        }

        .ts-wrapper .ts-control .item {
            color: var(--text, #EAF1EE) !important;
        }

        .ts-dropdown {
            background-color: #0E1A17 !important;
            border: 1px solid rgba(198, 138, 62, 0.4) !important;
            border-radius: 8px !important;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.75) !important;
            color: #EAF1EE !important;
            z-index: 999999 !important;
        }

        .ts-dropdown .dropdown-input-wrap input {
            background-color: #142521 !important;
            border: 1px solid rgba(198, 138, 62, 0.3) !important;
            color: #EAF1EE !important;
            border-radius: 6px !important;
            padding: 6px 10px !important;
            font-size: 13px !important;
            margin: 6px !important;
            width: calc(100% - 12px) !important;
        }

        .ts-dropdown .option {
            color: #EAF1EE !important;
            padding: 8px 12px !important;
            font-size: 13px !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
        }

        .ts-dropdown .option.active, .ts-dropdown .option:hover {
            background-color: #1B302B !important;
            color: #E3AE66 !important;
        }

        .ts-dropdown .option.selected {
            background-color: #2F6F5E !important;
            color: #FFFFFF !important;
            font-weight: 600 !important;
        }

        /* Ensure table row selects fill cell with proper min-width */
        #lotBillTable td .ts-wrapper {
            width: 100% !important;
            min-width: 140px;
        }
        #lotBillTable td .ts-wrapper .ts-control {
            min-height: 32px !important;
            padding: 4px 8px !important;
            font-size: 12.5px !important;
        }

        .lot-select-wrap {
            display: flex;
            align-items: center;
            gap: 5px;
            width: 100%;
        }
        .lot-select-wrap .ts-wrapper {
            flex: 1;
            min-width: 140px;
        }
        .btn-quick-add {
            width: 28px;
            height: 32px;
            flex: none;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-dim);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
            padding: 0;
        }
        .btn-quick-add:hover {
            background: var(--surface3);
            border-color: var(--brass);
            color: var(--brass-text);
        }
        .btn-quick-add-hdr {
            width: 22px;
            height: 22px;
            border-radius: 4px;
            border: 1px solid var(--border);
            color: var(--brass-text);
            background: rgba(198, 138, 62, 0.12);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            transition: all 0.15s ease;
        }
        .btn-quick-add-hdr:hover {
            background: var(--brass);
            color: #0E1A17;
            border-color: var(--brass);
        }

        .lot-select {
            width: 100%;
            background: var(--surface2);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 13px;
            outline: none;
        }
        .lot-select:focus {
            border-color: var(--brass);
        }
        .lot-input {
            width: 100%;
            background: var(--surface2);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 13px;
            outline: none;
        }
        .lot-input:focus {
            border-color: var(--brass);
        }
        /* Hide number increment/decrement spinners (stepper arrows) */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            appearance: none !important;
            margin: 0 !important; 
        }
        input[type=number] {
            -moz-appearance: textfield !important;
            appearance: textfield !important;
        }
        .lot-weight-str::selection,
        .lot-rate::selection {
            background-color: var(--brass, #C68A3E);
            color: #0E1A17;
        }
        .box-row {
            display: grid;
            grid-template-columns: 1fr 1.15fr 1.25fr;
            gap: 16px;
            margin-top: 20px;
        }
        @@media (max-width: 991px) {
            .box-row {
                grid-template-columns: 1fr;
            }
        }
        .bill-head-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr 2.5fr;
            gap: 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 20px;
        }
        .maund-badge {
            display: inline-block;
            background: rgba(30, 144, 255, 0.12);
            color: var(--teal);
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            margin-top: 2px;
        }
        /* Bill Expandable Rows & Detail Card */
        .btn-expand-toggle {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-dim);
            width: 26px;
            height: 26px;
            border-radius: 5px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            padding: 0;
        }
        .btn-expand-toggle:hover {
            background: var(--surface3);
            color: var(--brass-text);
            border-color: var(--brass);
        }
        .btn-expand-toggle svg {
            transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-expand-toggle.expanded svg {
            transform: rotate(90deg);
        }
        .btn-expand-toggle.expanded {
            background: rgba(198, 138, 62, 0.18);
            border-color: var(--brass);
            color: var(--brass-text);
        }
        .bill-expand-row {
            transition: background 0.2s ease;
        }
        .bill-expand-row-child > td {
            padding: 0 !important;
            background: var(--bg, #040A09) !important;
            border: none !important;
        }
        .bill-expand-card {
            background: #0d1e1a;
            border: 1px solid var(--border);
            border-top: none;
            padding: 16px 20px;
            box-shadow: inset 0 3px 6px rgba(0,0,0,0.25);
        }
        .bill-expand-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            padding-bottom: 12px;
            margin-bottom: 12px;
            border-bottom: 1px dashed var(--border);
        }
        .bill-expand-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
            background: var(--surface);
            border: 1px solid var(--border-soft);
            border-radius: 6px;
            overflow: hidden;
        }
        .bill-expand-table th {
            background: var(--surface2);
            color: var(--text-dim);
            padding: 8px 12px;
            font-weight: 600;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
        }
        .bill-expand-table td {
            padding: 7px 12px;
            border-bottom: 1px solid var(--border-soft);
            color: var(--text);
        }
        .bill-expand-table tbody tr:hover {
            background: var(--surface2);
        }
        .bill-expand-table tfoot td {
            background: var(--surface2);
            font-weight: 700;
            border-top: 1px solid var(--border);
        }
        .bill-finance-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 12px;
        }
        .bill-finance-pill {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 8px 14px;
            font-size: 12px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .bill-finance-pill .pill-lbl {
            font-size: 10.5px;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .bill-finance-pill .pill-val {
            font-weight: 700;
            font-size: 13.5px;
        }
        @@media (max-width: 800px) {
            .bill-head-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="section-title">New Bill &amp; Inward Billing</div>
<div class="section-desc">Select party in header, enter storage item weights and rates — amount and party settlement are calculated in real time.</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:var(--green-dim);color:var(--green-text);padding:12px 16px;border-radius:8px;font-size:13px;margin-bottom:18px;border:1px solid var(--border);display:flex;align-items:center;gap:10px;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background:var(--red-dim);color:var(--red-text);padding:12px 16px;border-radius:8px;font-size:13px;margin-bottom:18px;border:1px solid var(--border);display:flex;align-items:center;gap:10px;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Subtabs (Bill Entry vs Monthly Report) -->
<div class="subtabs no-print" style="margin-bottom:20px;">
    <button type="button" class="subtab-btn active" id="billTabEntryBtn" onclick="switchBillTab('entry')">Bill Entry</button>
    <button type="button" class="subtab-btn" id="billTabReportBtn" onclick="switchBillTab('report')">Monthly Report (@Model.RecentBills.Count Bills)</button>
</div>

<!-- ========================================================================== -->
<!-- 1. BILL ENTRY VIEW                                                         -->
<!-- ========================================================================== -->
<div id="billEntryView">
    <!-- Edit Mode Indicator Banner -->
    <div id="editModeBanner" style="@(Model.Id > 0 ? "display:flex;" : "display:none;")background:rgba(212, 160, 23, 0.12);border:1px solid var(--brass);border-radius:8px;padding:12px 18px;margin-bottom:18px;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:10px;">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--brass)" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <div>
                <strong style="color:var(--brass-text);font-size:13.5px;" id="editBannerTitle">Editing Bill: @Model.BillNo</strong>
                <div style="font-size:12px;color:var(--text-dim);">You are modifying an existing bill. Changes will overwrite lots and totals on Save.</div>
            </div>
        </div>
        <button type="button" class="btn ghost" onclick="resetBillForm()" style="font-size:12px;padding:6px 12px;">
            Cancel Edit
        </button>
    </div>

    <form asp-controller="NewBill" asp-action="SaveBill" method="post" id="newBillForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" id="billId" />

        <!-- Bill Header Info (Supplier only) -->
        <div class="bill-head-grid">
            <div class="field" style="margin-bottom:0;">
                <label style="font-size:12.5px;font-weight:600;margin-bottom:5px;display:block;">Bill No.</label>
                <input type="text" dis asp-for="BillNo" id="billNoInput" class="lot-input" readonly style="background:var(--surface2);font-family:monospace;font-weight:700;color:var(--brass-text);" />
            </div>
            <div class="field" style="margin-bottom:0;">
                <label style="font-size:12.5px;font-weight:600;margin-bottom:5px;display:block;">Date</label>
                <input type="date" asp-for="Date" id="billDateInput" class="lot-input" required />
            </div>
            <div class="field" style="margin-bottom:0;">
                <label style="font-size:12.5px;font-weight:600;margin-bottom:5px;display:block;">Party (Client / Owner)</label>
                <div style="display:flex;gap:6px;align-items:center;">
                    <div style="flex:1;">
                        <select asp-for="SelectedSupplierId" id="billSupplierSelect" class="lot-select">
                            <option value="">-- Select Party --</option>
                            @foreach (var s in Model.SuppliersList)
                            {
                                <option value="@s.Id">@s.DisplayName</option>
                            }
                        </select>
                    </div>
                    <button type="button" class="btn-quick-add" onclick="openQuickSupplierModal()" title="Add New Party" style="width:36px;height:36px;color:var(--brass-text);" tabindex="-1">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Dynamic Lots Table with Maund-Kg-Pao Format -->
        <div class="card" style="padding:0;overflow:hidden;border:1px solid var(--border);margin-bottom:20px;">
            <div style="padding:12px 18px;background:var(--surface2);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--brass)" stroke-width="2"><path d="M6 2h9l5 5v15H6z"/><path d="M15 2v5h5"/><path d="M9 13h6M9 17h6M9 9h2"/></svg>
                    <span style="font-weight:600;font-size:13.5px;color:var(--text);">Lot Details &amp; Storage Goods</span>
                </div>
                <div style="font-size:12px;color:var(--text-dim);">
                    Weight Format: <strong>000-00-0</strong> (Maund-Kg-Pao · 1 Maund = 40Kg, 1=250g, 2=500g, 3=750g)
                </div>
            </div>

            <div class="table-wrap" style="overflow-x:auto;">
                <table class="data-table" id="lotBillTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:35px;text-align:center;">#</th>
                            <th style="width:120px;">LOT #</th>
                            <th style="min-width:220px;">ITEM / COMMODITY <span style="color:var(--red-text);">*</span></th>
                            <th style="width:150px;text-align:center;">
                                WEIGHT (MD-KG-P) <span style="color:var(--red-text);">*</span>
                                <div style="font-size:10px;font-weight:normal;color:var(--text-dim);font-family:monospace;">000-00-0</div>
                            </th>
                            <th style="width:110px;text-align:right;">RATE / KG <span style="color:var(--red-text);">*</span></th>
                            <th style="width:130px;text-align:right;">AMOUNT (RS)</th>
                            <th style="width:45px;text-align:center;"></th>
                        </tr>
                    </thead>
                    <tbody id="billLotBody">
                        @for (int i = 0; i < Model.Lots.Count; i++)
                        {
                            var lot = Model.Lots[i];
                            <tr id="billRow_@(i+1)">
                                <td style="text-align:center;color:var(--text-faint);font-weight:600;">@(i + 1)</td>
                                <td>
                                    <input type="text" class="lot-input lot-no" readonly name="Lots[@i].LotNo" value="@lot.LotNo" placeholder="LOT-1001" style="font-family:monospace;" />
                                </td>
                                <td>
                                    @if (i == 0)
                                    {
                                        <div class="lot-select-wrap">
                                            <select class="lot-select lot-fish" name="Lots[@i].FishId">
                                                <option value="">-- Select Item / Commodity --</option>
                                                @foreach (var f in Model.FishList)
                                                {
                                                    <option value="@f.Id" selected="@(f.Id == lot.FishId || f.Name == lot.FishName)">@f.DisplayName</option>
                                                }
                                            </select>
                                            <button type="button" class="btn-quick-add" onclick="openQuickFishModal(this)" title="Add New Item / Commodity" tabindex="-1">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <select class="lot-select lot-fish" name="Lots[@i].FishId">
                                            <option value="">-- Select Item / Commodity --</option>
                                            @foreach (var f in Model.FishList)
                                             {
                                                <option value="@f.Id" selected="@(f.Id == lot.FishId || f.Name == lot.FishName)">@f.DisplayName</option>
                                            }
                                        </select>
                                    }
                                    <input type="hidden" class="lot-customer" name="Lots[@i].CustomerId" value="@(lot.CustomerId ?? Model.SelectedSupplierId)" />
                                </td>
                                <td>
                                    <input type="text" class="lot-input lot-weight-str tnum" name="Lots[@i].WeightStr" value="@lot.WeightStr" placeholder="000-00-0" required style="text-align:center;font-family:monospace;font-weight:700;letter-spacing:1px;" oninput="recalcBillTotals()" onblur="normalizeMaundInput(this)" />
                                    <input type="hidden" class="lot-weight" name="Lots[@i].WeightKg" value="@lot.WeightKg" />
                                    <div style="text-align:center;">
                                        <span class="maund-badge lot-kg-badge">@(lot.WeightKg > 0 ? $"{lot.WeightKg:N2} Kg" : "0.0 Kg")</span>
                                    </div>
                                </td>
                                <td>
                                    <input type="number" step="1" min="1" class="lot-input lot-rate tnum" name="Lots[@i].RatePerKg" value="@lot.RatePerKg" required style="text-align:right;" oninput="recalcBillTotals()" />
                                </td>
                                <td class="lot-amount tnum" style="text-align:right;font-weight:700;color:var(--text);">
                                    <span class="lot-amount-display">Rs @Math.Round(lot.Amount, 0).ToString("N0")</span>
                                    <input type="hidden" class="lot-amount-input" name="Lots[@i].Amount" value="@Math.Round(lot.Amount, 0)" />
                                </td>
                                <td style="text-align:center;">
                                    <button type="button" class="btn ghost icon-only" onclick="removeLotRow('billRow_@(i+1)')" title="Remove lot" style="padding:4px 6px;color:var(--red-text);">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="background:var(--surface2);font-weight:700;">
                            <td colspan="3" style="text-align:right;font-size:13.5px;">Gross Bill Total:</td>
                            <td style="text-align:center;" id="totalWeightCell">
                                @{
                                    var initialTotalKg = Model.Lots?.Sum(l => l.WeightKg) ?? 0;
                                    var initialMaundStr = ERP_Core.Dtos.BillLotItemDto.FormatKgToMaund(initialTotalKg);
                                }
                                <div id="totalWeightMaund" style="font-family:monospace;font-weight:700;font-size:13px;color:var(--brass-text);letter-spacing:0.5px;">@initialMaundStr</div>
                                <div style="text-align:center;margin-top:2px;">
                                    <span class="maund-badge" id="totalWeightKgBadge" style="font-size:11px;">@(initialTotalKg > 0 ? $"{initialTotalKg:N2} Kg" : "0.0 Kg")</span>
                                </div>
                            </td>
                            <td style="text-align:right;font-size:13.5px;">Total Sale:</td>
                            <td class="tnum" id="billTotalCell" style="text-align:right;font-size:14px;color:var(--brass-text);">Rs 0</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div style="padding:12px 18px;background:var(--surface);border-top:1px solid var(--border);">
                <button type="button" class="btn ghost" onclick="addNewLotRow()">
                    <svg viewBox="0 0 24 24" width="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    Add Lot Row
                </button>
            </div>
        </div>

        <!-- 3-Box Calculation Matrix -->
        <div class="box-row">
            <!-- Box 1: Commission -->
            <div class="box commission">
                <h4>
                    <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 9h.01M15 15h.01M15 9 9 15"/></svg></i>
                    Box 1 · Commission
                </h4>
                <div class="box-line">
                    <label>Bill Gross Total</label>
                    <span class="tnum" id="commBase">Rs 0</span>
                </div>
                <div class="box-line">
                    <label>Commission %</label>
                    <input type="number" asp-for="CommissionPercent" id="commPct" step="0.1" class="lot-input" style="width:100px;text-align:right;" oninput="onCommPctChanged()" />
                </div>
                <div class="box-line total">
                    <label>Commission Amount</label>
                    <div style="display:flex;align-items:center;gap:6px;">
                        <span style="color:var(--text-dim);font-size:12px;">Rs</span>
                        <input type="number" asp-for="CommissionAmount" id="commAmtInput" step="1" class="lot-input tnum" style="width:120px;text-align:right;font-weight:700;color:var(--brass-text);" oninput="onCommAmtChanged()" />
                    </div>
                </div>
            </div>

            <!-- Box 2: Expenses & Deposit -->
            <div class="box expense">
                <h4>
                    <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></i>
                    Box 2 · Expenses &amp; Deposit
                </h4>
                <div class="box-line">
                    <label>Labour / مزدوری</label>
                    <input type="number" asp-for="LabourExpense" id="expLabour" class="lot-input" style="width:100px;text-align:right;" oninput="recalcBillTotals()" />
                </div>
                <div class="box-line" style="display:none;">
                    <label>Ice / برف</label>
                    <input type="number" asp-for="IceExpense" id="expIce" value="0" class="lot-input" style="width:100px;text-align:right;" oninput="recalcBillTotals()" />
                </div>
                <div class="box-line" style="display:none;">
                    <label>Farmer Ice / زمیندار برف</label>
                    <input type="number" asp-for="FarmerIceExpense" id="expFarmerIce" value="0" class="lot-input" style="width:100px;text-align:right;" oninput="recalcBillTotals()" />
                </div>
                <div class="box-line">
                    <label>Freight / کرایہ</label>
                    <input type="number" asp-for="FreightExpense" id="expFreight" class="lot-input" style="width:100px;text-align:right;" oninput="recalcBillTotals()" />
                </div>
                <div class="box-line">
                    <label>Other Expense / دیگر خرچ</label>
                    <input type="number" asp-for="OtherExpense" id="expOther" class="lot-input" style="width:100px;text-align:right;" oninput="recalcBillTotals()" />
                </div>
                <div class="box-line">
                    <label>Deposit / Martey (مارتی)</label>
                    <input type="number" asp-for="Deposit" id="expDeposit" class="lot-input" style="width:100px;text-align:right;color:var(--red-text);font-weight:700;" oninput="recalcBillTotals()" />
                </div>
                <div class="box-line total">
                    <label>Total Expenses</label>
                    <span class="amt tnum" id="expTotal" style="color:var(--red-text);font-weight:700;">Rs 0</span>
                </div>
            </div>

            <!-- Box 3: Settlement -->
            <div class="box settle">
                <h4>
                    <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7"/></svg></i>
                    Settlement
                </h4>
                <div class="box-line">
                    <label>Total Sale (Receivable)</label>
                    <span class="tnum font-weight-bold" id="settleTotal" style="font-weight:700;">Rs 0</span>
                </div>
                <div class="box-line" id="boxLineCashSale" style="display:none;background:rgba(16,185,129,0.08);padding:5px 8px;border-radius:4px;margin-bottom:6px;">
                    <label style="color:var(--green-text);font-weight:600;">Of which Cash Sale</label>
                    <span class="tnum" style="color:var(--green-text);font-weight:700;" id="settleCashSale">Rs 0</span>
                </div>
                <div class="box-line">
                    <label>Less: Commission</label>
                    <span class="tnum" style="color:var(--brass-text);" id="settleComm">Rs 0</span>
                </div>
                <div class="box-line">
                    <label>Less: Expenses</label>
                    <span class="tnum" style="color:var(--red-text);" id="settleExp">Rs 0</span>
                </div>
                <div class="box-line">
                    <label>Less: Deposit / Martey</label>
                    <span class="tnum" style="color:var(--red-text);" id="settleDeposit">Rs 0</span>
                </div>
                <div class="final">
                    <div class="box-line" style="padding:0;">
                        <label style="color:var(--text-dim);">Net Payable / Party Balance</label>
                        <span class="amt tnum font-weight-bold" id="settleNet" style="font-size:18px;font-weight:800;color:var(--green-text);">Rs 0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Remarks & Action Buttons -->
        <div style="margin-top:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;">
            <div style="flex:1;max-width:480px;">
                <input type="text" asp-for="Remarks" id="billRemarksInput" placeholder="Remarks / Storage Notes (optional)" class="lot-input" />
            </div>
            <div style="display:flex;gap:10px;">
                <button type="button" class="btn ghost" onclick="resetBillForm()">Clear / New</button>
                <button type="submit" class="btn brass" id="btnSaveBill">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    <span id="btnSaveBillText">@(Model.Id > 0 ? "Update Bill" : "Save Bill")</span>
                </button>
                <button type="button" class="btn brass" onclick="saveAndPrintBill()" style="background:var(--teal);">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18h12v4H6zM6 14h12"/></svg>
                    <span>Save &amp; Print Bill</span>
                </button>
            </div>
        </div>
    </form>

    <!-- Recent Bills Table from Database -->
    <div class="card" style="margin-top:26px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <div style="display:flex;align-items:center;gap:8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--brass)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                <h3 style="font-size:14.5px;margin:0;color:var(--text);font-weight:700;">Recent Bills Database Records</h3>
                <span class="badge gray">@Model.RecentBills.Count bills</span>
            </div>
            <div style="font-size:12px;color:var(--text-dim);">
                Click <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;"><polyline points="9 18 15 12 9 6"/></svg> to <strong>Expand Lot &amp; Goods Details</strong>, or <strong>Edit</strong> / <strong>Print</strong>.
            </div>
        </div>

        <div class="table-wrap">
            <table class="dynamic-table" id="recentBillsTable" style="width:100%;">
                <thead>
                    <tr>
                        <th class="no-sort" style="width:36px;text-align:center;" title="Expand / Collapse Bill Details"></th>
                        <th style="width:110px;">BILL #</th>
                        <th style="width:110px;">DATE</th>
                        <th style="min-width:180px;">PARTY</th>
                        <th style="width:80px;text-align:center;">LOTS</th>
                        <th style="width:120px;text-align:right;">TOTAL SALE</th>
                        <th style="width:110px;text-align:right;">COMMISSION</th>
                        <th style="width:120px;text-align:right;">NET PAYABLE</th>
                        <th style="width:90px;text-align:center;">STATUS</th>
                        <th class="no-sort" style="width:120px;text-align:right;">ACTIONS</th>
                    </tr>
                    <tr class="dt-col-filter">
                        <th></th>
                        <th><input type="text" placeholder="Filter Bill #..." /></th>
                        <th><input type="text" placeholder="Filter Date..." /></th>
                        <th><input type="text" placeholder="Filter Party..." /></th>
                        <th><input type="text" placeholder="Filter Lots..." /></th>
                        <th><input type="text" placeholder="Filter Total..." /></th>
                        <th><input type="text" placeholder="Filter Comm..." /></th>
                        <th><input type="text" placeholder="Filter Net..." /></th>
                        <th>
                            <select>
                                <option value="">All</option>
                                <option value="Paid">Paid</option>
                                <option value="Due">Due</option>
                            </select>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentBills != null && Model.RecentBills.Any())
                    {
                        @foreach (var b in Model.RecentBills)
                        {
                            <tr id="billRowHeader_@b.Id">
                                <td style="text-align:center;padding:6px;">
                                    <button type="button" class="btn-expand-toggle" id="expandBtn_@b.Id" onclick="toggleBillDetails(@b.Id, this)" title="Expand / Collapse Details">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                                    </button>
                                </td>
                                <td>
                                    <span class="badge brass" style="font-family:monospace;font-weight:700;cursor:pointer;" onclick="toggleBillDetails(@b.Id, document.getElementById('expandBtn_@b.Id'))" title="Click to expand details">@b.BillNo</span>
                                </td>
                                <td>@b.Date</td>
                                <td><strong style="cursor:pointer;" onclick="toggleBillDetails(@b.Id, document.getElementById('expandBtn_@b.Id'))">@b.SupplierName</strong></td>
                                <td style="text-align:center;">
                                    <span class="badge gray" style="cursor:pointer;" onclick="toggleBillDetails(@b.Id, document.getElementById('expandBtn_@b.Id'))">@b.LotsCount lots</span>
                                </td>
                                <td class="tnum" style="text-align:right;font-weight:700;">Rs @b.TotalSale.ToString("N0")</td>
                                <td class="tnum" style="text-align:right;color:var(--brass-text);">Rs @b.Commission.ToString("N0")</td>
                                <td class="tnum" style="text-align:right;font-weight:800;color:var(--green-text);">Rs @b.NetPayable.ToString("N0")</td>
                                <td style="text-align:center;">
                                    @if (b.Status == "Paid")
                                    {
                                        <span class="badge green">Paid</span>
                                    }
                                    else if (b.Status == "Due")
                                    {
                                        <span class="badge red">Due</span>
                                    }
                                    else
                                    {
                                        <span class="badge gray">@b.Status</span>
                                    }
                                </td>
                                <td style="text-align:right;">
                                    <div style="display:flex;justify-content:flex-end;gap:5px;align-items:center;">
                                        <!-- Pay Supplier Quick Action Button -->
                                        @if (b.IsSupplierPaid)
                                        {
                                            <button type="button" class="btn ghost icon-only" title="Supplier Full Paid (Rs @b.PaidToSupplier.ToString("N0"))" onclick="alert('Is Bill (#@b.BillNo) ki payment pehle hi mukammal ho chuki he.')" style="padding:5px 8px;color:var(--green-text);border:1px solid var(--green);border-radius:6px;background:rgba(46,125,50,0.18);">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn ghost icon-only" title="Pay Supplier / ادائیگی (@(b.SupplierName ?? "Supplier")) — Baqaya: Rs @b.RemainingPayable.ToString("N0")" onclick="openSupplierPaymentModal(@b.Id, @(b.SupplierId ?? 0), '@Html.Raw((b.SupplierName ?? "").Replace("'", "\\'"))', '@b.BillNo', Math.round(@b.NetPayable), Math.round(@b.RemainingPayable))" style="padding:5px 8px;color:var(--green-text);border:1px solid rgba(46,125,50,0.25);border-radius:6px;background:rgba(46,125,50,0.08);">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><path d="M6 15h2"/></svg>
                                            </button>
                                        }

                                        <!-- View / Expand Details Button -->
                                        <button type="button" class="btn ghost icon-only" title="Expand / View Details" onclick="toggleBillDetails(@b.Id, document.getElementById('expandBtn_@b.Id'))" style="padding:5px 8px;color:var(--teal-text);">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </button>

                                        <!-- Edit Button -->
                                        <button type="button" class="btn ghost icon-only" title="Edit Bill" onclick="editBillById(@b.Id)" style="padding:5px 8px;color:var(--brass-text);">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </button>

                                        <!-- Print Button -->
                                        <button type="button" class="btn ghost icon-only" title="Print Invoice" onclick="printBillById(@b.Id)" style="padding:5px 8px;">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18h12v4H6zM6 14h12"/></svg>
                                        </button>

                                        <!-- Delete Button -->
                                        <form asp-controller="NewBill" asp-action="DeleteBill" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Are you sure you want to delete Bill @b.BillNo?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn ghost icon-only" title="Delete Bill" style="padding:5px 8px;color:var(--red-text);">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Hidden Templates for Expandable Bill Details -->
    <div id="billDetailsTemplates" style="display:none;">
        @if (Model.RecentBills != null && Model.RecentBills.Any())
        {
            @foreach (var b in Model.RecentBills)
            {
                <div id="billDetailsTemplate_@b.Id">
                    <div class="bill-expand-card">
                        <!-- Header: Bill #, Voucher #, Boat, Date, Remarks & Actions -->
                        <div class="bill-expand-header">
                            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                <span class="badge brass" style="font-family:monospace;font-size:13px;font-weight:700;">@b.BillNo</span>
                                @if (!string.IsNullOrEmpty(b.VoucherNo))
                                {
                                    <span class="badge" style="background:rgba(47, 158, 140, 0.18);color:var(--teal-text);border:1px solid var(--teal);font-family:monospace;font-size:12px;font-weight:600;">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                        Main: @b.VoucherNo
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(b.ExpenseVoucherNo))
                                {
                                    <span class="badge" style="background:rgba(46, 125, 50, 0.18);color:var(--green-text);border:1px solid var(--green);font-family:monospace;font-size:12px;font-weight:600;">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px;"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/></svg>
                                        Expense: @b.ExpenseVoucherNo
                                    </span>
                                }
                                <span style="font-size:13px;font-weight:600;color:var(--text);">Supplier: <strong style="color:var(--brass-text);">@b.SupplierName</strong></span>
                                <span style="font-size:12px;color:var(--text-dim);"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>@b.Date</span>
                                @if (!string.IsNullOrWhiteSpace(b.Remarks))
                                {
                                    <span style="font-size:12px;color:var(--text-dim);background:var(--surface2);padding:2px 8px;border-radius:4px;border:1px solid var(--border-soft);">
                                        <i>Note: @b.Remarks</i>
                                    </span>
                                }
                            </div>
                            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                <!-- Pay Supplier Button in Expanded Header -->
                                @if (b.IsSupplierPaid)
                                {
                                    <span class="badge green" style="font-size:12px;padding:5px 12px;display:inline-flex;align-items:center;gap:5px;font-weight:700;">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                        Supplier Paid (Rs @b.PaidToSupplier.ToString("N0"))
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn ghost" onclick="openSupplierPaymentModal(@b.Id, @(b.SupplierId ?? 0), '@Html.Raw((b.SupplierName ?? "").Replace("'", "\\'"))', '@b.BillNo', Math.round(@b.NetPayable), Math.round(@b.RemainingPayable))" style="font-size:12px;padding:4px 10px;color:var(--green-text);border:1px solid rgba(46,125,50,0.3);background:rgba(46,125,50,0.08);">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><path d="M6 15h2"/></svg>
                                        Pay Supplier (ادائیگی) @(b.PaidToSupplier > 0 ? $"· Baqaya: Rs {b.RemainingPayable:N0}" : "")
                                    </button>
                                }
                                <button type="button" class="btn ghost" onclick="editBillById(@b.Id)" style="font-size:12px;padding:4px 10px;color:var(--brass-text);">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    Edit in Form
                                </button>
                                <button type="button" class="btn ghost" onclick="printBillById(@b.Id)" style="font-size:12px;padding:4px 10px;">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M6 9V2h12v7M6 18h12v4H6zM6 14h12"/></svg>
                                    Print Invoice
                                </button>
                            </div>
                        </div>

                        <!-- Lots Details Table -->
                        <div style="overflow-x:auto;margin-bottom:12px;">
                            <table class="bill-expand-table">
                                <thead>
                                    <tr>
                                        <th style="width:35px;text-align:center;">#</th>
                                        <th style="width:110px;">LOT #</th>
                                        <th>ITEM / COMMODITY</th>
                                        <th>PARTY</th>
                                        <th style="width:140px;text-align:center;">WEIGHT (MD-KG-P)</th>
                                        <th style="width:110px;text-align:right;">RATE / KG</th>
                                        <th style="width:130px;text-align:right;">AMOUNT (RS)</th>
                                        <th style="width:160px;text-align:center;">ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (b.Lots != null && b.Lots.Any())
                                    {
                                        int lotIdx = 1;
                                        @foreach (var lot in b.Lots)
                                        {
                                            <tr>
                                                <td style="text-align:center;color:var(--text-faint);">@lotIdx</td>
                                                <td><span style="font-family:monospace;font-weight:600;color:var(--text);">@lot.LotNo</span></td>
                                                <td><strong style="color:var(--text);">@lot.FishName</strong></td>
                                                <td>
                                                    <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
                                                        <span style="color:var(--text-dim);">@(string.IsNullOrWhiteSpace(lot.CustomerName) ? "General Buyer" : lot.CustomerName)</span>
                                                    </div>
                                                </td>
                                                <td style="text-align:center;font-family:monospace;font-weight:700;color:var(--brass-text);">@lot.WeightStr</td>
                                                <td class="tnum" style="text-align:right;">Rs @lot.RatePerKg.ToString("N0")</td>
                                                <td class="tnum" style="text-align:right;font-weight:700;color:var(--text);">Rs @lot.Amount.ToString("N0")</td>
                                                <td style="text-align:center;">
                                                    <div style="display:inline-flex;align-items:center;justify-content:center;gap:5px;">
                                                        @if (lot.IsPaid)
                                                        {
                                                            <span class="badge green" style="font-size:10.5px;padding:3px 7px;display:inline-flex;align-items:center;gap:3px;" title="Full Received Rs @lot.ReceivedAmount.ToString("N0")">
                                                                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                                                Received
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn ghost icon-only" title="Receive Payment from @lot.CustomerName (گاہک سے وصولی) — Baqaya: Rs @lot.RemainingAmount.ToString("N0")" onclick="openCustomerReceiptModal(@b.Id, @lot.Id, @(lot.CustomerId ?? 0), '@Html.Raw((lot.CustomerName ?? "").Replace("'", "\\'"))', '@b.BillNo', '@lot.LotNo', @lot.Amount, @lot.RemainingAmount)" style="padding:3px 8px;font-size:11px;color:var(--teal-text);border:1px solid rgba(47,158,140,0.3);border-radius:4px;display:inline-flex;align-items:center;gap:4px;background:rgba(47,158,140,0.08);">
                                                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                                                Receive @(lot.ReceivedAmount > 0 ? $"(Rs {lot.RemainingAmount:N0})" : "")
                                                            </button>
                                                        }
                                                        <button type="button" class="btn ghost icon-only" title="Print / View Lot Item Report (@lot.LotNo)"
                                                                data-billno="@b.BillNo"
                                                                data-date="@b.Date"
                                                                data-supplier="@b.SupplierName?.Replace("\"", "&quot;")"
                                                                data-lotno="@lot.LotNo"
                                                                data-fish="@lot.FishName?.Replace("\"", "&quot;")"
                                                                data-customer="@((string.IsNullOrWhiteSpace(lot.CustomerName) ? "General Buyer" : lot.CustomerName)?.Replace("\"", "&quot;"))"
                                                                data-weightstr="@lot.WeightStr"
                                                                data-weightkg="@lot.WeightKg"
                                                                data-rate="@lot.RatePerKg"
                                                                data-amount="@lot.Amount"
                                                                data-voucher="@(b.VoucherNo ?? "")"
                                                                data-billstatus="@b.Status"
                                                                data-ispaid="@(lot.IsPaid ? "Received" : (lot.ReceivedAmount > 0 ? "Partial" : "Due"))"
                                                                onclick="handlePrintLotReport(this)"
                                                                style="padding:3px 8px;font-size:11px;color:var(--brass-text);border:1px solid rgba(198,138,62,0.3);border-radius:4px;display:inline-flex;align-items:center;gap:4px;background:rgba(198,138,62,0.08);">
                                                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                                            Report
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            lotIdx++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" style="text-align:center;color:var(--text-dim);padding:14px;">No catch lots recorded for this bill.</td>
                                        </tr>
                                    }
                                </tbody>
                                @{
                                    var cashLots = b.Lots?.Where(l => !string.IsNullOrWhiteSpace(l.CustomerName) && 
                                        l.CustomerName.Trim().IndexOf("CASH", StringComparison.OrdinalIgnoreCase) >= 0).ToList() ?? new List<ERP_Core.Dtos.BillLotItemDto>();
                                    var cashSaleTotal = cashLots.Sum(l => l.Amount);
                                    var cashLotsCount = cashLots.Count;
                                    var creditSaleTotal = b.TotalSale - cashSaleTotal;
                                }
                                <tfoot>
                                    <tr>
                                        <td colspan="3" style="text-align:right;font-weight:600;">Total Catch Summary (@b.LotsCount lots):</td>
                                        <td style="text-align:left;">
                                            @if (cashSaleTotal > 0)
                                            {
                                                <span class="badge" style="background:rgba(16,185,129,0.15);color:var(--green-text);border:1px solid rgba(16,185,129,0.3);font-size:11px;font-weight:700;padding:3px 8px;">
                                                    Cash Sale: Rs @cashSaleTotal.ToString("N0") (@cashLotsCount lots)
                                                </span>
                                            }
                                        </td>
                                        <td style="text-align:center;font-family:monospace;font-weight:700;color:var(--brass-text);">
                                            @ERP_Core.Dtos.BillLotItemDto.FormatKgToMaund(b.Lots?.Sum(l => l.WeightKg) ?? 0)
                                        </td>
                                        <td style="text-align:right;font-weight:700;">Gross Sale Total:</td>
                                        <td class="tnum" style="text-align:right;color:var(--brass-text);font-weight:800;font-size:14px;">Rs @b.TotalSale.ToString("N0")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- 3-Box Financial Breakdown Summary Pills -->
                        <div class="bill-finance-pills">
                            @if (cashSaleTotal > 0)
                            {
                                <div class="bill-finance-pill" style="border-left:3px solid var(--green);">
                                    <span class="pill-lbl">Cash Sale Total (@cashLotsCount lots)</span>
                                    <span class="pill-val tnum" style="color:var(--green-text);">Rs @cashSaleTotal.ToString("N0")</span>
                                    <span style="font-size:10.5px;color:var(--text-dim);">Credit Sale: Rs @creditSaleTotal.ToString("N0")</span>
                                </div>
                            }
                            <div class="bill-finance-pill" style="border-left:3px solid var(--brass);">
                                <span class="pill-lbl">Box 1 · Commission (@b.CommissionPercent%)</span>
                                <span class="pill-val tnum" style="color:var(--brass-text);">Rs @b.Commission.ToString("N0")</span>
                            </div>
                            <div class="bill-finance-pill" style="border-left:3px solid var(--red);">
                                <span class="pill-lbl">Box 2 · Expenses</span>
                                <span class="pill-val tnum" style="color:var(--red-text);">Rs @b.Expenses.ToString("N0")</span>
                                <span style="font-size:10.5px;color:var(--text-dim);">Labour: Rs @b.LabourExpense.ToString("N0") | Ice: Rs @b.IceExpense.ToString("N0")@(b.FreightExpense > 0 ? $" | Freight: Rs {b.FreightExpense:N0}" : "")@(b.OtherExpense > 0 ? $" | Other: Rs {b.OtherExpense:N0}" : "")</span>
                            </div>
                            @if (b.Deposit > 0)
                            {
                                <div class="bill-finance-pill" style="border-left:3px solid var(--red);">
                                    <span class="pill-lbl">Deposit / Martey</span>
                                    <span class="pill-val tnum" style="color:var(--red-text);">Rs @b.Deposit.ToString("N0")</span>
                                    <span style="font-size:10.5px;color:var(--text-dim);">Deducted from catch</span>
                                </div>
                            }
                            <div class="bill-finance-pill" style="border-left:3px solid var(--green);margin-left:auto;">
                                <span class="pill-lbl">Net Settlement Payable</span>
                                <span class="pill-val tnum" style="color:var(--green-text);font-size:15px;">Rs @b.NetPayable.ToString("N0")</span>
                            </div>
                        </div>

                        <!-- Main Voucher Double-Entry Accounts Posting Summary -->
                        <div style="margin-top:14px;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:12px 16px;">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;border-bottom:1px dashed var(--border-soft);padding-bottom:6px;">
                                <span style="font-weight:700;font-size:12px;color:var(--teal-text);display:flex;align-items:center;gap:6px;">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                    1. Brokerage Bill — Main Voucher (@(b.VoucherNo ?? "JV (Journal Voucher)"))
                                </span>
                                <span style="font-size:11.5px;color:var(--green-text);font-weight:600;">
                                    Balanced: Total Debit Rs @b.TotalSale.ToString("N0") = Total Credit Rs @b.TotalSale.ToString("N0")
                                </span>
                            </div>
                            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:8px;font-size:12px;">
                                <div style="background:var(--surface2);padding:7px 10px;border-radius:4px;border-left:3px solid var(--teal);">
                                    <div style="color:var(--text-dim);font-size:11px;">[DEBIT] Supplier Receivable:</div>
                                    <div style="font-weight:700;color:var(--text);">Rs @b.TotalSale.ToString("N0")</div>
                                </div>
                                <div style="background:var(--surface2);padding:7px 10px;border-radius:4px;border-left:3px solid var(--green);">
                                    <div style="color:var(--text-dim);font-size:11px;">[CREDIT] Farmer Payable (@b.SupplierName):</div>
                                    <div style="font-weight:700;color:var(--green-text);">Rs @((b.TotalSale - b.Commission - b.Deposit).ToString("N0"))</div>
                                </div>
                                @if (b.Deposit > 0)
                                {
                                    <div style="background:var(--surface2);padding:7px 10px;border-radius:4px;border-left:3px solid var(--red);">
                                        <div style="color:var(--text-dim);font-size:11px;">[CREDIT] Farmer Martey (@b.SupplierName):</div>
                                        <div style="font-weight:700;color:var(--red-text);">Rs @b.Deposit.ToString("N0")</div>
                                    </div>
                                }
                                <div style="background:var(--surface2);padding:7px 10px;border-radius:4px;border-left:3px solid var(--brass);">
                                    <div style="color:var(--text-dim);font-size:11px;">[CREDIT] Commission Income (@b.CommissionPercent%):</div>
                                    <div style="font-weight:700;color:var(--brass-text);">Rs @b.Commission.ToString("N0")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Voucher #2: Farmer Expenses Voucher (Labour + Ice) -->
                        @if (b.Expenses > 0)
                        {
                            <div style="margin-top:10px;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:12px 16px;">
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;border-bottom:1px dashed var(--border-soft);padding-bottom:6px;">
                                    <span style="font-weight:700;font-size:12px;color:var(--green-text);display:flex;align-items:center;gap:6px;">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/></svg>
                                        2. Farmer Expenses Voucher (@(b.ExpenseVoucherNo ?? "CPV (Cash Payment Voucher)"))
                                    </span>
                                    <span style="font-size:11.5px;color:var(--green-text);font-weight:600;">
                                        Balanced: Total Debit Rs @b.Expenses.ToString("N0") = Total Credit Rs @b.Expenses.ToString("N0")
                                    </span>
                                </div>
                                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:8px;font-size:12px;">
                                    <div style="background:var(--surface2);padding:7px 10px;border-radius:4px;border-left:3px solid var(--teal);">
                                        <div style="color:var(--text-dim);font-size:11px;">[DEBIT] Farmer Payable (@b.SupplierName):</div>
                                        <div style="font-weight:700;color:var(--text);">Rs @b.Expenses.ToString("N0")</div>
                                        <div style="font-size:10.5px;color:var(--text-dim);margin-top:2px;">Labour: Rs @b.LabourExpense.ToString("N0") | Ice: Rs @b.IceExpense.ToString("N0")@(b.FreightExpense > 0 ? $" | Freight: Rs {b.FreightExpense:N0}" : "")@(b.OtherExpense > 0 ? $" | Other: Rs {b.OtherExpense:N0}" : "")</div>
                                    </div>
                                    <div style="background:var(--surface2);padding:7px 10px;border-radius:4px;border-left:3px solid var(--green);">
                                        <div style="color:var(--text-dim);font-size:11px;">[CREDIT] Cash in Hand / Bank (1001):</div>
                                        <div style="font-weight:700;color:var(--green-text);">Rs @b.Expenses.ToString("N0")</div>
                                        <div style="font-size:10.5px;color:var(--text-dim);margin-top:2px;">Paid by Mandi on behalf of farmer</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- ========================================================================== -->
<!-- 2. MONTHLY REPORT VIEW                                                     -->
<!-- ========================================================================== -->
<div id="billReportView" style="display:none;">
    @{
        var recentBills = Model.RecentBills ?? new List<ERP_Core.Dtos.BillSummaryDto>();
        var totalSaleSum = recentBills.Sum(b => b.TotalSale);
        var totalCommSum = recentBills.Sum(b => b.Commission);
        var totalNetSum = recentBills.Sum(b => b.NetPayable);
    }

    <div class="stat-grid" style="margin-bottom:20px;">
        <div class="stat-card">
            <div class="lbl">TOTAL BILLS</div>
            <div class="val tnum">@(recentBills?.Count ?? 0)</div>
            <div class="sub">Settled &amp; active auction bills</div>
        </div>
        <div class="stat-card">
            <div class="lbl">TOTAL GROSS SALE</div>
            <div class="val tnum" style="color:var(--text);">Rs @totalSaleSum.ToString("N0")</div>
            <div class="sub">Total receivable from buyers</div>
        </div>
        <div class="stat-card">
            <div class="lbl">TOTAL COMMISSION</div>
            <div class="val tnum" style="color:var(--brass-text);">Rs @totalCommSum.ToString("N0")</div>
            <div class="sub">Aarhat agency earnings</div>
        </div>
        <div class="stat-card">
            <div class="lbl">NET PAYABLE TO SUPPLIERS</div>
            <div class="val tnum" style="color:var(--green-text);">Rs @totalNetSum.ToString("N0")</div>
            <div class="sub">After commission &amp; expenses</div>
        </div>
    </div>

    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 style="font-size:14.5px;margin:0;font-weight:700;">Monthly Bill Summary Report</h3>
            <button type="button" class="btn brass" onclick="AarhatApp.printLedgerStatement('Monthly Bill Summary', 'Current Period', 'Today', @totalSaleSum, @totalCommSum, @totalNetSum, [])">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18h12v4H6zM6 14h12"/></svg>
                Print Summary Report
            </button>
        </div>

        <div class="table-wrap">
            <table class="dynamic-table" id="reportBillsTable" style="width:100%;">
                <thead>
                    <tr>
                        <th class="no-sort" style="width:36px;text-align:center;"></th>
                        <th>BILL #</th>
                        <th>DATE</th>
                        <th>SUPPLIER (BOAT / FARMER)</th>
                        <th style="text-align:center;">LOTS</th>
                        <th style="text-align:right;">TOTAL SALE</th>
                        <th style="text-align:right;">COMMISSION</th>
                        <th style="text-align:right;">NET PAYABLE</th>
                        <th style="text-align:center;">STATUS</th>
                    </tr>
                    <tr class="dt-col-filter">
                        <th></th>
                        <th><input type="text" placeholder="Filter Bill #..." /></th>
                        <th><input type="text" placeholder="Filter Date..." /></th>
                        <th><input type="text" placeholder="Filter Supplier..." /></th>
                        <th><input type="text" placeholder="Filter Lots..." /></th>
                        <th><input type="text" placeholder="Filter Total..." /></th>
                        <th><input type="text" placeholder="Filter Comm..." /></th>
                        <th><input type="text" placeholder="Filter Net..." /></th>
                        <th>
                            <select>
                                <option value="">All</option>
                                <option value="Paid">Paid</option>
                                <option value="Due">Due</option>
                            </select>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentBills != null && recentBills.Any())
                    {
                        @foreach (var b in recentBills)
                        {
                            <tr id="reportBillRowHeader_@b.Id">
                                <td style="text-align:center;padding:6px;">
                                    <button type="button" class="btn-expand-toggle" id="reportExpandBtn_@b.Id" onclick="toggleReportBillDetails(@b.Id, this)" title="Expand Details">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                                    </button>
                                </td>
                                <td><span class="badge brass" style="font-family:monospace;cursor:pointer;" onclick="toggleReportBillDetails(@b.Id, document.getElementById('reportExpandBtn_@b.Id'))">@b.BillNo</span></td>
                                <td>@b.Date</td>
                                <td><strong style="cursor:pointer;" onclick="toggleReportBillDetails(@b.Id, document.getElementById('reportExpandBtn_@b.Id'))">@b.SupplierName</strong></td>
                                <td style="text-align:center;"><span class="badge gray">@b.LotsCount lots</span></td>
                                <td class="tnum" style="text-align:right;font-weight:700;">Rs @b.TotalSale.ToString("N0")</td>
                                <td class="tnum" style="text-align:right;color:var(--brass-text);">Rs @b.Commission.ToString("N0")</td>
                                <td class="tnum" style="text-align:right;font-weight:700;color:var(--green-text);">Rs @b.NetPayable.ToString("N0")</td>
                                <td style="text-align:center;"><span class="badge @(b.Status == "Paid" ? "green" : (b.Status == "Due" ? "red" : "gray"))">@b.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Hidden Templates for Monthly Report Details -->
    <div id="reportBillDetailsTemplates" style="display:none;">
        @if (recentBills != null && recentBills.Any())
        {
            @foreach (var b in recentBills)
            {
                <div id="reportBillDetailsTemplate_@b.Id">
                    <div class="bill-expand-card">
                        <div class="bill-expand-header">
                            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                <span class="badge brass" style="font-family:monospace;font-size:13px;font-weight:700;">@b.BillNo</span>
                                @if (!string.IsNullOrEmpty(b.VoucherNo))
                                {
                                    <span class="badge" style="background:rgba(47, 158, 140, 0.18);color:var(--teal-text);border:1px solid var(--teal);font-family:monospace;font-size:12px;font-weight:600;">
                                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                        Voucher: @b.VoucherNo
                                    </span>
                                }
                                <span style="font-size:13px;font-weight:600;color:var(--text);">Farmer: <strong style="color:var(--brass-text);">@b.SupplierName</strong></span>
                                <span style="font-size:12px;color:var(--text-dim);">@b.Date</span>
                            </div>
                            <button type="button" class="btn ghost" onclick="printBillById(@b.Id)" style="font-size:12px;padding:4px 10px;">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;"><path d="M6 9V2h12v7M6 18h12v4H6zM6 14h12"/></svg>
                                Print Invoice
                            </button>
                        </div>

                        <table class="bill-expand-table">
                            <thead>
                                <tr>
                                    <th style="width:35px;text-align:center;">#</th>
                                    <th style="width:110px;">LOT #</th>
                                    <th>FISH VARIETY</th>
                                    <th>CUSTOMER (BUYER)</th>
                                    <th style="width:140px;text-align:center;">WEIGHT (MD-KG-P)</th>
                                    <th style="width:110px;text-align:right;">RATE / KG</th>
                                    <th style="width:130px;text-align:right;">AMOUNT (RS)</th>
                                    <th style="width:95px;text-align:center;">REPORT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (b.Lots != null && b.Lots.Any())
                                {
                                    int lIdx = 1;
                                    @foreach (var lot in b.Lots)
                                    {
                                        <tr>
                                            <td style="text-align:center;color:var(--text-faint);">@lIdx</td>
                                            <td><span style="font-family:monospace;font-weight:600;">@lot.LotNo</span></td>
                                            <td><strong>@lot.FishName</strong></td>
                                            <td><span style="color:var(--text-dim);">@(string.IsNullOrWhiteSpace(lot.CustomerName) ? "General Buyer" : lot.CustomerName)</span></td>
                                            <td style="text-align:center;font-family:monospace;font-weight:700;color:var(--brass-text);">@lot.WeightStr</td>
                                            <td class="tnum" style="text-align:right;">Rs @lot.RatePerKg.ToString("N0")</td>
                                            <td class="tnum" style="text-align:right;font-weight:700;">Rs @lot.Amount.ToString("N0")</td>
                                            <td style="text-align:center;">
                                                <button type="button" class="btn ghost icon-only" title="Print / View Lot Item Report (@lot.LotNo)"
                                                        data-billno="@b.BillNo"
                                                        data-date="@b.Date"
                                                        data-supplier="@b.SupplierName?.Replace("\"", "&quot;")"
                                                        data-lotno="@lot.LotNo"
                                                        data-fish="@lot.FishName?.Replace("\"", "&quot;")"
                                                        data-customer="@((string.IsNullOrWhiteSpace(lot.CustomerName) ? "General Buyer" : lot.CustomerName)?.Replace("\"", "&quot;"))"
                                                        data-weightstr="@lot.WeightStr"
                                                        data-weightkg="@lot.WeightKg"
                                                        data-rate="@lot.RatePerKg"
                                                        data-amount="@lot.Amount"
                                                        data-voucher="@(b.VoucherNo ?? "")"
                                                        data-billstatus="@b.Status"
                                                        data-ispaid="@(lot.IsPaid ? "Received" : (lot.ReceivedAmount > 0 ? "Partial" : "Due"))"
                                                        onclick="handlePrintLotReport(this)"
                                                        style="padding:3px 8px;font-size:11px;color:var(--brass-text);border:1px solid rgba(198,138,62,0.3);border-radius:4px;display:inline-flex;align-items:center;gap:4px;background:rgba(198,138,62,0.08);">
                                                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                                    Report
                                                </button>
                                            </td>
                                        </tr>
                                        lIdx++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" style="text-align:center;color:var(--text-dim);padding:14px;">No lots recorded.</td>
                                    </tr>
                                }
                            </tbody>
                            @{
                                var rptCashLots = b.Lots?.Where(l => !string.IsNullOrWhiteSpace(l.CustomerName) && 
                                    l.CustomerName.Trim().IndexOf("CASH", StringComparison.OrdinalIgnoreCase) >= 0).ToList() ?? new List<ERP_Core.Dtos.BillLotItemDto>();
                                var rptCashSaleTotal = rptCashLots.Sum(l => l.Amount);
                                var rptCashLotsCount = rptCashLots.Count;
                            }
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="text-align:right;font-weight:600;">Total Catch Summary:</td>
                                    <td style="text-align:left;">
                                        @if (rptCashSaleTotal > 0)
                                        {
                                            <span class="badge" style="background:rgba(16,185,129,0.15);color:var(--green-text);border:1px solid rgba(16,185,129,0.3);font-size:11px;font-weight:700;padding:3px 8px;">
                                                Cash Sale: Rs @rptCashSaleTotal.ToString("N0") (@rptCashLotsCount lots)
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align:center;font-family:monospace;font-weight:700;color:var(--brass-text);">
                                        @ERP_Core.Dtos.BillLotItemDto.FormatKgToMaund(b.Lots?.Sum(l => l.WeightKg) ?? 0)
                                    </td>
                                    <td style="text-align:right;font-weight:700;">Gross Amount:</td>
                                    <td class="tnum" style="text-align:right;color:var(--brass-text);font-weight:800;font-size:14px;">Rs @b.TotalSale.ToString("N0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- ========================================================================== -->
<!-- 3. AARHAT PAYMENT & RECEIPT MODAL (PAY SUPPLIER / RECEIVE FROM CUSTOMER)   -->
<!-- ========================================================================== -->
<div id="aarhatPaymentModal" class="modal-backdrop" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.78);backdrop-filter:blur(5px);z-index:9999;align-items:center;justify-content:center;padding:16px;">
