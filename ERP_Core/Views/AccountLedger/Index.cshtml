@model ERP_Core.Dtos.AccountLedgerViewModel

@{
    ViewData["Title"] = "Account Ledger";
    ViewData["SubTitle"] = "Khaata aur hisaab kitaab ka tafseeli statement.";
}

@section Styles {
    <!-- TomSelect CSS for Searchable Account Dropdown -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />

    <style>
        .filter-bar-modern {
            background: var(--surface, #132420);
            border: 1px solid var(--border, #2C4740);
            border-radius: var(--radius, 10px);
            padding: 16px 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
        }

        .filter-grid-account {
            display: grid;
            grid-template-columns: 160px 160px minmax(280px, 1fr) auto;
            gap: 14px;
            align-items: flex-end;
        }

        @@media (max-width: 992px) {
            .filter-grid-account {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 576px) {
            .filter-grid-account {
                grid-template-columns: 1fr;
            }
        }

        /* Stat Cards Matching SupplierPayable */
        .stat-grid-account {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 22px;
        }

        @@media (max-width: 992px) {
            .stat-grid-account {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .stat-grid-account {
                grid-template-columns: 1fr;
            }
        }

        .stat-box-modern {
            background: linear-gradient(135deg, var(--surface, #132420) 0%, var(--surface2, #1A2F2A) 100%);
            border: 1px solid var(--border, #2C4740);
            border-radius: var(--radius, 10px);
            padding: 16px 18px;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .stat-box-modern:hover {
            transform: translateY(-2px);
            border-color: var(--brass, #C68A3E);
        }

        .stat-box-modern .stat-lbl {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-dim, #9FB6AF);
            margin-bottom: 6px;
        }

        .stat-box-modern .stat-num {
            font-size: 22px;
            font-weight: 700;
            color: var(--text, #EAF1EE);
            line-height: 1.1;
        }

        .stat-box-modern .stat-sub {
            font-size: 11.5px;
            color: var(--text-faint, #5E7873);
            margin-top: 4px;
        }

        .stat-glow-green .stat-num { color: var(--green-text, #6FE0A0); }
        .stat-glow-red .stat-num { color: var(--red-text, #FF8A7A); }
        .stat-glow-brass .stat-num { color: var(--brass-text, #E3AE66); }

        /* Party Header Banner Matching SupplierPayable */
        .party-banner {
            background: rgba(198, 138, 62, 0.08);
            border: 1px solid rgba(198, 138, 62, 0.35);
            border-radius: var(--radius, 10px);
            padding: 14px 18px;
            margin-bottom: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        /* Outstanding Balance Summary Box at bottom of Report */
        .outstanding-box {
            background: linear-gradient(135deg, rgba(198,138,62,0.12) 0%, rgba(198,138,62,0.04) 100%);
            border: 1px solid rgba(198,138,62,0.45);
            border-radius: 8px;
            padding: 16px 20px;
            margin-top: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
        }

        /* TomSelect Dark Theme overrides */
        .ts-control {
            background-color: var(--surface2, #1A2F2A) !important;
            border: 1px solid var(--border, #2C4740) !important;
            color: var(--text, #EAF1EE) !important;
            border-radius: 8px !important;
            min-height: 38px !important;
            padding: 6px 12px !important;
            font-size: 13px !important;
        }
        .ts-dropdown {
            background-color: var(--surface, #132420) !important;
            border: 1px solid var(--border, #2C4740) !important;
            color: var(--text, #EAF1EE) !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5) !important;
            z-index: 1050 !important;
        }
        .ts-dropdown .option {
            padding: 8px 12px !important;
            color: var(--text, #EAF1EE) !important;
            font-size: 13px !important;
        }
        .ts-dropdown .option:hover, .ts-dropdown .active {
            background-color: rgba(198, 138, 62, 0.25) !important;
            color: var(--brass-text, #E3AE66) !important;
        }
    </style>
}

<!-- Page Toolbar -->
<div class="toolbar" style="margin-bottom:14px;">
    <div>
        <div class="section-title" style="margin-bottom:2px;">Account Ledger Report</div>
        <div class="section-desc" style="margin-bottom:0;">
            Khaata aur general ledger statement bama running balance aur tafseeli indraajaat.
        </div>
    </div>
    @if (Model.IsAccountSelected)
    {
        <div style="display:flex;gap:8px;">
            <button type="button" class="btn brass" onclick="printAccountLedgerReport()" style="display:inline-flex;align-items:center;gap:6px;">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                <span>Print Ledger</span>
            </button>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:var(--green-dim);color:var(--green-text);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid var(--border);">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background:rgba(239,68,68,0.15);color:var(--red-text,#ef4444);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid rgba(239,68,68,0.3);">
        @TempData["ErrorMessage"]
    </div>
}

<!-- ========================================================================= -->
<!-- FILTER BAR (From Date, To Date, Searchable Transable Account Dropdown)   -->
<!-- ========================================================================= -->
<div class="filter-bar-modern no-print">
    <form method="get" asp-controller="AccountLedger" asp-action="Index" id="accLedgerForm">
        <div class="filter-grid-account">
            <!-- Field 1: From Date -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">From Date</label>
                <input type="date" name="fromDate" id="filterFromDate" value="@Model.FromDate" required
                       style="height:38px;padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;" />
            </div>

            <!-- Field 2: To Date -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">To Date</label>
                <input type="date" name="toDate" id="filterToDate" value="@Model.ToDate" required
                       style="height:38px;padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;" />
            </div>

            <!-- Field 3: Transable Account Dropdown -->
            <div class="field" style="margin:0;">
                <label style="font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:4px;display:block;">Select Account (Transable COA)</label>
                <select name="accountId" id="filterAccountSelect" class="searchable-select" required>
                    <option value="">-- Select Transable Account --</option>
                    @foreach (var acc in Model.AccountsList)
                    {
                        <option value="@acc.Id" selected="@(Model.SelectedAccountId == acc.Id)">
                            @acc.DisplayText @(!string.IsNullOrEmpty(acc.NatureName) ? $"({acc.NatureName})" : "")
                        </option>
                    }
                </select>
            </div>

            <!-- Filter Actions -->
            <div style="display:flex;gap:8px;align-items:flex-end;">
                <button type="submit" class="btn brass" style="height:38px;padding:0 20px;font-size:13px;display:inline-flex;align-items:center;gap:6px;">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    Filter Ledger
                </button>
                <a href="/AccountLedger" class="btn ghost" style="height:38px;padding:0 14px;font-size:13px;display:inline-flex;align-items:center;">
                    Reset
                </a>
                @if (Model.IsAccountSelected)
                {
                    <button type="button" class="btn ghost" onclick="printAccountLedgerReport()" style="height:38px;padding:0 14px;font-size:13px;color:var(--brass-text);border-color:rgba(198,138,62,0.4);display:inline-flex;align-items:center;gap:6px;">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                        Print
                    </button>
                }
            </div>
        </div>
    </form>
</div>

<!-- ========================================================================= -->
<!-- MAIN CONTENT AREA                                                         -->
<!-- When NOT selected: Friendly empty state prompt (Do not display table)    -->
<!-- When selected: Banner, Stat cards, Statement Table & Summary Box         -->
<!-- ========================================================================= -->
@if (!Model.IsAccountSelected)
{
    <!-- Initial Empty State Prompt: Table completely hidden until Filter is clicked -->
    <div class="card" style="text-align:center;padding:56px 24px;">
        <div style="width:68px;height:68px;border-radius:50%;background:rgba(198,138,62,0.12);display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;border:1px solid rgba(198,138,62,0.35);">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--brass-text);">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                <line x1="9" y1="7" x2="15" y2="7"/>
                <line x1="9" y1="11" x2="13" y2="11"/>
            </svg>
        </div>
        <h3 style="font-size:17px;font-weight:600;color:var(--text);margin-bottom:8px;">Koi Account Select Nahi Hai</h3>
        <p style="font-size:13.5px;color:var(--text-dim);max-width:480px;margin:0 auto 20px;line-height:1.5;">
            Upar diye gaye dropdown se koi bhi <strong>Transable Account</strong> select karein aur <strong>Filter Ledger</strong> par click karein taake us khaate ka mukammal statement aur running balance zahir ho sake.
        </p>
    </div>
}
else
{
    <!-- Stat Cards Matching SupplierPayable format -->
    <div class="stat-grid-account">
        <div class="stat-box-modern">
            <div class="stat-lbl">Opening Balance</div>
            <div class="stat-num tnum" style="color:var(--text);">Rs @Model.OpeningBalance.ToString("N2")</div>
            <div class="stat-sub">Brought forward before @DateTime.Parse(Model.FromDate).ToString("dd-MMM-yyyy")</div>
        </div>
        <div class="stat-box-modern stat-glow-green">
            <div class="stat-lbl">Total Debit (Dr)</div>
            <div class="stat-num tnum">Rs @Model.TotalDebit.ToString("N2")</div>
            <div class="stat-sub">Selected period total receipts / debits</div>
        </div>
        <div class="stat-box-modern stat-glow-red">
            <div class="stat-lbl">Total Credit (Cr)</div>
            <div class="stat-num tnum">Rs @Model.TotalCredit.ToString("N2")</div>
            <div class="stat-sub">Selected period total payments / credits</div>
        </div>
        <div class="stat-box-modern stat-glow-brass">
            <div class="stat-lbl">Closing Balance</div>
            <div class="stat-num tnum">Rs @Model.ClosingBalance.ToString("N2")</div>
            <div class="stat-sub">Current net balance as of @DateTime.Parse(Model.ToDate).ToString("dd-MMM-yyyy")</div>
        </div>
    </div>

    <!-- Account Details Banner -->
    <div class="party-banner">
        <div>
            <h3 style="font-size:16px;font-weight:700;color:var(--brass-text);margin:0;">
                @Model.SelectedAccountName
            </h3>
            <div style="font-size:12px;color:var(--text-dim);margin-top:3px;">
                COA Code: <span class="tcode" style="font-weight:700;">@Model.SelectedAccountCode</span> &nbsp;|&nbsp;
                Account Nature: <strong style="color:var(--text);">@(string.IsNullOrEmpty(Model.AccountNature) ? "Transable Account" : Model.AccountNature)</strong>
            </div>
        </div>
        <div style="text-align:right;">
            <div style="font-size:11.5px;color:var(--text-dim);">Statement Period:</div>
            <div style="font-size:13px;font-weight:600;color:var(--text);">
                @DateTime.Parse(Model.FromDate).ToString("dd-MMM-yyyy") &mdash; @DateTime.Parse(Model.ToDate).ToString("dd-MMM-yyyy")
            </div>
        </div>
    </div>

    <!-- Detailed Account Ledger Table Card -->
    <div class="card">
        <div class="table-wrap">
            <table class="dynamic-table" id="accountLedgerTable">
                <thead>
                    <tr>
                        <th style="width:110px;">Date</th>
                        <th style="width:120px;">Voucher / Ref #</th>
                        <th style="width:110px;">Voucher Type</th>
                        <th>Description / Particulars</th>
                        <th style="width:100px;">Cheque #</th>
                        <th style="width:130px;text-align:right;">Debit (Dr)</th>
                        <th style="width:130px;text-align:right;">Credit (Cr)</th>
                        <th style="width:140px;text-align:right;">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Opening Balance Line -->
                    <tr style="background:rgba(255,255,255,0.02);font-weight:600;">
                        <td>@DateTime.Parse(Model.FromDate).ToString("dd-MMM-yyyy")</td>
                        <td><span class="badge badge-gray">OPENING</span></td>
                        <td>-</td>
                        <td>Opening Balance Brought Forward</td>
                        <td>-</td>
                        <td style="text-align:right;">-</td>
                        <td style="text-align:right;">-</td>
                        <td class="tnum font-weight-bold" style="text-align:right;color:var(--brass-text);">
                            Rs @Model.OpeningBalance.ToString("N2")
                        </td>
                    </tr>

                    @if (Model.Transactions != null && Model.Transactions.Any())
                    {
                        foreach (var tx in Model.Transactions)
                        {
                            <tr>
                                <td>@tx.DateFormatted</td>
                                <td>
                                    <span class="tcode" style="font-weight:600;color:var(--brass-text);">@tx.RefNo</span>
                                </td>
                                <td>
                                    <span class="badge badge-blue" style="font-size:11px;padding:3px 7px;">@tx.VoucherType</span>
                                </td>
                                <td style="white-space:normal;word-break:break-word;line-height:1.4;">
                                    @tx.Description
                                    @if (!string.IsNullOrWhiteSpace(tx.InvoiceNo))
                                    {
                                        <span style="font-size:11px;color:var(--text-dim);display:block;">(Inv: @tx.InvoiceNo)</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(tx.ChequeNo) ? "-" : tx.ChequeNo)</td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:var(--green-text);">
                                    @(tx.Debit > 0 ? $"Rs {tx.Debit:N2}" : "-")
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:var(--red-text);">
                                    @(tx.Credit > 0 ? $"Rs {tx.Credit:N2}" : "-")
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:@(tx.Balance > 0 ? "var(--green-text)" : (tx.Balance < 0 ? "var(--red-text)" : "var(--text-dim)"));">
                                    Rs @tx.Balance.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align:center;padding:24px;color:var(--text-dim);">
                                Is dauran koi indiraaj nahi mila (No transactions found in selected period).
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:700;background:var(--surface2);border-top:2px solid var(--border);">
                        <th style="color:var(--text);font-weight:700;padding:12px 14px !important;text-align:left;">Totals</th>
                        <th style="padding:12px 14px !important;"></th>
                        <th style="padding:12px 14px !important;"></th>
                        <th style="text-align:right;color:var(--text-dim);padding:12px 14px !important;">Period Totals &amp; Closing Balance:</th>
                        <th style="padding:12px 14px !important;"></th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--green-text);padding:12px 14px !important;">Rs @Model.TotalDebit.ToString("N2")</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--red-text);padding:12px 14px !important;">Rs @Model.TotalCredit.ToString("N2")</th>
                        <th class="tnum font-weight-bold" style="text-align:right;color:var(--brass-text);font-size:13.5px;padding:12px 14px !important;">Rs @Model.ClosingBalance.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Outstanding Balance Summary Box at bottom of Report -->
    <div class="outstanding-box">
        <div>
            <div style="font-size:13px;color:var(--text);font-weight:600;">
                Account Summary: @Model.SelectedAccountName
            </div>
            <div style="font-size:11.5px;color:var(--text-dim);margin-top:2px;">
                Period: @DateTime.Parse(Model.FromDate).ToString("dd-MMM-yyyy") to @DateTime.Parse(Model.ToDate).ToString("dd-MMM-yyyy")
            </div>
        </div>
        <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap;">
            <div>
                <span style="font-size:11px;color:var(--text-dim);text-transform:uppercase;font-weight:600;display:block;">Opening Balance:</span>
                <strong style="color:var(--text);font-size:14px;" class="tnum">Rs @Model.OpeningBalance.ToString("N2")</strong>
            </div>
            <div>
                <span style="font-size:11px;color:var(--text-dim);text-transform:uppercase;font-weight:600;display:block;">Total Debit:</span>
                <strong style="color:var(--green-text);font-size:14px;" class="tnum">Rs @Model.TotalDebit.ToString("N2")</strong>
            </div>
            <div>
                <span style="font-size:11px;color:var(--text-dim);text-transform:uppercase;font-weight:600;display:block;">Total Credit:</span>
                <strong style="color:var(--red-text);font-size:14px;" class="tnum">Rs @Model.TotalCredit.ToString("N2")</strong>
            </div>
            <div style="padding:8px 16px;background:rgba(198,138,62,0.18);border:1px solid var(--brass);border-radius:8px;text-align:right;">
                <span style="font-size:11px;color:var(--brass-text);font-weight:700;text-transform:uppercase;display:block;letter-spacing:0.5px;">Closing Balance:</span>
                <strong style="font-size:18px;color:var(--brass-text);" class="tnum">Rs @Model.ClosingBalance.ToString("N2")</strong>
            </div>
        </div>
    </div>
}

@section Scripts {
    <!-- TomSelect JS for Searchable Account Selection -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Searchable Dropdown for Transable Accounts
            const accountSelectEl = document.getElementById('filterAccountSelect');
            if (accountSelectEl && window.TomSelect) {
                new TomSelect(accountSelectEl, {
                    create: false,
                    maxOptions: 500,
                    placeholder: '-- Select Transable Account --',
                    searchField: ['text'],
                    plugins: ['dropdown_input']
                });
            }
        });

        // Print Account Ledger Report
        function printAccountLedgerReport() {
            const isSelected = @(Model.IsAccountSelected ? "true" : "false");
            if (!isSelected) {
                alert('Pehle koi account select karein aur Filter dabayein.');
                return;
            }

            const fromDate = '@Model.FromDate';
            const toDate = '@Model.ToDate';
            const accountName = '@(Model.SelectedAccountName?.Replace("'", "\\'") ?? "Account")';
            const accountCode = '@(Model.SelectedAccountCode?.Replace("'", "\\'") ?? "")';
            const totalDebit = @Model.TotalDebit;
            const totalCredit = @Model.TotalCredit;
            const closingBal = @Model.ClosingBalance;

            const entries = [];

            // Add Opening Balance line
            entries.push({
                date: fromDate,
                ref: 'OPENING',
                desc: 'Opening Balance Brought Forward',
                debit: 0,
                credit: 0,
                balance: @Model.OpeningBalance
            });

            @if (Model.Transactions != null)
            {
                foreach (var tx in Model.Transactions)
                {
                    <text>
                    entries.push({
                        date: '@tx.DateFormatted',
                        ref: '@(tx.VoucherNo ?? tx.RefNo)',
                        desc: '@(tx.Description.Replace("'", "\\'"))@(string.IsNullOrWhiteSpace(tx.InvoiceNo) ? "" : $" (Inv: {tx.InvoiceNo})")@(string.IsNullOrWhiteSpace(tx.ChequeNo) ? "" : $" [Chq: {tx.ChequeNo}]")',
                        debit: @tx.Debit,
                        credit: @tx.Credit,
                        balance: @tx.Balance
                    });
                    </text>
                }
            }

            const headerTitle = accountCode ? (accountCode + ' - ' + accountName) : accountName;

            if (window.AarhatApp && window.AarhatApp.printLedgerStatement) {
                window.AarhatApp.printLedgerStatement(headerTitle, fromDate, toDate, totalDebit, totalCredit, closingBal, entries);
            } else {
                window.print();
            }
        }
    </script>
}
