<!-- 2. HISTORY VIEW: LIST OF SAVED OPENING BALANCE VOUCHERS                   -->
<!-- ========================================================================= -->
<div id="obHistoryView" style="display:none;">
    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px;">
            <div>
                <h3 style="font-size:16px;font-weight:600;margin:0;color:var(--text);">Fiscal Years Opening Balance Records</h3>
                <div style="font-size:12px;color:var(--text-dim);margin-top:2px;">Each fiscal year has strictly one active opening balance record.</div>
            </div>
            <div style="font-size:12.5px;color:var(--teal-text,#3bba9f);font-weight:500;display:flex;align-items:center;gap:6px;">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                Select any Financial Year above to view or update opening balances.
            </div>
        </div>

        <div class="table-wrap">
            <table class="dynamic-table" id="obHistoryTable">
                <thead>
                    <tr>
                        <th>Voucher #</th>
                        <th>Fiscal Period</th>
                        <th>Financial Year</th>
                        <th style="text-align:center;">Entries</th>
                        <th style="text-align:right;">Total Debit</th>
                        <th style="text-align:right;">Total Credit</th>
                        <th style="text-align:center;">Status</th>
                        <th>Created By</th>
                        <th class="no-sort" style="width:110px;text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentVouchers != null && Model.RecentVouchers.Any())
                    {
                        foreach (var v in Model.RecentVouchers)
                        {
                            <tr>
                                <td>
                                    <span class="tcode" style="font-weight:600;color:var(--brass-text);">@v.OBCode</span>
                                </td>
                                <td>
                                    <span style="font-size:12px;color:var(--text);font-weight:500;">@(string.IsNullOrEmpty(v.FiscalPeriod) ? v.OBDate.ToString("dd-MMM-yyyy") : v.FiscalPeriod)</span>
                                </td>
                                <td>
                                    <span class="badge badge-gray">@(string.IsNullOrEmpty(v.FinancialYearCode) ? "FY #" + v.FinancialYearId : v.FinancialYearCode)</span>
                                </td>
                                <td style="text-align:center;">
                                    <span class="badge badge-brass">@v.TotalEntries lines</span>
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:var(--green-text);">
                                    Rs @v.TotalDebit.ToString("N2")
                                </td>
                                <td class="tnum font-weight-bold" style="text-align:right;color:var(--red-text);">
                                    Rs @v.TotalCredit.ToString("N2")
                                </td>
                                <td style="text-align:center;">
                                    @if (v.IsBalanced)
                                    {
                                        <span class="badge badge-green" style="font-size:11px;">Balanced</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-amber" style="font-size:11px;" title="Diff: Rs @v.Difference.ToString("N2")">Diff: Rs @v.Difference.ToString("N0")</span>
                                    }
                                </td>
                                <td style="font-size:12px;color:var(--text-dim);">
                                    @v.CreatedBy <br />
                                    <small style="color:var(--text-faint);">@v.CreatedOn?.ToString("dd/MM/yy HH:mm")</small>
                                </td>
                                <td style="text-align:center;">
                                    <div class="row-actions" style="justify-content:center;display:flex;gap:6px;">
                                        <button type="button" class="btn-icon" title="View Lines" onclick="viewVoucherDetails(@v.Id)" style="background:transparent;border:none;color:var(--text);cursor:pointer;">
                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </button>
                                        <a href="/OpeningBalance/Index?id=@v.Id&fyId=@v.FinancialYearId" class="btn-icon" title="Edit Voucher" style="color:var(--brass-text);text-decoration:none;display:inline-flex;align-items:center;">
                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </a>
                                        <form asp-controller="OpeningBalance" asp-action="Delete" asp-route-id="@v.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete Opening Balance voucher @v.OBCode?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-icon" title="Delete Voucher" style="background:transparent;border:none;color:var(--red-text);cursor:pointer;">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

