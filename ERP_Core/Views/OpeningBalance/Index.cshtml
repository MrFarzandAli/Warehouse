@section Scripts {
<!-- Ensure TomSelect JS library is loaded for Financial Year -->
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<script>
    let activeFilterMode = 'all'; // 'all' or 'active'

    /**
     * Initializes a TomSelect instance on any standard <select> element
     */
    function initTomSelect(el, placeholderText) {
        if (!el) return null;

        if (el.tomselect) {
            el.tomselect.destroy();
        }

        if (typeof TomSelect === 'undefined') {
            setTimeout(() => initTomSelect(el, placeholderText), 80);
            return null;
        }

        const placeholder = placeholderText || el.getAttribute('data-placeholder') || '-- Select --';

        const ts = new TomSelect(el, {
            placeholder: placeholder,
            allowEmptyOption: true,
            create: false,
            maxItems: 1,
            plugins: ['dropdown_input'],
            dropdownParent: 'body',
            searchField: ['text'],
            onInitialize: function () {
                if (this.wrapper) {
                    this.wrapper.classList.add('form-select-dark');
                }
            }
        });

        return ts;
    }

    // Called whenever an amount input value changes
    function onAmountInputChanged(input) {
        const val = parseFloat(input.value) || 0;
        const row = input.closest('tr');
        if (row) {
            if (val > 0) {
                row.setAttribute('data-has-amount', 'true');
                row.classList.add('has-amount');
            } else {
                row.setAttribute('data-has-amount', 'false');
                row.classList.remove('has-amount');
            }
        }
        recalcTotals();
        applyVisibility();
    }

    // Remove an account row from the opening balance voucher
    function removeAccountRow(btn, event) {
        if (event) {
            event.stopPropagation();
            event.preventDefault();
        }
        const row = btn.closest('tr');
        if (!row) return;

        // Reset amount value so totals don't calculate it
        const input = row.querySelector('.ob-amount-input');
        if (input) {
            input.value = '';
        }
        row.setAttribute('data-has-amount', 'false');
        row.classList.remove('has-amount');

        // Smooth collapse animation
        row.style.transition = 'opacity 0.15s ease, transform 0.15s ease';
        row.style.opacity = '0';
        row.style.transform = 'scale(0.97)';

        setTimeout(() => {
            row.setAttribute('data-removed', 'true');
            row.style.display = 'none';
            row.style.opacity = '1';
            row.style.transform = 'none';

            updateRowNumbers();
            recalcTotals();
            updateTabCounts();
            applyVisibility();
        }, 150);
    }

    // Keep clearSingleRowAmount as alias for backward compatibility
    function clearSingleRowAmount(btn, event) {
        removeAccountRow(btn, event);
    }

    // Restore all removed accounts back into the table
    function restoreAllRemovedAccounts() {
        const removedRows = document.querySelectorAll('#obEntriesBody .ob-row[data-removed="true"]');
        removedRows.forEach(r => {
            r.setAttribute('data-removed', 'false');
        });
        updateRowNumbers();
        recalcTotals();
        updateTabCounts();
        applyVisibility();
    }

    // Update row numbers 1, 2, 3... for all non-removed rows
    function updateRowNumbers() {
        const activeRows = document.querySelectorAll('#obEntriesBody .ob-row:not([data-removed="true"])');
        activeRows.forEach((r, idx) => {
            const idxCell = r.querySelector('.row-index');
            if (idxCell) {
                idxCell.textContent = (idx + 1);
            }
        });
    }

    // Update tab badges and restore button
    function updateTabCounts() {
        const activeRows = document.querySelectorAll('#obEntriesBody .ob-row:not([data-removed="true"])').length;
        const btnAll = document.getElementById('btnFilterAll');
        if (btnAll) {
            btnAll.textContent = `All (${activeRows})`;
        }

        const removedCount = document.querySelectorAll('#obEntriesBody .ob-row[data-removed="true"]').length;
        const btnRestore = document.getElementById('btnRestoreAccounts');
        const removedCountSpan = document.getElementById('removedCount');
        if (btnRestore && removedCountSpan) {
            if (removedCount > 0) {
                removedCountSpan.textContent = removedCount;
                btnRestore.style.display = 'inline-flex';
            } else {
                btnRestore.style.display = 'none';
            }
        }
    }

    // Clear all entered amounts
    function clearAllAmounts() {
        if (!confirm('Are you sure you want to clear all entered amounts?')) return;
        document.querySelectorAll('#obEntriesBody .ob-row:not([data-removed="true"]) .ob-amount-input').forEach(input => {
            input.value = '';
        });
        document.querySelectorAll('#obEntriesBody .ob-row:not([data-removed="true"])').forEach(row => {
            row.setAttribute('data-has-amount', 'false');
            row.classList.remove('has-amount');
        });
        recalcTotals();
        applyVisibility();
    }

    // Filter toggle (all vs active with amounts)
    function setAccountFilter(mode) {
        activeFilterMode = mode;
        const btnAll = document.getElementById('btnFilterAll');
        const btnActive = document.getElementById('btnFilterActive');
        if (btnAll && btnActive) {
            if (mode === 'all') {
                btnAll.classList.add('active');
                btnActive.classList.remove('active');
            } else {
                btnAll.classList.remove('active');
                btnActive.classList.add('active');
            }
        }
        applyVisibility();
    }

    // Filter accounts by search input text
    function filterAccounts(searchVal) {
        applyVisibility();
    }

    // Apply combined filter (text search + active amount filter + removed check)
    function applyVisibility() {
        const searchInput = document.getElementById('accountSearchInput');
        const query = (searchInput?.value || '').trim().toLowerCase();
        const rows = document.querySelectorAll('#obEntriesBody .ob-row');

        rows.forEach(r => {
            const isRemoved = r.getAttribute('data-removed') === 'true';
            if (isRemoved) {
                r.style.display = 'none';
                return;
            }

            const name = r.getAttribute('data-account-name') || '';
            const code = r.getAttribute('data-account-code') || '';
            const hasAmount = r.getAttribute('data-has-amount') === 'true';

            const matchesText = !query || name.includes(query) || code.includes(query);
            const matchesFilter = activeFilterMode === 'all' || (activeFilterMode === 'active' && hasAmount);

            if (matchesText && matchesFilter) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    // Tran Type Color & styling toggle
    function onTranTypeChange(selectEl) {
        if (!selectEl) return;
        if (selectEl.value === 'CRE') {
            selectEl.style.color = 'var(--red-text, #E57373)';
        } else {
            selectEl.style.color = 'var(--green-text, #4EBF9E)';
        }
    }

    // Recalculate Debit, Credit, and Balance Totals
    function recalcTotals() {
        let debTotal = 0;
        let creTotal = 0;
        let activeCount = 0;

        const rows = document.querySelectorAll('#obEntriesBody .ob-row:not([data-removed="true"])');
        rows.forEach(r => {
            const val = parseFloat(r.querySelector('.ob-amount-input')?.value) || 0;
            if (val > 0) {
                activeCount++;
                const tranType = r.querySelector('.tran-type-select')?.value || 'DEB';
                if (tranType === 'DEB') {
                    debTotal += val;
                } else {
                    creTotal += val;
                }
            }
        });

        const diff = Math.abs(debTotal - creTotal);
        const isBalanced = diff < 0.01;

        // Update Footers
        const footDebit = document.getElementById('footDebitSum');
        const footCredit = document.getElementById('footCreditSum');
        if (footDebit) footDebit.innerText = 'Rs ' + debTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (footCredit) footCredit.innerText = 'Rs ' + creTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        // Update Status Badge
        const statusBadge = document.getElementById('balanceStatusBadge');
        if (statusBadge) {
            if (activeCount === 0) {
                statusBadge.className = 'badge badge-gray';
                statusBadge.innerText = 'No amounts entered';
            } else if (isBalanced) {
                statusBadge.className = 'badge badge-green';
                statusBadge.innerText = '✓ Balanced: Rs ' + debTotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
            } else {
                statusBadge.className = 'badge badge-amber';
                statusBadge.innerText = '⚠️ Difference: Rs ' + diff.toLocaleString('en-US', { minimumFractionDigits: 2 }) + ' (Unbalanced)';
            }
        }

        // Update Quick Preview in Submit Bar
        const prevDeb = document.getElementById('previewDeb');
        const prevCre = document.getElementById('previewCre');
        const prevDiff = document.getElementById('previewDiff');
        if (prevDeb) prevDeb.innerText = 'Rs ' + debTotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
        if (prevCre) prevCre.innerText = 'Rs ' + creTotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
        if (prevDiff) {
            prevDiff.innerText = 'Rs ' + diff.toLocaleString('en-US', { minimumFractionDigits: 2 });
            prevDiff.style.color = isBalanced && activeCount > 0 ? 'var(--green-text)' : (diff > 0.01 ? 'var(--red-text)' : 'var(--brass-text)');
        }

        // Update Active Entries Badge
        const activeBadge = document.getElementById('activeEntriesBadge');
        if (activeBadge) {
            activeBadge.innerText = `${activeCount} Active with Balance`;
        }

        // Update Save button tooltip
        const saveBtn = document.getElementById('btnSaveOb');
        if (saveBtn) {
            if (activeCount > 0 && !isBalanced) {
                saveBtn.title = 'Cannot save: Debit and Credit are not equal';
            } else {
                saveBtn.title = 'Save Opening Balance';
            }
        }
    }

    // Custom Luxury Alert Modal Handler
    function showBalanceAlert(options) {
        const modal = document.getElementById('balanceAlertModal');
        if (!modal) return;

        const iconWrap = document.getElementById('alertIconWrap');
        const titleEl = document.getElementById('alertModalTitle');
        const subTitleEl = document.getElementById('alertModalSubtitle');
        const statsGrid = document.getElementById('alertStatsGrid');
        const debitValEl = document.getElementById('alertDebitVal');
        const creditValEl = document.getElementById('alertCreditVal');
        const diffValEl = document.getElementById('alertDiffVal');
        const tipTextEl = document.getElementById('alertTipText');

        if (titleEl) titleEl.innerText = options.title || 'Credit Must Be Equal to Debit';
        if (subTitleEl) subTitleEl.innerText = options.subtitle || 'Your opening balance entries are currently unbalanced.';

        if (options.isComparison && options.debTotal !== undefined) {
            if (iconWrap) {
                iconWrap.className = 'alert-icon-wrap alert-warning';
            }
            if (statsGrid) statsGrid.style.display = 'grid';
            if (debitValEl) debitValEl.innerText = 'Rs ' + options.debTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (creditValEl) creditValEl.innerText = 'Rs ' + options.creTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (diffValEl) diffValEl.innerText = 'Rs ' + options.diff.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (tipTextEl) tipTextEl.innerText = options.tip || 'Please adjust account values or enter offsetting credit/debit entries to balance this voucher.';
        } else {
            if (iconWrap) {
                iconWrap.className = 'alert-icon-wrap alert-info';
            }
            if (statsGrid) statsGrid.style.display = 'none';
            if (tipTextEl) tipTextEl.innerText = options.tip || 'Please review your entries before proceeding.';
        }

        modal.style.display = 'flex';
    }

    function closeBalanceAlert() {
        const modal = document.getElementById('balanceAlertModal');
        if (modal) modal.style.display = 'none';
        reenableAllRows();
    }

    function handleAlertBackdropClick(event) {
        if (event.target && event.target.id === 'balanceAlertModal') {
            closeBalanceAlert();
        }
    }

    // Form Validation before submit: MUST check Credit == Debit using luxury modal
    function validateObForm() {
        const fySelect = document.getElementById('fySelect');
        if (!fySelect || !fySelect.value) {
            showBalanceAlert({
                title: 'Financial Year Required',
                subtitle: 'Please select a Financial Year before saving this Opening Balance voucher.',
                tip: 'Select the current fiscal year from the "Financial Year" dropdown.',
                isComparison: false
            });
            if (fySelect?.tomselect) fySelect.tomselect.focus();
            else fySelect?.focus();
            return false;
        }

        let debTotal = 0;
        let creTotal = 0;
        let activeCount = 0;

        const rows = document.querySelectorAll('#obEntriesBody .ob-row:not([data-removed="true"])');
        rows.forEach(r => {
            const amt = parseFloat(r.querySelector('.ob-amount-input')?.value) || 0;
            if (amt > 0) {
                activeCount++;
                const tranType = r.querySelector('.tran-type-select')?.value || 'DEB';
                if (tranType === 'CRE') {
                    creTotal += amt;
                } else {
                    debTotal += amt;
                }
            }
        });

        if (activeCount === 0) {
            showBalanceAlert({
                title: 'No Amounts Entered',
                subtitle: 'Please enter an opening balance amount for at least one account before submitting.',
                tip: 'Type opening balance amounts into the "Opening Balance Value" column for your eligible accounts.',
                isComparison: false
            });
            return false;
        }

        const diff = Math.abs(debTotal - creTotal);
        if (diff > 0.01) {
            showBalanceAlert({
                title: 'Credit Must Be Equal to Debit',
                subtitle: 'Your opening balance entries are currently unbalanced. In double-entry bookkeeping, Total Debit and Total Credit must be identical before saving.',
                debTotal: debTotal,
                creTotal: creTotal,
                diff: diff,
                tip: 'Please balance your entries by adjusting amounts or adding matching credit/debit rows.',
                isComparison: true
            });
            return false;
        }

        // Optimize POST payload: Disable empty & removed rows so only rows with entered amounts are submitted
        // Re-index sequentially to avoid index gaps in ASP.NET Core model binding
        let activeSeq = 0;
        document.querySelectorAll('#obEntriesBody .ob-row').forEach(r => {
            const isRemoved = r.getAttribute('data-removed') === 'true';
            const amt = parseFloat(r.querySelector('.ob-amount-input')?.value) || 0;
            if (!isRemoved && amt > 0) {
                r.querySelectorAll('input, select').forEach(el => {
                    el.disabled = false;
                    if (el.name && el.name.includes('Details[')) {
                        el.name = el.name.replace(/Details\[\d+\]/, `Details[${activeSeq}]`);
                    }
                });
                activeSeq++;
            } else {
                r.querySelectorAll('input, select').forEach(el => {
                    el.disabled = true;
                });
            }
        });

        return true;
    }

    function reenableAllRows() {
        document.querySelectorAll('#obEntriesBody .ob-row input, #obEntriesBody .ob-row select').forEach(el => {
            el.disabled = false;
        });
    }

    // Switch between Entry and History subtabs
    function switchObTab(tab) {
        const entryView = document.getElementById('obEntryView');
        const historyView = document.getElementById('obHistoryView');
        const tabEntryBtn = document.getElementById('tabEntryBtn');
        const tabHistoryBtn = document.getElementById('tabHistoryBtn');

        if (tab === 'history') {
            if (entryView) entryView.style.display = 'none';
            if (historyView) historyView.style.display = 'block';
            if (tabEntryBtn) tabEntryBtn.classList.remove('active');
            if (tabHistoryBtn) tabHistoryBtn.classList.add('active');

            // Initialize or recalculate DataTables columns for the dynamic table
            if (window.ERPDataTables) {
                window.ERPDataTables.init('#obHistoryTable');
            }
            if (window.jQuery && window.jQuery.fn && window.jQuery.fn.DataTable && window.jQuery.fn.DataTable.isDataTable('#obHistoryTable')) {
                setTimeout(function () {
                    window.jQuery('#obHistoryTable').DataTable().columns.adjust();
                }, 50);
            }
        } else {
            if (entryView) entryView.style.display = 'block';
            if (historyView) historyView.style.display = 'none';
            if (tabEntryBtn) tabEntryBtn.classList.add('active');
            if (tabHistoryBtn) tabHistoryBtn.classList.remove('active');
        }
    }

    // View Details Modal via AJAX
    async function viewVoucherDetails(id) {
        const modal = document.getElementById('voucherModal');
        const body = document.getElementById('modalEntriesBody');
        if (!modal || !body) return;

        body.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;">Loading details...</td></tr>';
        modal.style.display = 'flex';

        try {
            const res = await fetch(`/OpeningBalance/GetVoucherDetails/${id}`);
            const data = await res.json();
            if (!data.success) {
                body.innerHTML = `<tr><td colspan="4" style="text-align:center;color:var(--red-text);">${data.message}</td></tr>`;
                return;
            }

            document.getElementById('modalVoucherCode').innerText = `Voucher: ${data.obCode}`;
            document.getElementById('modalVoucherMeta').innerText = `FY: ${data.financialYear} | Fiscal Period: ${data.fiscalPeriod || data.obDate} | Created By: ${data.createdBy || 'User'}`;

            let html = '';
            data.details.forEach(d => {
                const color = d.tranType === 'CRE' ? 'var(--red-text)' : 'var(--green-text)';
                html += `
                    <tr>
                        <td><span class="tcode">${d.accountCode || '-'}</span></td>
                        <td>${d.accountName}</td>
                        <td style="text-align:center;"><span class="badge" style="color:${color};border:1px solid currentColor;">${d.tranType}</span></td>
                        <td class="tnum" style="text-align:right;font-weight:600;color:${color};">Rs ${d.amount.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                    </tr>
                `;
            });

            body.innerHTML = html;
            document.getElementById('modalTotTypes').innerText = `Deb: Rs ${data.totalDebit.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            document.getElementById('modalTotAmt').innerText = `Cre: Rs ${data.totalCredit.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        } catch (e) {
            body.innerHTML = `<tr><td colspan="4" style="text-align:center;color:var(--red-text);">Failed to load voucher details: ${e.message}</td></tr>`;
        }
    }

    function closeVoucherModal() {
        const modal = document.getElementById('voucherModal');
        if (modal) modal.style.display = 'none';
    }

    // Keyboard navigation (Esc to close modals)
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeBalanceAlert();
            closeVoucherModal();
        }
    });

    // Initialize UI on DOM ready
    document.addEventListener('DOMContentLoaded', function () {
        // Suppress any DataTables alert popups
        if (window.jQuery && window.jQuery.fn && window.jQuery.fn.dataTable) {
            window.jQuery.fn.dataTable.ext.errMode = 'none';
        }

        // 1. Initialize Financial Year Searchable Select & reload on change to display saved entries
        const fyEl = document.getElementById('fySelect');
        const currentFyId = '@Model.FinancialYearId';
        if (fyEl) {
            fyEl.addEventListener('change', function () {
                const val = this.value;
                if (val && val !== currentFyId) {
                    window.location.href = '@Url.Action("Index", "OpeningBalance")?fyId=' + encodeURIComponent(val);
                }
            });
            const fyTs = initTomSelect(fyEl, '-- Select Financial Year --');
            if (fyTs) {
                fyTs.on('change', function (val) {
                    if (val && val !== currentFyId) {
                        window.location.href = '@Url.Action("Index", "OpeningBalance")?fyId=' + encodeURIComponent(val);
                    }
                });
            }
        }

        // 2. Initialize Tran Type colors
        document.querySelectorAll('#obEntriesBody .tran-type-select').forEach(el => {
            onTranTypeChange(el);
        });

        // 3. Initial totals calculation & safety row re-enable
        reenableAllRows();
        recalcTotals();
    });
</script>
}
