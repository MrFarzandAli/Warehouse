@using System.Security.Claims
@using ERP_Core.Data
@using ERP_Core.Dtos
@using ERP_Core.DataAccessLayer
@inject ERPDbContext _context
@inject ModulesDAL _modulesDal

@{
    var userName = User.Identity?.IsAuthenticated == true ? (User.FindFirst(ClaimTypes.Name)?.Value ?? User.Identity.Name) : "Farzand";
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Owner";
    var isOwner = userRole.Equals("Owner", StringComparison.OrdinalIgnoreCase) || userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
    var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "F";
    var currentPath = Context.Request.Path.Value?.Trim('/') ?? "";
    var currentTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var currentSubTitle = ViewData["SubTitle"]?.ToString() ?? "Overview of Godown &amp; Warehouse Operations";

    var empIdClaim = User.FindFirst("EmpId")?.Value ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(empIdClaim, out int empId);
    var identityId = User.FindFirst("IdentityId")?.Value;

    // 🚀 Execute Stored Procedure sp_GetSidebarLinks via ModulesDAL
    List<SidebarLinkDto> dbSidebarLinks = new();
    if (_modulesDal != null && (empId > 0 || !string.IsNullOrEmpty(identityId)))
    {
        dbSidebarLinks = await _modulesDal.GetSidebarLinksByEmpIdAsync(empId, identityId);
    }

    string FormatTargetUrl(string? url, string name)
    {
        if (string.IsNullOrWhiteSpace(url) || url == "#" || url == "/")
        {
            if (name.Contains("Dashboard", StringComparison.OrdinalIgnoreCase) || name.Contains("Home", StringComparison.OrdinalIgnoreCase))
            {
                return Url.Action("Index", "Home") ?? "/";
            }
            return "javascript:void(0)";
        }
        return url.StartsWith("/") ? url : "/" + url;
    }

    bool CheckLinkActive(string path, string? url, string name)
    {
        if (string.IsNullOrEmpty(path) || path.Equals("Home", StringComparison.OrdinalIgnoreCase) || path.Equals("Home/Index", StringComparison.OrdinalIgnoreCase))
        {
            if (name.Contains("Dashboard", StringComparison.OrdinalIgnoreCase)) return true;
        }

        if (string.IsNullOrWhiteSpace(url) || url == "#" || url == "/") return false;

        var cleanUrl = url.Trim('/').ToLowerInvariant();
        var cleanPath = path.Trim('/').ToLowerInvariant();

        return cleanPath.Equals(cleanUrl, StringComparison.OrdinalIgnoreCase)
            || cleanPath.StartsWith(cleanUrl + "/", StringComparison.OrdinalIgnoreCase);
    }

    string GetModuleIcon(string moduleName)
    {
        var n = (moduleName ?? "").Trim().ToLowerInvariant();
        if (n.Contains("dashboard") || n.Contains("home"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><rect x=""3"" y=""3"" width=""7"" height=""9"" rx=""1.5""/><rect x=""14"" y=""3"" width=""7"" height=""5"" rx=""1.5""/><rect x=""14"" y=""12"" width=""7"" height=""9"" rx=""1.5""/><rect x=""3"" y=""16"" width=""7"" height=""5"" rx=""1.5""/></svg>";
        if (n.Contains("company master") || n.Contains("company setup") || n.Contains("company"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M3 21h18""/><path d=""M5 21V7l7-4 7 4v14""/><path d=""M9 21v-6h6v6""/></svg>";
        if (n.Contains("rights") || n.Contains("access") || n.Contains("role") || n.Contains("permission"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2""/><circle cx=""9"" cy=""7"" r=""4""/><path d=""m17 11 2 2 4-4""/></svg>";
        if (n.Contains("register") || n.Contains("employee") || n.Contains("user"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2""/><circle cx=""9"" cy=""7"" r=""4""/><line x1=""19"" y1=""8"" x2=""19"" y2=""14""/><line x1=""16"" y1=""11"" x2=""22"" y2=""11""/></svg>";
        if (n.Contains("sales report") || n.Contains("sales") || n.Contains("bikri"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M3 3v18h18""/><path d=""m19 9-5 5-4-4-3 3""/><circle cx=""19"" cy=""9"" r=""2""/></svg>";
        if (n.Contains("customer receivable"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7""/></svg>";
        if (n.Contains("customer"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2""/><circle cx=""9"" cy=""7"" r=""4""/><path d=""M23 21v-2a4 4 0 0 0-3-3.87""/><path d=""M16 3.13a4 4 0 0 1 0 7.75""/></svg>";
        if (n.Contains("distribution") || n.Contains("transfer"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5""/></svg>";
        if (n.Contains("supplier payable"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7""/></svg>";
        if (n.Contains("supplier"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><rect x=""1"" y=""3"" width=""15"" height=""13"" rx=""1.5""/><path d=""M16 8h4l3 3v5h-7V8Z""/><circle cx=""5.5"" cy=""18.5"" r=""2.5""/><circle cx=""18.5"" cy=""18.5"" r=""2.5""/></svg>";
        if (n.Contains("inward") || n.Contains("stock in") || n.Contains("lot"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z""/><polyline points=""12 12 12 8""/><line x1=""12"" y1=""12"" x2=""12"" y2=""22""/><path d=""m9 15 3 3 3-3""/></svg>";
        if (n.Contains("outward") || n.Contains("gate pass"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z""/><polyline points=""12 12 12 16""/><path d=""m9 13 3-3 3 3""/></svg>";
        if (n.Contains("lifter") || n.Contains("forklift"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><rect x=""2"" y=""7"" width=""10"" height=""9"" rx=""1""/><circle cx=""5"" cy=""18"" r=""2""/><circle cx=""15"" cy=""18"" r=""2""/><path d=""M12 16h6V3M18 10h4""/></svg>";
        if (n.Contains("rent") || n.Contains("billing"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z""/><polyline points=""14 2 14 8 20 8""/><line x1=""16"" y1=""13"" x2=""8"" y2=""13""/><line x1=""16"" y1=""17"" x2=""8"" y2=""17""/><polyline points=""10 9 9 9 8 9""/></svg>";
        if (n.Contains("stock report") || n.Contains("stock position"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M3 3v18h18""/><rect x=""7"" y=""10"" width=""4"" height=""8"" rx=""1""/><rect x=""13"" y=""6"" width=""4"" height=""12"" rx=""1""/></svg>";
        if (n.Contains("category") || n.Contains("product"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z""/><polyline points=""3.27 6.96 12 12.01 20.73 6.96""/><line x1=""12"" y1=""22.08"" x2=""12"" y2=""12""/></svg>";
        if (n.Contains("fish"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z""/><polyline points=""3.27 6.96 12 12.01 20.73 6.96""/><line x1=""12"" y1=""22.08"" x2=""12"" y2=""12""/></svg>";
        if (n.Contains("purchase"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M1 3h4l2.4 12.4a2 2 0 0 0 2 1.6h9.2a2 2 0 0 0 2-1.6L22 7H6""/><circle cx=""9.5"" cy=""21"" r=""1.4""/><circle cx=""18"" cy=""21"" r=""1.4""/></svg>";
        if (n.Contains("bill"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M6 2h9l5 5v15H6z""/><path d=""M15 2v5h5""/><path d=""M9 13h6M9 17h6M9 9h2""/></svg>";
        if (n.Contains("receipt voucher") || n.Contains("receipt"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7""/><path d=""M16 8l4 4-4 4""/></svg>";
        if (n.Contains("payment voucher") || n.Contains("payment"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><rect x=""2"" y=""5"" width=""20"" height=""14"" rx=""2""/><line x1=""2"" y1=""10"" x2=""22"" y2=""10""/><path d=""M6 15h4""/></svg>";
        if (n.Contains("voucher") || n.Contains("expense"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><rect x=""2"" y=""5"" width=""20"" height=""14"" rx=""2""/><path d=""M2 10h20""/><path d=""M6 15h4""/></svg>";
        if (n.Contains("receivable"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7""/></svg>";
        if (n.Contains("ledger"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M4 19.5A2.5 2.5 0 0 1 6.5 17H20""/><path d=""M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z""/></svg>";
        if (n.Contains("account setup") || n.Contains("accountsetup"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z""/><circle cx=""12"" cy=""12"" r=""3""/></svg>";
        if (n.Contains("chart") || n.Contains("accounts"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M3 3v18h18""/><rect x=""7"" y=""12"" width=""3"" height=""6"" rx="".5""/><rect x=""12"" y=""8"" width=""3"" height=""10"" rx="".5""/><rect x=""17"" y=""5"" width=""3"" height=""13"" rx="".5""/></svg>";
        if (n.Contains("profit") || n.Contains("loss"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M3 3v18h18""/><path d=""m19 9-5 5-4-4-4 4""/></svg>";
        if (n.Contains("opening balance") || n.Contains("openingbalance"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7""/><rect x=""2"" y=""6"" width=""20"" height=""12"" rx=""2""/></svg>";
        if (n.Contains("balance"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><rect x=""3"" y=""3"" width=""18"" height=""18"" rx=""2""/><path d=""M12 3v18M3 9h18M3 15h18""/></svg>";
        if (n.Contains("nature"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2""/><rect x=""8"" y=""2"" width=""8"" height=""4"" rx=""1"" ry=""1""/><path d=""M9 14h6M9 18h6M9 10h6""/></svg>";
        if (n.Contains("setting"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><circle cx=""12"" cy=""12"" r=""3""/><path d=""M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 15 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z""/></svg>";
        if (n.Contains("profile"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><circle cx=""12"" cy=""8"" r=""4""/><path d=""M6 21v-2a6 6 0 0 1 12 0v2""/></svg>";
        if (n.Contains("bank") || n.Contains("cash"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""M3 21h18""/><path d=""M3 10h18""/><path d=""m12 3 9 7H3z""/><path d=""M5 10v11""/><path d=""M9 10v11""/><path d=""M15 10v11""/><path d=""M19 10v11""/></svg>";
        if (n.Contains("ice") || n.Contains("labour"))
            return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><path d=""m10 15 5 5 3-3-5-5""/><path d=""M4 20h7""/><path d=""m15 4-4 4 2 2 4-4a2 2 0 0 0-2.83-2.83Z""/></svg>";
        return @"<svg viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2""><circle cx=""12"" cy=""12"" r=""3""/><rect x=""3"" y=""3"" width=""18"" height=""18"" rx=""2""/></svg>";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@currentTitle — West Wharf Warehouse</title>

    <!-- Base Tag -->
    <base href="~/" />

    <!-- Google Fonts: Fraunces & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Aarhat Theme CSS -->
    <link rel="stylesheet" href="~/css/aarhat-theme.css" asp-append-version="true" />

    <!-- DataTables & Dynamic Component Styles -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/dynamicTable.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
    @Html.AntiForgeryToken()
</head>

<body>

    <div class="aarhat-shell">

        <!-- Mobile Drawer Overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="AarhatApp.toggleSidebar()"></div>

        <!-- ================================================================== -->
        <!-- SIDEBAR NAVIGATION                                                 -->
        <!-- ================================================================== -->
        <aside class="sidebar" id="sidebarEl">

            <!-- Brand Logo & Header -->
            <div class="sidebar-brand">
                <span class="warehouse-mark" style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;background:rgba(198,138,62,0.12);border:1px solid rgba(198,138,62,0.3);border-radius:9px;padding:4px;flex-shrink:0;">
                    <svg viewBox="0 0 48 48" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24 4L6 14L24 24L42 14L24 4Z" fill="rgba(198,138,62,0.25)" stroke="var(--brass)" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M6 14V36L24 46V24L6 14Z" fill="rgba(47,158,140,0.2)" stroke="var(--teal)" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M42 14V36L24 46V24L42 14Z" fill="rgba(198,138,62,0.1)" stroke="var(--brass)" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M15 29L24 34L33 29" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M15 20L24 25L33 20" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <div class="brand-name" style="font-size:13.5px;line-height:1.2;font-weight:700;letter-spacing:0.3px;">
                    WEST WHARF <span style="color:var(--brass-text);display:block;font-size:10.5px;letter-spacing:1.2px;font-weight:600;">WAREHOUSE</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="sidebar-nav" id="sidebarNav">

                @if (dbSidebarLinks != null && dbSidebarLinks.Any())
                {
                    var parentSections = dbSidebarLinks.Where(m => m.isParentModule == 1 || m.ParentModuleId == 0).OrderBy(m => m.Order).ToList();
                    var childLinks = dbSidebarLinks.Where(m => m.isSubModule == 1 || m.ParentModuleId > 0).OrderBy(m => m.Order).ToList();

                    @if (parentSections.Any())
                    {
                        @foreach (var parent in parentSections)
                        {
                            var subModules = childLinks.Where(c => parent.Id.HasValue && c.ParentModuleId == parent.Id.Value).OrderBy(c => c.Order).ToList();

                            if (subModules.Any())
                            {
                                <div class="nav-section">@parent.Name</div>
                                @foreach (var child in subModules)
                                {
                                    var targetUrl = FormatTargetUrl(child.Url, child.Name);
                                    var isItemActive = CheckLinkActive(currentPath, child.Url, child.Name);

                                    <a href="@targetUrl" class="nav-item @(isItemActive ? "active" : "")">
                                        @Html.Raw(GetModuleIcon(child.Name))
                                        <span>@child.Name</span>
                                        @if (child.Name.Contains("Task", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="sidebar-badge" style="margin-left:auto; background:var(--surface3); color:var(--teal-text); font-size:11px; padding:2px 7px; border-radius:10px;">1</span>
                                        }
                                        else if (child.Name.Contains("Ticket", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="sidebar-badge" style="margin-left:auto; background:var(--surface3); color:var(--teal-text); font-size:11px; padding:2px 7px; border-radius:10px;">2</span>
                                        }
                                    </a>
                                }
                            }
                            else if (!string.IsNullOrEmpty(parent.Url) && parent.Url != "#")
                            {
                                var targetUrl = FormatTargetUrl(parent.Url, parent.Name);
                                var isItemActive = CheckLinkActive(currentPath, parent.Url, parent.Name);

                                <a href="@targetUrl" class="nav-item @(isItemActive ? "active" : "")">
                                    @Html.Raw(GetModuleIcon(parent.Name))
                                    <span>@parent.Name</span>
                                </a>
                            }
                        }
                    }
                    else
                    {
                        <!-- Direct list if all returned items are flat -->
                        <div class="nav-section">Navigation</div>
                        @foreach (var link in dbSidebarLinks.OrderBy(m => m.Order))
                        {
                            var targetUrl = FormatTargetUrl(link.Url, link.Name);
                            var isItemActive = CheckLinkActive(currentPath, link.Url, link.Name);

                            <a href="@targetUrl" class="nav-item @(isItemActive ? "active" : "")">
                                @Html.Raw(GetModuleIcon(link.Name))
                                <span>@link.Name</span>
                            </a>
                        }
                    }
                }
                else
                {
                    <!-- Fallback if database returns no modules -->
                    <div class="nav-section">Overview</div>
                    <a asp-controller="Home" asp-action="Index" class="nav-item @(string.IsNullOrEmpty(currentPath) || currentPath.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                        <span>Dashboard</span>
                    </a>
                }

                <!-- Always Present: Account -->
                <div class="nav-section">Account</div>
                <a asp-controller="Profile" asp-action="Index" class="nav-item @(currentPath.Equals("Profile", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("Profile/", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    @Html.Raw(GetModuleIcon("Profile"))
                    <span>My Profile</span>
                </a>
                <form asp-controller="Login" asp-action="Logout" method="post" id="sidebarLogoutForm" class="d-inline m-0 p-0">
                    @Html.AntiForgeryToken()
                    <a href="javascript:void(0)" onclick="document.getElementById('sidebarLogoutForm').submit();" class="nav-item" style="color:var(--red-text);">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        <span>Sign Out</span>
                    </a>
                </form>

            </div>

            <!-- Branch Footnote -->
            <div class="sidebar-foot">
                v2.4 · Ibrahim Hyderi Branch
            </div>
        </aside>

        <!-- ================================================================== -->
        <!-- MAIN CONTENT AREA & TOPBAR                                         -->
        <!-- ================================================================== -->
        <div class="main-wrapper">

            <!-- Topbar Navigation -->
            <header class="topbar">
                <div style="display:flex;align-items:center;gap:14px;">
                    <button type="button" class="icon-btn" id="hamburgerBtn" onclick="AarhatApp.toggleSidebar()" style="display:none;" title="Toggle Sidebar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
                    </button>
                    <h1>
                        @currentTitle
                        <span class="topbar-sub">@currentSubTitle</span>
                    </h1>
                </div>

                <div class="topbar-right">
                    <div class="icon-btn" title="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></div>
                    <div class="icon-btn" title="Notifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
                    <span class="role-pill">@(isOwner ? "Owner panel" : "Staff panel")</span>
                    
                    <form asp-controller="Login" asp-action="Logout" method="post" id="logoutForm" class="d-inline m-0 p-0">
                        @Html.AntiForgeryToken()
                        <div class="user-chip" onclick="document.getElementById('logoutForm').submit();" title="Click to Sign Out">
                            <div class="avatar-circle">@userInitial</div>
                            <div class="who">
                                <b>@userName</b>
                                <span>@(isOwner ? "Owner (Sign Out)" : "Staff (Sign Out)")</span>
                            </div>
                        </div>
                    </form>
                </div>
            </header>

            <!-- Main Page Content Area -->
            <main class="content-area" role="main">
                @RenderBody()
            </main>

            <!-- Application Footer -->
            <footer style="padding: 14px 28px; border-top: 1px solid var(--border-soft); display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--text-dim); background: var(--surface);">
                <div>
                    &copy; @DateTime.Now.Year <b style="color:var(--text);">West Wharf Warehouse</b>. All rights reserved.
                </div>
                <div>
                    Developed By <b style="color:var(--brass-text);">Awais Qureshi</b>
                </div>
            </footer>
        </div>
    </div>

    <!-- Universal Document Print Preview Modal -->
    <partial name="_PrintModal" />

    <!-- Core Script Dependencies -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Dynamic Components Engine -->
    <script src="~/js/dynamicTable.js" asp-append-version="true"></script>
    <script src="~/js/dynamicSearchableDropdown.js" asp-append-version="true"></script>

    <!-- Application Script -->
    <script src="~/js/aarhat-app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
