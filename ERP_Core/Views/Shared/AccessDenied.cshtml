@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
    ViewData["BreadcrumbPrefix"] = "SECURITY";
    ViewData["BreadcrumbCurrent"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 p-5 mx-auto" style="max-width: 540px; border-radius: 16px; background: #ffffff; border: 1px solid #EAEFF4 !important;">
        <div class="mb-4">
            <div class="brand-icon-box mx-auto mb-3" style="background-color: var(--red); color: #ffffff; width: 50px; height: 50px; border-radius: 12px; font-size: 1.2rem;">
                <i class="fa fa-lock"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">Access Restricted</h4>
            <p class="text-muted small mb-0">You do not have permission to access this module or form.</p>
        </div>

        <div class="alert alert-warning bg-opacity-10 border-warning border-opacity-25 text-dark small text-start mb-4 py-2 px-3" style="border-radius: 8px;">
            <i class="fa fa-circle-exclamation text-warning me-2"></i>
            If you need access to this page, please contact your System Administrator or HR.
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-teal px-4 py-2 fw-semibold" style="border-radius: 8px; font-size: 0.85rem;">
                <i class="fa fa-house me-1"></i> Go to Dashboard
            </a>
            <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary px-4 py-2 fw-semibold" style="border-radius: 8px; font-size: 0.85rem;">
                    Sign Out
                </button>
            </form>
        </div>
    </div>
</div>
