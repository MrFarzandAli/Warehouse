@model ERP_Core.Dtos.AccountSetupViewModel
@{
    ViewData["Title"] = "Account Setup";
    ViewData["SubTitle"] = "Configure default chart of accounts posting heads for customers, suppliers, taxes, and bank charges.";
    ViewData["ActivePage"] = "AccountSetup";
}

<style>
    /* ==========================================================================
       Account Setup — Custom Component Styling (Coastal Luxury Dark Theme)
       ========================================================================== */
    .setup-header-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border-soft);
    }

    .setup-company-select-wrap {
        display: flex;
        flex-direction: column;
        min-width: 320px;
        max-width: 480px;
        flex: 1;
    }

    .setup-company-select-wrap label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .setup-actions-group {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .setup-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: 22px;
        overflow: visible !important;
        position: relative;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
        transition: border-color 0.2s ease;
    }

    .setup-card:nth-of-type(1) { z-index: 35; }
    .setup-card:nth-of-type(2) { z-index: 25; }
    .setup-card:nth-of-type(3) { z-index: 15; }

    .setup-card:focus-within {
        border-color: rgba(198, 138, 62, 0.7);
        z-index: 100 !important;
    }

    .setup-card-body,
    .setup-field-row,
    .setup-field-block,
    .setup-input-with-checkbox,
    .select-grow {
        overflow: visible !important;
        position: relative;
    }

    /* TomSelect Custom Dropdown Dark Theme & High Stacking */
    .ts-wrapper.form-select-dark .ts-dropdown,
    .ts-dropdown {
        position: absolute !important;
        top: 100% !important;
        left: 0 !important;
        width: 100% !important;
        z-index: 99999 !important;
        background-color: var(--surface) !important;
        border: 1px solid var(--brass) !important;
        border-radius: 8px !important;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.9) !important;
        color: var(--text) !important;
        max-height: 260px !important;
        overflow-y: auto !important;
        display: block;
        margin-top: 4px !important;
    }

    .ts-dropdown .ts-dropdown-content {
        max-height: 250px !important;
        overflow-y: auto !important;
    }

    .ts-dropdown .option {
        padding: 10px 14px !important;
        color: var(--text) !important;
        font-size: 13px !important;
        cursor: pointer !important;
        border-bottom: 1px solid var(--border-soft) !important;
    }

    .ts-dropdown .option:hover,
    .ts-dropdown .option.active {
        background-color: var(--surface3) !important;
        color: var(--brass-text) !important;
    }

    .ts-dropdown .option.selected {
        background-color: var(--teal-dim) !important;
        color: var(--teal-text) !important;
        font-weight: 600 !important;
    }

    .setup-card-ribbon {
        background: var(--surface2);
        color: var(--brass-text);
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.04em;
        padding: 12px 20px;
        border-bottom: 1px solid var(--border);
        border-top-left-radius: var(--radius);
        border-top-right-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .setup-card-ribbon .ribbon-title {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .setup-card-ribbon .ribbon-icon {
        width: 22px;
        height: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--brass-dim);
        border-radius: 6px;
        color: var(--brass);
    }

    .setup-card-body {
        padding: 22px;
    }

    .setup-field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 991px) {
        .setup-field-row {
            grid-template-columns: 1fr;
            gap: 18px;
        }
    }

    .setup-field-block {
        display: flex;
        flex-direction: column;
    }

    .setup-field-block > label {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-dim);
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Action Buttons Custom Highlights */
    .btn-action-back {
        background: var(--surface2);
        color: var(--text);
        border: 1px solid var(--border);
    }

    .btn-action-back:hover {
        border-color: var(--brass);
        color: var(--brass-text);
    }

    .btn-action-clear {
        background: transparent;
        color: var(--red-text);
        border: 1px solid rgba(217, 88, 75, 0.4);
    }

    .btn-action-clear:hover {
        background: var(--red-dim);
        border-color: var(--red);
        color: #FFFFFF;
    }

    .btn-action-save {
        background: var(--brass);
        color: #241A09;
        font-weight: 700;
        box-shadow: 0 4px 14px rgba(198, 138, 62, 0.28);
    }

    .btn-action-save:hover {
        background: #D99C50;
        color: #140E04;
    }

    /* Overview Section */
    .overview-table-wrap {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        margin-top: 28px;
    }

    .table-tag {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        background: var(--surface2);
        border: 1px solid var(--border);
        color: var(--text-dim);
    }

    .table-tag.parent-yes {
        background: var(--teal-dim);
        border-color: var(--teal);
        color: var(--teal-text);
    }
</style>

<div class="account-setup-container">

    <!-- ========================================================================= -->
    <!-- FLASH ALERTS                                                              -->
    <!-- ========================================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:var(--green-dim);color:var(--green-text);padding:12px 18px;border-radius:8px;font-size:13.5px;margin-bottom:20px;border:1px solid var(--border);display:flex;align-items:center;gap:12px;box-shadow:0 4px 14px rgba(0,0,0,0.2);">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
            <span style="font-weight:500;">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background:var(--red-dim);color:var(--red-text);padding:12px 18px;border-radius:8px;font-size:13.5px;margin-bottom:20px;border:1px solid var(--border);display:flex;align-items:center;gap:12px;box-shadow:0 4px 14px rgba(0,0,0,0.2);">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span style="font-weight:500;">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- MAIN FORM                                                                 -->
    <!-- ========================================================================= -->
    <form asp-controller="AccountSetup" asp-action="Save" method="post" id="accountSetupForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="AccountSetupId" id="formAccountSetupId" value="@Model.Form.AccountSetupId" />

        <!-- ===================================================================== -->
        <!-- TOP HEADER BAR: COMPANY SELECTOR & ACTIONS (Back, Save, Clear)        -->
        <!-- ===================================================================== -->
        <div class="setup-header-bar">
            <!-- Company Selector -->
            <div class="setup-company-select-wrap">
                <label for="formCompanyId">
                    <span>Company:</span>
                    <span style="color:var(--red-text);">*</span>
                </label>
                <select name="CompanyId" id="formCompanyId" class="searchable-select" required onchange="onCompanySelectionChange(this.value)">
                    <option value="">-- None (Select Company) --</option>
                    @foreach (var comp in Model.AvailableCompanies)
                    {
                        var isSelected = (Model.SelectedCompanyId == comp.CompanyId) || (Model.Form.CompanyId == comp.CompanyId);
                        <option value="@comp.CompanyId" selected="@(isSelected ? "selected" : null)">
                            @comp.CompanyName @(string.IsNullOrEmpty(comp.Code) ? "" : $"({comp.Code})")
                        </option>
                    }
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="setup-actions-group">
                <!-- Back Button -->
                <a asp-controller="ChartOfAccounts" asp-action="Index" class="btn btn-action-back" title="Back to Chart of Accounts">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                    <span>Back</span>
                </a>

                <!-- Save Button -->
                <button type="submit" class="btn btn-action-save" id="btnSaveSetup" title="Save Account Setup">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    <span>Save</span>
                </button>

                <!-- Clear Button -->
                <button type="button" class="btn btn-action-clear" id="btnClearSetup" onclick="handleClearForm()" title="Clear Form Selections">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    <span>Clear</span>
                </button>
            </div>
        </div>

        <!-- ===================================================================== -->
        <!-- CARD 1: Customer and Supplier Chart of Accounts                      -->
        <!-- ===================================================================== -->
        <div class="setup-card setup-card-1">
            <div class="setup-card-ribbon">
                <div class="ribbon-title">
                    <span class="ribbon-icon">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                    <span>Customer and Supplier Chart of Accounts :</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span class="badge" style="background:var(--teal-dim);color:var(--teal-text);font-size:11px;padding:3px 8px;border-radius:6px;">@Model.AvailableAccounts.Count COA Accounts</span>
                    <span style="font-size:11px;color:var(--text-faint);font-weight:500;">Payable &amp; Receivable Postings</span>
                </div>
            </div>

            <div class="setup-card-body">
                <div class="setup-field-row">
                    <!-- Supplier Account -->
                    <div class="setup-field-block">
                        <label for="formSupplierAccID">
                            <span>Supplier Account:</span>
                            <span style="color:var(--red-text);">*</span>
                        </label>
                        <select name="SupplierAccID" id="formSupplierAccID" class="searchable-select" data-placeholder="Select Supplier Account...">
                            <option value="">None</option>
                            @foreach (var acc in Model.AvailableAccounts)
                            {
                                var isSelected = Model.Form.SupplierAccID == acc.Id;
                                <option value="@acc.Id" selected="@(isSelected ? "selected" : null)">
                                    @acc.DisplayText
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Customer Account -->
                    <div class="setup-field-block">
                        <label for="formCustomerAccID">
                            <span>Customer Account:</span>
                            <span style="color:var(--red-text);">*</span>
                        </label>
                        <select name="CustomerAccID" id="formCustomerAccID" class="searchable-select" data-placeholder="Select Customer Account...">
                            <option value="">None</option>
                            @foreach (var acc in Model.AvailableAccounts)
                            {
                                var isSelected = Model.Form.CustomerAccID == acc.Id;
                                <option value="@acc.Id" selected="@(isSelected ? "selected" : null)">
                                    @acc.DisplayText
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================================================================== -->
        <!-- CARD 2: Discount Tax Master Chart of Accounts                        -->
        <!-- ===================================================================== -->
        <div class="setup-card setup-card-2">
            <div class="setup-card-ribbon">
                <div class="ribbon-title">
                    <span class="ribbon-icon">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7"/></svg>
                    </span>
                    <span>Discount Tax Master Chart of Accounts :</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span class="badge" style="background:var(--teal-dim);color:var(--teal-text);font-size:11px;padding:3px 8px;border-radius:6px;">@Model.AvailableAccounts.Count COA Accounts</span>
                    <span style="font-size:11px;color:var(--text-faint);font-weight:500;">VAT Input &amp; Output Accounts</span>
                </div>
            </div>

            <div class="setup-card-body">
                <div class="setup-field-row">
                    <!-- Vat Input Account -->
                    <div class="setup-field-block">
                        <label for="formVatInputAccID">
                            <span>Vat Input Account :</span>
                            <span style="color:var(--red-text);">*</span>
                        </label>
                        <select name="VatInputAccID" id="formVatInputAccID" class="searchable-select" data-placeholder="Select Vat Input Account...">
                            <option value="">None</option>
                            @foreach (var acc in Model.AvailableAccounts)
                            {
                                var isSelected = Model.Form.VatInputAccID == acc.Id;
                                <option value="@acc.Id" selected="@(isSelected ? "selected" : null)">
                                    @acc.DisplayText
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Vat Output Account -->
                    <div class="setup-field-block">
                        <label for="formVatOutputAccID">
                            <span>Vat Output Account :</span>
                            <span style="color:var(--red-text);">*</span>
                        </label>
                        <select name="VatOutputAccID" id="formVatOutputAccID" class="searchable-select" data-placeholder="Select Vat Output Account...">
                            <option value="">None</option>
                            @foreach (var acc in Model.AvailableAccounts)
                            {
                                var isSelected = Model.Form.VatOutputAccID == acc.Id;
                                <option value="@acc.Id" selected="@(isSelected ? "selected" : null)">
                                    @acc.DisplayText
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================================================================== -->
        <!-- CARD 3: Bank Charges Chart of Accounts                               -->
        <!-- ===================================================================== -->
        <div class="setup-card setup-card-3">
            <div class="setup-card-ribbon">
                <div class="ribbon-title">
                    <span class="ribbon-icon">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M4 10h16L12 3z"/></svg>
                    </span>
                    <span>Bank Charges Chart of Accounts :</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span class="badge" style="background:var(--teal-dim);color:var(--teal-text);font-size:11px;padding:3px 8px;border-radius:6px;">@Model.AvailableAccounts.Count COA Accounts</span>
                    <span style="font-size:11px;color:var(--text-faint);font-weight:500;">Banking Fee &amp; Transaction Deductions</span>
                </div>
            </div>

            <div class="setup-card-body">
                <div class="setup-field-row">
                    <!-- Bank Charges Account -->
                    <div class="setup-field-block">
                        <label for="formBankChargesId">
                            <span>Bank Charges Account :</span>
                            <span style="color:var(--red-text);">*</span>
                        </label>
                        <select name="BankChargesId" id="formBankChargesId" class="searchable-select" data-placeholder="Select Bank Charges Account...">
                            <option value="">None</option>
                            @foreach (var acc in Model.AvailableAccounts)
                            {
                                var isSelected = Model.Form.BankChargesId == acc.Id;
                                <option value="@acc.Id" selected="@(isSelected ? "selected" : null)">
                                    @acc.DisplayText
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Informational Helper Box -->
                    <div style="display:flex;align-items:center;background:var(--surface2);border:1px dashed var(--border);padding:14px 18px;border-radius:8px;gap:12px;">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--brass)" stroke-width="2" style="flex:none;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        <span style="font-size:12px;color:var(--text-dim);line-height:1.5;">
                            These configurations establish automatic ledger posting defaults across voucher entries, sales billing, fish purchases, supplier settlements, and banking reconciliations.
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </form>

    <!-- Hidden Form for Resetting / Clearing via POST -->
    <form asp-controller="AccountSetup" asp-action="Clear" method="post" id="accountSetupClearForm" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="companyId" id="clearCompanyId" value="@Model.SelectedCompanyId" />
    </form>

    <!-- ========================================================================= -->
    <!-- CONFIGURATION OVERVIEW SUMMARY                                            -->
    <!-- ========================================================================= -->
    @if (Model.ConfiguredSetups != null && Model.ConfiguredSetups.Any())
    {
        <div class="overview-table-wrap">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <div>
                    <h4 style="font-family:var(--font-head);font-size:16px;color:var(--brass-text);margin:0;">Configured Companies Overview</h4>
                    <p style="font-size:12px;color:var(--text-dim);margin:2px 0 0 0;">Summary of active posting head profiles configured across companies.</p>
                </div>
                <span class="badge" style="background:var(--brass-dim);color:var(--brass-text);font-weight:600;padding:5px 10px;border-radius:6px;">
                    @Model.ConfiguredSetups.Count Profile@(Model.ConfiguredSetups.Count > 1 ? "s" : "")
                </span>
            </div>

            <div class="table-wrap">
                <table class="dynamic-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Supplier Account</th>
                            <th>Customer Account</th>
                            <th>VAT Input Account</th>
                            <th>VAT Output Account</th>
                            <th>Bank Charges Account</th>
                            <th class="no-sort" style="width:70px;text-align:center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.ConfiguredSetups)
                        {
                            <tr style="@(s.CompanyId == Model.SelectedCompanyId ? "background:rgba(47,158,140,0.08);" : "")">
                                <td>
                                    <strong style="color:var(--text);">@s.CompanyName</strong>
                                    @if (s.CompanyId == Model.SelectedCompanyId)
                                    {
                                        <span class="badge" style="background:var(--teal-dim);color:var(--teal-text);font-size:10.5px;margin-left:6px;">Active</span>
                                    }
                                </td>
                                <td>@s.SupplierAccountName</td>
                                <td>@s.CustomerAccountName</td>
                                <td>@s.VatInputAccountName</td>
                                <td>@s.VatOutputAccountName</td>
                                <td>@s.BankChargesAccountName</td>
                                <td style="text-align:center;">
                                    <button type="button" class="btn ghost" onclick="loadCompanySetup(@s.CompanyId)" style="padding:4px 8px;font-size:12px;" title="Load into Form">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        // =========================================================================
        // Client-Side Interactivity & Live State Sync
        // =========================================================================

        /**
         * Helper to set value of a select element, whether standard or TomSelect
         */
        function setSelectValue(selectId, value) {
            const select = document.getElementById(selectId);
            if (!select) return;

            const valStr = value ? String(value) : '';
            if (select.tomselect) {
                select.tomselect.setValue(valStr, true);
            } else {
                select.value = valStr;
                select.dispatchEvent(new Event('change'));
            }
        }

        /**
         * Handler when company dropdown selection changes:
         * Fetches existing setup for the company via AJAX and updates form fields immediately.
         */
        async function onCompanySelectionChange(companyId) {
            if (!companyId) {
                resetAllInputs();
                return;
            }

            const clearCompId = document.getElementById('clearCompanyId');
            if (clearCompId) clearCompId.value = companyId;

            try {
                const response = await fetch(`@Url.Action("GetByCompany", "AccountSetup")/${companyId}`);
                if (!response.ok) return;

                const res = await response.json();
                if (res.success && res.data) {
                    populateForm(res.data);
                }
            } catch (err) {
                console.error('[AccountSetup] Failed to load company setup:', err);
            }
        }

        /**
         * Quickly loads a company setup from the summary overview table
         */
        function loadCompanySetup(companyId) {
            if (!companyId) return;
            setSelectValue('formCompanyId', companyId);
            onCompanySelectionChange(companyId);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /**
         * Populates form inputs with an AccountSetup data object
         */
        function populateForm(data) {
            document.getElementById('formAccountSetupId').value = data.accountSetupId || 0;

            setSelectValue('formSupplierAccID', data.supplierAccID || '');
            setSelectValue('formCustomerAccID', data.customerAccID || '');
            setSelectValue('formVatInputAccID', data.vatInputAccID || '');
            setSelectValue('formVatOutputAccID', data.vatOutputAccID || '');
            setSelectValue('formBankChargesId', data.bankChargesId || '');
        }

        /**
         * Clears all fields in the form
         */
        function resetAllInputs() {
            document.getElementById('formAccountSetupId').value = '0';
            setSelectValue('formSupplierAccID', '');
            setSelectValue('formCustomerAccID', '');
            setSelectValue('formVatInputAccID', '');
            setSelectValue('formVatOutputAccID', '');
            setSelectValue('formBankChargesId', '');
        }

        /**
         * Clear button action handler
         */
        function handleClearForm() {
            const companySelect = document.getElementById('formCompanyId');
            const companyId = companySelect ? companySelect.value : null;

            if (confirm('Are you sure you want to clear this account setup configuration?')) {
                if (companyId && document.getElementById('formAccountSetupId').value > 0) {
                    document.getElementById('accountSetupClearForm').submit();
                } else {
                    resetAllInputs();
                }
            }
        }

        // Ensure TomSelect instances refresh and display options on click
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                document.querySelectorAll('.account-setup-container select.searchable-select').forEach(function (selectEl) {
                    if (selectEl.tomselect) {
                        selectEl.tomselect.settings.openOnFocus = true;
                        selectEl.tomselect.refreshOptions(false);
                    }
                });
            }, 300);
        });
    </script>
}
