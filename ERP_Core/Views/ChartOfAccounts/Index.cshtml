@model ERP_Core.Dtos.ChartOfAccountsViewModel

@{
    ViewData["Title"] = "Chart of Accounts";
    ViewData["SubTitle"] = "Manage account hierarchy, nature of accounts, and financial posting heads.";
}

@section Styles {
    <!-- TomSelect CSS for Searchable Dropdowns -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />

    <style>
        /* TomSelect Luxury Dark Theme Overrides */
        .ts-wrapper {
            width: 100% !important;
        }

        .ts-wrapper .ts-control {
            background-color: var(--surface2, #1A2F2A) !important;
            border: 1px solid var(--border, #2C4740) !important;
            color: var(--text, #EAF1EE) !important;
            border-radius: 8px !important;
            font-size: 13px !important;
            min-height: 40px !important;
            padding: 8px 12px !important;
            display: flex !important;
            align-items: center !important;
            transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
        }

        .ts-wrapper.focus .ts-control {
            border-color: var(--brass, #C68A3E) !important;
            box-shadow: 0 0 0 2px rgba(198, 138, 62, 0.25) !important;
        }

        .ts-wrapper .ts-control input {
            color: var(--text, #EAF1EE) !important;
            font-size: 13px !important;
        }

        .ts-wrapper .ts-control .item {
            color: var(--text, #EAF1EE) !important;
            font-size: 13px !important;
        }

        /* TomSelect Dropdown Menu */
        .ts-dropdown {
            background-color: #0E1A17 !important;
            border: 1px solid rgba(198, 138, 62, 0.4) !important;
            border-radius: 8px !important;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.85) !important;
            color: #EAF1EE !important;
            z-index: 999999 !important;
            font-family: var(--font-body, 'Inter', sans-serif) !important;
            overflow: hidden !important;
        }

        .ts-dropdown .dropdown-input-wrap {
            padding: 8px !important;
            background: #142420 !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        }

        .ts-dropdown .dropdown-input {
            background: #0C1917 !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            color: #EAEFF4 !important;
            border-radius: 6px !important;
            padding: 7px 10px !important;
            font-size: 13px !important;
        }

        .ts-dropdown .dropdown-input:focus {
            border-color: #C68A3E !important;
            outline: none !important;
            box-shadow: 0 0 0 2px rgba(198, 138, 62, 0.2) !important;
        }

        .ts-dropdown .option {
            color: #EAF1EE !important;
            padding: 9px 14px !important;
            font-size: 13px !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
            cursor: pointer !important;
        }

        .ts-dropdown .option.active, .ts-dropdown .option:hover {
            background-color: #1B302B !important;
            color: #E3AE66 !important;
        }

        .ts-dropdown .option.selected {
            background-color: #2F6F5E !important;
            color: #FFFFFF !important;
            font-weight: 600 !important;
        }
    </style>
}

<!-- Summary Statistics KPI Cards -->
<div class="stat-grid" style="margin-bottom:20px;">
    <div class="stat-card">
        <div class="lbl">TOTAL ACCOUNTS</div>
        <div class="val tnum">@Model.TotalAccounts</div>
        <div class="sub">Total heads in chart of accounts</div>
    </div>
    <div class="stat-card">
        <div class="lbl">TRANSABLE HEADS</div>
        <div class="val tnum" style="color:var(--green-text);">@Model.TransableAccounts</div>
        <div class="sub">Postable transaction accounts</div>
    </div>
    <div class="stat-card">
        <div class="lbl">GROUP HEADS</div>
        <div class="val tnum" style="color:var(--brass-text);">@Model.GroupAccounts</div>
        <div class="sub">Parent / Heading categories</div>
    </div>
    <div class="stat-card">
        <div class="lbl">ACTIVE ACCOUNTS</div>
        <div class="val tnum" style="color:var(--teal-text);">@Model.ActiveAccounts</div>
        <div class="sub">Enabled for current fiscal year</div>
    </div>
</div>

<!-- Alert Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div style="background:var(--green-dim);color:var(--green-text);padding:12px 16px;border-radius:8px;font-size:13px;margin-bottom:18px;border:1px solid var(--border);display:flex;align-items:center;gap:10px;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background:var(--red-dim);color:var(--red-text);padding:12px 16px;border-radius:8px;font-size:13px;margin-bottom:18px;border:1px solid var(--border);display:flex;align-items:center;gap:10px;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Toolbar: Search, Filters & Action Button -->
<div class="toolbar" style="margin-bottom:18px;">
    <div style="display:flex;gap:12px;align-items:center;flex:1;max-width:850px;flex-wrap:wrap;">
        <div class="search" style="flex:1;min-width:220px;">
            <svg viewBox="0 0 24 24" width="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="coaSearchInput" placeholder="Search by account code or name..." onkeyup="filterCoaTable()" />
        </div>

        <select id="natureFilter" class="form-select" onchange="filterCoaTable()" style="width:190px;background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:8px;font-size:13px;outline:none;">
            <option value="">All Nature of Accounts</option>
            @foreach (var nature in Model.AvailableNatureOfAccounts)
            {
                <option value="@nature.Id">@nature.DisplayName</option>
            }
        </select>

        <select id="typeFilter" class="form-select" onchange="filterCoaTable()" style="width:160px;background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:8px;font-size:13px;outline:none;">
            <option value="">All Account Types</option>
            <option value="transable">Transable (Posting)</option>
            <option value="group">Group / Heading</option>
            <option value="active">Active Only</option>
            <option value="inactive">Inactive Only</option>
        </select>

        <!-- View Switcher -->
        <div class="btn-group" style="display:flex;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--surface2);">
            <button type="button" class="btn ghost" id="btnViewTable" onclick="switchCoaView('table')" style="padding:6px 12px;font-size:12.5px;background:transparent;color:var(--text);font-weight:normal;">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                Table View
            </button>
            <button type="button" class="btn ghost" id="btnViewTree" onclick="switchCoaView('tree')" style="padding:6px 12px;font-size:12.5px;background:var(--brass);color:#0A1614;font-weight:600;">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                Tree View
            </button>
        </div>
    </div>

    <div style="display:flex;gap:8px;">
        <a asp-controller="AccountSetup" asp-action="Index" class="btn" style="background:var(--surface2);border:1px solid var(--border);" title="Default Posting Heads Configuration">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Account Setup</span>
        </a>
        <button type="button" class="btn brass" id="btnToggleCoaForm" onclick="toggleCoaForm()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            <span id="btnAddBtnText">Add Account</span>
        </button>
    </div>
</div>

<!-- ========================================================================= -->
<!-- ADD / EDIT CHART OF ACCOUNT COLLAPSIBLE FORM CARD                        -->
<!-- ========================================================================= -->
<div class="form-card" id="coaFormCard" style="display:none;margin-bottom:24px;border:1px solid var(--brass);background:var(--surface);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:36px;height:36px;border-radius:8px;background:rgba(212,163,89,0.15);display:flex;align-items:center;justify-content:center;color:var(--brass);">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6" rx=".5"/><rect x="12" y="8" width="3" height="10" rx=".5"/><rect x="17" y="5" width="3" height="13" rx=".5"/></svg>
            </div>
            <div>
                <h3 id="formTitle" style="font-size:16px;font-weight:600;margin:0;color:var(--brass-text);">Add New Chart of Account</h3>
                <p id="formSubTitle" style="font-size:12px;color:var(--text-dim);margin:2px 0 0 0;">Create a financial posting head or group category in the chart of accounts.</p>
            </div>
        </div>
        <button type="button" class="btn ghost" onclick="resetCoaForm()" style="padding:6px 12px;font-size:12.5px;">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            Cancel / Close
        </button>
    </div>

    <form id="coaForm" asp-controller="ChartOfAccounts" asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" id="formId" value="0" />

        <div class="form-grid c2" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <!-- Account Code (Auto-generated & Locked) -->
            <div class="field">
                <label style="font-size:13px;font-weight:500;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;">
                    <span>Account Code</span>
                    <span style="font-size:11px;color:var(--text-dim);font-weight:normal;">(Auto-generated & locked)</span>
                </label>
                <div style="display:flex;gap:8px;">
                    <input type="text" name="AccountCode" id="formAccountCode" readonly placeholder="Auto-generated code" style="flex:1;background:rgba(255,255,255,0.04);color:var(--brass-text,#d4a359);font-weight:600;font-family:monospace;border:1px solid var(--border);border-radius:8px;padding:8px 12px;cursor:not-allowed;" />
                    <button type="button" class="btn ghost" title="Generate Next Code" onclick="generateNextCode()" style="padding:8px 12px;">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                    </button>
                </div>
            </div>

            <!-- Parent Account -->
            <div class="field">
                <label style="font-size:13px;font-weight:500;margin-bottom:6px;display:block;">Parent Account</label>
                <select name="ParentAccountId" id="formParentAccountId" onchange="onParentAccountChanged()">
                    <option value="">(None - Top Level Group)</option>
                    @foreach (var parent in Model.AvailableParentAccounts)
                    {
                        <option value="@parent.Id">@parent.DisplayName</option>
                    }
                </select>
            </div>

            <!-- Account Name -->
            <div class="field">
                <label style="font-size:13px;font-weight:500;margin-bottom:6px;display:block;">Account Name <span style="color:var(--red-text);">*</span></label>
                <input type="text" name="AccountName" id="formAccountName" placeholder="e.g. Cash in Hand, HBL Bank Account, Fish Sales" required />
            </div>

            <!-- Nature of Account -->
            <div class="field">
                <label style="font-size:13px;font-weight:500;margin-bottom:6px;display:block;">Nature of Account <span style="color:var(--red-text);">*</span></label>
                <select name="NatureOfAccountId" id="formNatureOfAccountId">
                    <option value="">(Select Nature of Account)</option>
                    @foreach (var nature in Model.AvailableNatureOfAccounts)
                    {
                        <option value="@nature.Id">@nature.DisplayName</option>
                    }
                </select>
            </div>

            <!-- Currency -->
            <div class="field">
                <label style="font-size:13px;font-weight:500;margin-bottom:6px;display:block;">Currency <span style="color:var(--red-text);">*</span></label>
                <select name="Currency" id="formCurrency">
                    <option value="PKR">PKR - Pakistani Rupee</option>
                    <option value="AED">AED - UAE Dirham</option>
                    <option value="USD">USD - US Dollar</option>
                    <option value="EUR">EUR - Euro</option>
                    <option value="GBP">GBP - British Pound</option>
                    <option value="SAR">SAR - Saudi Riyal</option>
                </select>
            </div>

            <!-- Toggles / Checkboxes -->
            <div class="field" style="display:flex;align-items:center;gap:24px;padding-top:20px;">
                <label style="display:flex;align-items:center;gap:8px;margin-bottom:0;cursor:pointer;font-size:13px;font-weight:500;">
                    <input type="hidden" name="Transable" value="false" />
                    <input type="checkbox" name="Transable" id="formTransable" value="true" checked style="width:18px;height:18px;accent-color:var(--brass);cursor:pointer;" />
                    <span>Transable (Posting Head)</span>
                </label>

                <label style="display:flex;align-items:center;gap:8px;margin-bottom:0;cursor:pointer;font-size:13px;font-weight:500;">
                    <input type="hidden" name="Active" value="false" />
                    <input type="checkbox" name="Active" id="formActive" value="true" checked style="width:18px;height:18px;accent-color:var(--green-text);cursor:pointer;" />
                    <span>Active Status</span>
                </label>
            </div>
        </div>

        <div class="form-actions" style="margin-top:20px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--border);padding-top:14px;">
            <button type="button" class="btn ghost" onclick="resetCoaForm()">Reset</button>
            <button type="submit" class="btn brass" id="btnSubmitCoa">
                <svg viewBox="0 0 24 24" width="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                <span id="btnSubmitText">Save Account</span>
            </button>
        </div>
    </form>
</div>

<!-- ========================================================================= -->
<!-- VIEW 1: DATA TABLE VIEW                                                   -->
<!-- ========================================================================= -->
<div class="card" id="coaTableViewCard" style="display:none;">
    <div class="card-head" style="padding:16px 20px;border-bottom:1px solid var(--border-soft);display:flex;justify-content:space-between;align-items:center;">
        <div>
            <h3 style="font-size:15px;margin:0;">Chart of Accounts Directory (@Model.Accounts.Count)</h3>
            <span style="font-size:12px;color:var(--text-dim);">Database table [ChartOfAccounts] linked with [NatureofAccount]</span>
        </div>
        <span class="badge badge-brass" style="font-size:11px;">Table: [ChartOfAccounts]</span>
    </div>

    <div class="table-wrap">
        <table id="coaTable">
            <thead>
                <tr>
                    <th style="width:110px;">Code</th>
                    <th>Account Name</th>
                    <th>Parent Account</th>
                    <th>Nature of Account</th>
                    <th>Currency</th>
                    <th>Head Type</th>
                    <th>Status</th>
                    <th style="text-align:right;width:150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Accounts != null && Model.Accounts.Any())
                {
                    @foreach (var acc in Model.Accounts)
                    {
                        var isActive = acc.Active == true || acc.Active == null;
                        var isTransable = acc.Transable;

                        <tr id="row-coa-@acc.Id"
                            data-id="@acc.Id"
                            data-code="@acc.AccountCode"
                            data-name="@acc.AccountName"
                            data-parentid="@(acc.ParentAccountId?.ToString() ?? "")"
                            data-natureid="@(acc.NatureOfAccountId?.ToString() ?? "")"
                            data-currency="@acc.Currency"
                            data-transable="@(isTransable ? "true" : "false")"
                            data-active="@(isActive ? "true" : "false")">

                            <td>
                                <strong style="color:var(--brass-text);font-family:monospace;font-size:13px;">
                                    @(string.IsNullOrEmpty(acc.AccountCode) ? $"ACC-{acc.Id}" : acc.AccountCode)
                                </strong>
                                @if (acc.LevelNo.HasValue)
                                {
                                    <span class="badge badge-gray" style="font-size:10px;margin-left:4px;padding:1px 5px;" title="Account Level @acc.LevelNo">L@(acc.LevelNo)</span>
                                }
                            </td>
                            <td>
                                <div style="font-weight:600;color:var(--text);font-size:13.5px;">
                                    @acc.AccountName
                                </div>
                                @if (acc.CreatedOn.HasValue)
                                {
                                    <div style="font-size:11px;color:var(--text-faint);">Added: @acc.CreatedOn.Value.ToString("dd MMM yyyy")</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(acc.ParentAccountName))
                                {
                                    <span class="badge badge-gray" style="font-size:11.5px;">
                                        @(string.IsNullOrEmpty(acc.ParentAccountCode) ? "" : $"{acc.ParentAccountCode} - ")@acc.ParentAccountName
                                    </span>
                                }
                                else
                                {
                                    <span style="font-size:11.5px;color:var(--text-faint);font-style:italic;">(Top Level)</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(acc.NatureOfAccountName))
                                {
                                    <span class="badge @(acc.DebtorOrCreditor == "D" ? "badge-green" : "badge-brass")" style="font-size:11.5px;">
                                        @acc.NatureOfAccountName @(string.IsNullOrEmpty(acc.DebtorOrCreditor) ? "" : $"({acc.DebtorOrCreditor})")
                                    </span>
                                }
                                else
                                {
                                    <span style="font-size:11.5px;color:var(--text-faint);">None</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-gray" style="font-size:11px;font-family:monospace;">@acc.Currency</span>
                            </td>
                            <td>
                                @if (isTransable)
                                {
                                    <span class="badge badge-green" style="font-size:11px;">
                                        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:2px;vertical-align:middle;"><polyline points="20 6 9 17 4 12"/></svg>
                                        Transable
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-brass" style="font-size:11px;">
                                        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:2px;vertical-align:middle;"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                        Group (@acc.SubAccountsCount)
                                    </span>
                                }
                            </td>
                            <td>
                                @if (isActive)
                                {
                                    <span class="badge badge-green">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-red">Inactive</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div class="row-actions" style="justify-content:flex-end;gap:4px;">
                                    <!-- Add Sub Account -->
                                    <button type="button" title="Add Sub-Account" class="btn ghost" style="padding:4px 7px;color:var(--teal-text);" onclick="quickAddSubAccount(@acc.Id, '@acc.AccountCode', @(acc.NatureOfAccountId ?? 0))">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                                    </button>

                                    <!-- Edit Action -->
                                    <button type="button" title="Edit Account" class="btn ghost" style="padding:4px 7px;" onclick="loadAccountForEdit(@acc.Id)">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                    </button>

                                    <!-- Toggle Active Action -->
                                    <form asp-controller="ChartOfAccounts" asp-action="ToggleStatus" asp-route-id="@acc.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn ghost" style="padding:4px 7px;" title="@(isActive ? "Deactivate Account" : "Activate Account")">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--brass-text)" stroke-width="2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0M12 2v10"/></svg>
                                        </button>
                                    </form>

                                    <!-- Delete Action -->
                                    <form asp-controller="ChartOfAccounts" asp-action="Delete" asp-route-id="@acc.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to permanently delete \'@acc.AccountName\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn ghost" style="padding:4px 7px;color:var(--red-text);" title="Delete Account">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyTableRow">
                        <td colspan="8" style="text-align:center;padding:36px 16px;color:var(--text-dim);">
                            <div style="font-size:15px;font-weight:500;margin-bottom:6px;">No accounts found in Chart of Accounts</div>
                            <div style="font-size:12.5px;color:var(--text-faint);">Click "Add Account" above to create your first accounting head.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Chart of Accounts Tree Hierarchy Styling */
    .coa-tree-list {
        list-style: none;
        padding-left: 22px;
        margin: 0;
        position: relative;
    }
    #coaTreeContainer > .coa-tree-list {
        padding-left: 0;
    }
    .coa-tree-list .coa-tree-list {
        border-left: 1px dashed rgba(212, 175, 55, 0.25);
        margin-left: 9px;
    }
    .coa-node {
        margin: 4px 0;
        position: relative;
    }
    .coa-node-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 6px;
        background: var(--surface2);
        border: 1px solid var(--border-soft);
        cursor: default;
        transition: all 0.15s ease;
        user-select: none;
    }
    .coa-node-row.has-children {
        cursor: pointer;
    }
    .coa-node-row:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(212, 175, 55, 0.35);
    }
    .tree-chevron {
        color: var(--brass);
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        flex-shrink: 0;
        cursor: pointer;
    }
    .tree-chevron:hover {
        background: rgba(212, 175, 55, 0.2);
    }
    .tree-bullet {
        width: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--text-faint);
        font-size: 14px;
        flex-shrink: 0;
    }
    .tree-code {
        font-family: monospace;
        font-size: 12.5px;
        color: var(--brass-text);
        font-weight: 600;
        letter-spacing: 0.5px;
    }
    .tree-name {
        font-weight: 500;
        font-size: 13.5px;
        color: var(--text);
        flex: 1;
    }
    .coa-node-children {
        margin-top: 4px;
    }
    /* Collapsed state */
    .coa-node.collapsed > .coa-node-row .tree-chevron {
        transform: rotate(-90deg);
        color: var(--text-dim);
    }
    .coa-node.collapsed > .coa-node-children {
        display: none !important;
    }
</style>

<!-- ========================================================================= -->
<!-- VIEW 2: HIERARCHICAL TREE VIEW                                            -->
<!-- ========================================================================= -->
<div class="card" id="coaTreeViewCard" style="display:block;">
    <div class="card-head" style="padding:16px 20px;border-bottom:1px solid var(--border-soft);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
        <div>
            <h3 style="font-size:15px;margin:0;">Chart of Accounts Hierarchy</h3>
            <span style="font-size:12px;color:var(--text-dim);">Click any group to expand or collapse · Use controls to expand or collapse according to your preference</span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            <button type="button" class="btn ghost" onclick="expandAllTree()" style="font-size:12px;padding:5px 12px;display:flex;align-items:center;gap:6px;" title="Expand all branches">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                Expand All
            </button>
            <button type="button" class="btn ghost" onclick="collapseAllTree()" style="font-size:12px;padding:5px 12px;display:flex;align-items:center;gap:6px;" title="Collapse all to top-level groups">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                Collapse All
            </button>
            <button type="button" class="btn ghost" onclick="collapseToLevel(2)" style="font-size:12px;padding:5px 10px;" title="Show Level 1 & 2 Groups Only">
                Level 2
            </button>
        </div>
    </div>

    <div style="padding:20px;">
        <div class="coa-tree" id="coaTreeContainer">
            @if (Model.TreeNodes != null && Model.TreeNodes.Any())
            {
                @await Html.PartialAsync("_CoaTreeNodePartial", Model.TreeNodes)
            }
            else
            {
                <div style="text-align:center;padding:30px;color:var(--text-dim);">No accounts in hierarchy.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
<!-- TomSelect JS Library -->
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<script>
    let treeInitialized = true;
    let parentAccountTomSelect = null;

    // Initialize TomSelect Searchable Dropdown for Parent Account
    function initParentAccountDropdown() {
        const parentSelectEl = document.getElementById('formParentAccountId');
        if (parentSelectEl && typeof TomSelect !== 'undefined' && !parentAccountTomSelect) {
            parentAccountTomSelect = new TomSelect(parentSelectEl, {
                create: false,
                maxItems: 1,
                maxOptions: null, // Allow all parent accounts to be searched and shown
                placeholder: 'Type code or name to search parent...',
                allowEmptyOption: true,
                plugins: ['dropdown_input'],
                searchField: ['text', 'value'],
                onChange: function (val) {
                    onParentAccountChanged();
                }
            });
        }
    }

    // View Switcher (Table vs Tree)
    function switchCoaView(mode) {
        const tableCard = document.getElementById('coaTableViewCard');
        const treeCard = document.getElementById('coaTreeViewCard');
        const btnTable = document.getElementById('btnViewTable');
        const btnTree = document.getElementById('btnViewTree');

        if (mode === 'tree') {
            tableCard.style.display = 'none';
            treeCard.style.display = 'block';
            btnTree.style.background = 'var(--brass)';
            btnTree.style.color = '#0A1614';
            btnTree.style.fontWeight = '600';
            btnTable.style.background = 'transparent';
            btnTable.style.color = 'var(--text)';
            btnTable.style.fontWeight = 'normal';

            if (!treeInitialized) {
                collapseToLevel(2);
                treeInitialized = true;
            }
        } else {
            tableCard.style.display = 'block';
            treeCard.style.display = 'none';
            btnTable.style.background = 'var(--brass)';
            btnTable.style.color = '#0A1614';
            btnTable.style.fontWeight = '600';
            btnTree.style.background = 'transparent';
            btnTree.style.color = 'var(--text)';
            btnTree.style.fontWeight = 'normal';
        }
    }

    // Toggle Form visibility
    function toggleCoaForm() {
        const formCard = document.getElementById('coaFormCard');
        if (formCard.style.display === 'none' || formCard.style.display === '') {
            formCard.style.display = 'block';
            initParentAccountDropdown();
            formCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            document.getElementById('formAccountName').focus();
            if (!document.getElementById('formAccountCode').value) {
                generateNextCode();
            }
        } else {
            resetCoaForm();
        }
    }

    // Live Search and Filtering
    function filterCoaTable() {
        const searchVal = (document.getElementById('coaSearchInput').value || '').toLowerCase().trim();
        const natureVal = (document.getElementById('natureFilter').value || '').trim();
        const typeVal = (document.getElementById('typeFilter').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#coaTable tbody tr[id^="row-coa-"]');

        rows.forEach(row => {
            const rowText = row.textContent.toLowerCase();
            const rowNature = row.getAttribute('data-natureid');
            const rowTransable = row.getAttribute('data-transable') === 'true';
            const rowActive = row.getAttribute('data-active') === 'true';

            const matchesSearch = !searchVal || rowText.includes(searchVal);
            const matchesNature = !natureVal || rowNature === natureVal;

            let matchesType = true;
            if (typeVal === 'transable') matchesType = rowTransable;
            else if (typeVal === 'group') matchesType = !rowTransable;
            else if (typeVal === 'active') matchesType = rowActive;
            else if (typeVal === 'inactive') matchesType = !rowActive;

            if (matchesSearch && matchesNature && matchesType) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        // Also filter the tree view if search term is entered
        filterCoaTree(searchVal);
    }

    // Filter Tree View nodes by search text
    function filterCoaTree(searchVal) {
        const container = document.getElementById('coaTreeContainer');
        if (!container) return;

        if (!searchVal) {
            container.querySelectorAll('.coa-node').forEach(node => {
                node.style.display = '';
            });
            return;
        }

        // Expand all when searching so matches are visible
        expandAllTree();

        const allNodes = Array.from(container.querySelectorAll('.coa-node'));
        allNodes.forEach(node => {
            const rowText = (node.querySelector('.tree-code')?.textContent || '') + ' ' + (node.querySelector('.tree-name')?.textContent || '');
            const match = rowText.toLowerCase().includes(searchVal);
            const childMatch = Array.from(node.querySelectorAll('.coa-node-children .coa-node')).some(child => {
                const childText = (child.querySelector('.tree-code')?.textContent || '') + ' ' + (child.querySelector('.tree-name')?.textContent || '');
                return childText.toLowerCase().includes(searchVal);
            });

            if (match || childMatch) {
                node.style.display = '';
            } else {
                node.style.display = 'none';
            }
        });
    }

    // Generate Next Code via AJAX
    function generateNextCode() {
        let parentId = '';
        if (parentAccountTomSelect) {
            parentId = parentAccountTomSelect.getValue() || '';
        } else {
            parentId = document.getElementById('formParentAccountId')?.value || '';
        }

        fetch('/ChartOfAccounts/GetNextCode?parentAccountId=' + encodeURIComponent(parentId))
            .then(res => res.json())
            .then(data => {
                if (data.success && data.nextCode) {
                    document.getElementById('formAccountCode').value = data.nextCode;
                }
            })
            .catch(err => console.error('Error fetching code:', err));
    }

    function onParentAccountChanged() {
        generateNextCode();
    }

    // Quick Add Sub Account
    function quickAddSubAccount(parentId, parentCode, natureId) {
        resetCoaForm();
        initParentAccountDropdown();

        if (parentAccountTomSelect) {
            parentAccountTomSelect.setValue(parentId ? String(parentId) : '', true);
        } else {
            document.getElementById('formParentAccountId').value = parentId;
        }

        if (natureId && natureId > 0) {
            document.getElementById('formNatureOfAccountId').value = natureId;
        }
        document.getElementById('formTitle').innerText = 'Add Sub-Account under: ' + parentCode;
        document.getElementById('formSubTitle').innerText = 'Creating child account under parent #' + parentId;

        const formCard = document.getElementById('coaFormCard');
        formCard.style.display = 'block';
        formCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        document.getElementById('formAccountName').focus();
        generateNextCode();
    }

    // Load Account for Editing
    function loadAccountForEdit(id) {
        fetch('/ChartOfAccounts/GetById/' + id)
            .then(res => res.json())
            .then(res => {
                if (!res.success) {
                    alert(res.message || 'Account not found');
                    return;
                }
                const data = res.data;
                initParentAccountDropdown();

                document.getElementById('formId').value = data.id;
                document.getElementById('formAccountCode').value = data.accountCode || '';
                document.getElementById('formAccountName').value = data.accountName || '';

                if (parentAccountTomSelect) {
                    parentAccountTomSelect.setValue(data.parentAccountId ? String(data.parentAccountId) : '', true);
                } else {
                    document.getElementById('formParentAccountId').value = data.parentAccountId || '';
                }

                document.getElementById('formNatureOfAccountId').value = data.natureOfAccountId || '';
                document.getElementById('formCurrency').value = data.currency || 'PKR';
                document.getElementById('formTransable').checked = (data.transable === true || data.transable === 'true' || data.transable === 1);
                document.getElementById('formActive').checked = (data.active === true || data.active === 'true' || data.active === 1);

                document.getElementById('formTitle').innerText = 'Edit Account: ' + data.accountName;
                document.getElementById('formSubTitle').innerText = 'Updating configuration for Account #' + data.id;
                document.getElementById('btnSubmitText').innerText = 'Update Account';
                document.getElementById('btnAddBtnText').innerText = 'Edit Mode Active';

                const formCard = document.getElementById('coaFormCard');
                formCard.style.display = 'block';
                formCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                document.getElementById('formAccountName').focus();
            })
            .catch(err => alert('Failed to load account details: ' + err));
    }

    // Reset Form
    function resetCoaForm() {
        document.getElementById('coaForm').reset();
        document.getElementById('formId').value = '0';

        if (parentAccountTomSelect) {
            parentAccountTomSelect.clear(true);
            parentAccountTomSelect.setValue('', true);
        } else {
            document.getElementById('formParentAccountId').value = '';
        }

        document.getElementById('formNatureOfAccountId').value = '';
        document.getElementById('formCurrency').value = 'PKR';
        document.getElementById('formTransable').checked = true;
        document.getElementById('formActive').checked = true;

        document.getElementById('formTitle').innerText = 'Add New Chart of Account';
        document.getElementById('formSubTitle').innerText = 'Create a financial posting head or group category in the chart of accounts.';
        document.getElementById('btnSubmitText').innerText = 'Save Account';
        document.getElementById('btnAddBtnText').innerText = 'Add Account';

        document.getElementById('coaFormCard').style.display = 'none';
    }

    // --------------------------------------------------------------------------
    // HIERARCHICAL TREE VIEW TOGGLE & EXPANSION ENGINE
    // --------------------------------------------------------------------------

    // Click anywhere on a parent row to expand or collapse
    function onNodeRowClick(event, rowElement) {
        if (event.target.closest('button')) {
            return; // Let edit button handle its own event
        }
        toggleTreeNode(rowElement);
    }

    // Toggle individual node
    function toggleTreeNode(element) {
        const parentLi = element.closest('.coa-node');
        if (parentLi && parentLi.querySelector('.coa-node-children')) {
            parentLi.classList.toggle('collapsed');
        }
    }

    // Expand all nodes
    function expandAllTree() {
        document.querySelectorAll('#coaTreeContainer .coa-node').forEach(node => {
            node.classList.remove('collapsed');
        });
    }

    // Collapse all parent nodes (leaves only Level 1 top groups visible)
    function collapseAllTree() {
        document.querySelectorAll('#coaTreeContainer .coa-node').forEach(node => {
            if (node.querySelector('.coa-node-children')) {
                node.classList.add('collapsed');
            }
        });
    }

    // Collapse to a specific depth (e.g. depth 2 = show top groups and their sub-groups, collapse leaf accounts)
    function collapseToLevel(targetDepth) {
        const rootUl = document.querySelector('#coaTreeContainer > .coa-tree-list');
        if (!rootUl) return;

        function traverse(ul, depth) {
            const lis = Array.from(ul.children).filter(el => el.classList.contains('coa-node'));
            lis.forEach(li => {
                const childContainer = li.querySelector(':scope > .coa-node-children');
                if (childContainer) {
                    if (depth >= targetDepth) {
                        li.classList.add('collapsed');
                    } else {
                        li.classList.remove('collapsed');
                    }
                    const subUl = childContainer.querySelector(':scope > .coa-tree-list');
                    if (subUl) {
                        traverse(subUl, depth + 1);
                    }
                }
            });
        }

        traverse(rootUl, 1);
    }

    // Initialize tree view and parent account dropdown on page load
    document.addEventListener('DOMContentLoaded', function () {
        initParentAccountDropdown();
        collapseToLevel(2);
    });
</script>
}
