@model List<ERP_Core.Dtos.CoaNodeDto>

<ul class="coa-tree-list">
    @foreach (var node in Model)
    {
        var hasChildren = node.Children != null && node.Children.Any();
        <li class="coa-node" data-node-id="@node.Id">
            <div class="coa-node-row @(hasChildren ? "has-children" : "")" onclick="onNodeRowClick(event, this)">
                @if (hasChildren)
                {
                    <span class="tree-chevron" title="Click to Expand / Collapse">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                    </span>
                }
                else
                {
                    <span class="tree-bullet">&bull;</span>
                }

                <span class="tree-code">@node.Code</span>
                @if (node.LevelNo.HasValue)
                {
                    <span class="badge badge-gray" style="font-size:10px;padding:1px 5px;" title="Level @node.LevelNo">L@(node.LevelNo)</span>
                }
                <span class="tree-name">@node.Name</span>

                @if (!string.IsNullOrEmpty(node.NatureName))
                {
                    <span class="badge badge-brass" style="font-size:10.5px;">@node.NatureName</span>
                }

                @if (node.Transable)
                {
                    <span class="badge badge-green" style="font-size:10.5px;">Transable</span>
                }
                else
                {
                    <span class="badge badge-gray" style="font-size:10.5px;">Group</span>
                }

                <button type="button" class="btn ghost" style="padding:2px 6px;font-size:11px;" onclick="loadAccountForEdit(@node.Id); event.stopPropagation();" title="Edit Account">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                </button>
            </div>

            @if (hasChildren)
            {
                <div class="coa-node-children">
                    @await Html.PartialAsync("_CoaTreeNodePartial", node.Children)
                </div>
            }
        </li>
    }
</ul>
