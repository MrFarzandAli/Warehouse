                                                                                <tr style="border-bottom:1px solid rgba(255,255,255,0.03);">
                                                                                    <td style="padding:5px 8px;"><span class="badge brass" style="font-family:monospace;font-size:10.5px;font-weight:700;">${escapeHtml(lv.voucherNo || lv.VoucherNo || '')}</span></td>
                                                                                    <td style="padding:5px 8px;color:var(--teal-text);font-weight:600;">${escapeHtml(lv.voucherType || lv.VoucherType || '')}</td>
                                                                                    <td style="padding:5px 8px;color:var(--text-dim);">${escapeHtml(lv.date || lv.Date || '')}</td>
                                                                                    <td style="padding:5px 8px;color:var(--text);"><strong>${escapeHtml(lv.partyOrAccount || lv.PartyOrAccount || '')}</strong></td>
                                                                                    <td class="tnum font-weight-bold" style="padding:5px 8px;text-align:right;color:var(--brass-text);">Rs ${Number(lv.amount || lv.Amount || 0).toLocaleString('en-US')}</td>
                                                                                    <td style="padding:5px 8px;color:var(--text-dim);max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${escapeHtml(lv.narration || lv.Narration || '')}">${escapeHtml(lv.narration || lv.Narration || '-')}</td>
                                                                                    <td style="padding:5px 8px;text-align:center;"><span class="badge" style="background:rgba(47,158,140,0.15);color:var(--teal-text);font-size:10px;padding:1px 5px;">${escapeHtml(lv.activityType || lv.ActivityType || 'Created')}</span></td>
                                                                                    <td style="padding:5px 8px;text-align:center;"><span class="badge green" style="font-size:9.5px;padding:1px 5px;">${escapeHtml(lv.status || lv.Status || 'Approved')}</span></td>
                                                                                </tr>
                                                                            `).join('')}
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    ` : ''}
                                                `;
                                            }).join('')}
                                        </tbody>
                                    </table>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding-top:12px;margin-top:10px;border-top:1px solid var(--border-soft);font-size:12px;">
                                    <div>
                                        <span style="color:var(--text-dim);">Total Bills Handled: </span>
                                        <strong>${bills.length} Bills</strong>
                                    </div>
                                    <div style="display:flex;gap:18px;">
                                        <div>
                                            <span style="color:var(--text-dim);">Total Sales Volume: </span>
                                            <strong class="tnum" style="color:var(--text);">Rs ${Number(totalSales).toLocaleString('en-US')}</strong>
                                        </div>
                                        <div>
                                            <span style="color:var(--text-dim);">Commission: </span>
                                            <strong class="tnum" style="color:var(--brass-text);">Rs ${Number(totalComm).toLocaleString('en-US')}</strong>
                                        </div>
                                    </div>
                                </div>
                                ` : `
                                <div style="padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text-faint);font-size:12px;text-align:center;">
                                    No bills handled by this staff member in the selected period.
                                </div>
                                `}

                                <!-- 2. Standalone Manual Vouchers Section -->
                                <div style="margin-top:18px;border-top:1px dashed var(--border);padding-top:16px;">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <span style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:4px;background:rgba(47,158,140,0.18);color:var(--teal-text);">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                            </span>
                                            <strong style="color:var(--text);font-size:13px;letter-spacing:0.3px;">
                                                Manual Vouchers Created Without Any Bill
                                            </strong>
                                            <span class="badge gray" style="font-size:11px;">${manualVouchers.length} records</span>
                                        </div>
                                        <div style="font-size:12px;color:var(--text-dim);">
                                            Total Manual Voucher Volume: <strong class="tnum" style="color:var(--teal-text);">Rs ${Number(totalVcVol).toLocaleString('en-US')}</strong>
                                        </div>
                                    </div>

                                    ${manualVouchers.length > 0 ? `
                                    <div style="overflow-x:auto;">
                                        <table style="width:100%;font-size:12px;border-collapse:collapse;background:var(--surface);border:1px solid var(--border);border-radius:6px;">
                                            <thead>
                                                <tr style="border-bottom:1px solid var(--border);background:var(--surface2);">
                                                    <th style="padding:8px 10px;text-align:center;width:35px;">#</th>
                                                    <th style="padding:8px 10px;width:130px;">VOUCHER #</th>
                                                    <th style="padding:8px 10px;width:140px;">TYPE</th>
                                                    <th style="padding:8px 10px;width:100px;">DATE</th>
                                                    <th style="padding:8px 10px;">PARTY / ACCOUNT</th>
                                                    <th style="padding:8px 10px;text-align:right;width:120px;">AMOUNT</th>
                                                    <th style="padding:8px 10px;">NARRATION</th>
                                                    <th style="padding:8px 10px;text-align:center;width:110px;">ACTIVITY</th>
                                                    <th style="padding:8px 10px;width:150px;">TIMESTAMP</th>
                                                    <th style="padding:8px 10px;text-align:center;width:80px;">STATUS</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${manualVouchers.map((mv, vIdx) => {
                                                    const vNo = mv.voucherNo || mv.VoucherNo || '';
                                                    const vType = mv.voucherType || mv.VoucherType || '';
                                                    const vDate = mv.date || mv.Date || '';
                                                    const vParty = mv.partyOrAccount || mv.PartyOrAccount || '';
                                                    const vAmt = mv.amount ?? mv.Amount ?? 0;
                                                    const vNarr = mv.narration || mv.Narration || '-';
                                                    const vAct = mv.activityType || mv.ActivityType || 'Created';
                                                    const vTs = mv.timestamp || mv.Timestamp || '';
                                                    const vSt = mv.status || mv.Status || 'Approved';

                                                    return `
                                                        <tr style="border-bottom:1px solid var(--border-soft);">
                                                            <td style="padding:8px 10px;text-align:center;color:var(--text-faint);">${vIdx + 1}</td>
                                                            <td style="padding:8px 10px;"><span class="badge brass" style="font-family:monospace;font-weight:700;">${escapeHtml(vNo)}</span></td>
                                                            <td style="padding:8px 10px;"><span class="badge" style="background:rgba(47,158,140,0.15);color:var(--teal-text);border:1px solid rgba(47,158,140,0.3);font-size:11px;font-weight:600;">${escapeHtml(vType)}</span></td>
                                                            <td style="padding:8px 10px;color:var(--text-dim);">${escapeHtml(vDate)}</td>
                                                            <td style="padding:8px 10px;"><strong style="color:var(--text);">${escapeHtml(vParty)}</strong></td>
                                                            <td class="tnum font-weight-bold" style="padding:8px 10px;text-align:right;color:var(--teal-text);">Rs ${Number(vAmt).toLocaleString('en-US')}</td>
                                                            <td style="padding:8px 10px;color:var(--text-dim);max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${escapeHtml(vNarr)}">${escapeHtml(vNarr)}</td>
                                                            <td style="padding:8px 10px;text-align:center;">
                                                                <span class="badge" style="background:${vAct === 'Created' ? 'rgba(198,138,62,0.18)' : 'rgba(47,158,140,0.18)'};color:${vAct === 'Created' ? 'var(--brass-text)' : 'var(--teal-text)'};border:1px solid ${vAct === 'Created' ? 'var(--brass)' : 'var(--teal)'};font-size:10.5px;padding:2px 7px;">
                                                                    ${vAct === 'Created' ? 'Created (اصل اندراج)' : 'Modified (ترمیم)'}
                                                                </span>
                                                            </td>
                                                            <td style="padding:8px 10px;font-size:11px;color:var(--text-dim);">${escapeHtml(vTs)}</td>
                                                            <td style="padding:8px 10px;text-align:center;"><span class="badge green" style="font-size:10px;">${escapeHtml(vSt)}</span></td>
                                                        </tr>
                                                    `;
                                                }).join('')}
                                            </tbody>
                                        </table>
                                    </div>
                                    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding-top:10px;margin-top:8px;font-size:12px;">
                                        <div>
                                            <span style="color:var(--text-dim);">Total Standalone Vouchers: </span>
                                            <strong>${manualVouchers.length} Vouchers</strong>
                                        </div>
                                        <div>
                                            <span style="color:var(--text-dim);">Total Amount: </span>
                                            <strong class="tnum" style="color:var(--teal-text);">Rs ${Number(totalVcVol).toLocaleString('en-US')}</strong>
                                        </div>
                                    </div>
                                    ` : `
                                    <div style="padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text-faint);font-size:12px;text-align:center;">
                                        No standalone manual vouchers created by this staff member in the selected period.
                                    </div>
                                    `}
                                </div>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
        }

        if (sel) {
            sel.addEventListener('change', function () {
                updateDurationInputs();
                fetchDashboardSummaries();
            });
            updateDurationInputs();
        }

        if (fromInput) {
            fromInput.addEventListener('input', function () {
                if (this.value) this.dataset.isoDate = this.value;
            });
            fromInput.addEventListener('change', function () {
                if (this.value) this.dataset.isoDate = this.value;
                if (sel && sel.value === 'custom_date') fetchDashboardSummaries();
            });
        }

        if (toInput) {
            toInput.addEventListener('input', function () {
                if (this.value) this.dataset.isoDate = this.value;
            });
            toInput.addEventListener('change', function () {
                if (this.value) this.dataset.isoDate = this.value;
                if (sel && sel.value === 'custom_date') fetchDashboardSummaries();
            });
        }

        const filterBtnEl = document.getElementById('btnFilterDashboard');
        if (filterBtnEl) {
            filterBtnEl.addEventListener('click', function (e) {
                e.preventDefault();
                if (sel && sel.value === 'custom_date') {
                    if (fromInput && fromInput.value) fromInput.dataset.isoDate = fromInput.value;
                    if (toInput && toInput.value) toInput.dataset.isoDate = toInput.value;
                }
                fetchDashboardSummaries();
            });
        }
    })();


    // Toggle Staff Details Sub-table (Matching NewBill Pattern)
    window.toggleStaffDetails = function (staffId, btn) {
        const detailRow = document.getElementById('staffDetails_' + staffId);
        if (!detailRow) {
            console.warn('Detail row not found for staffId:', staffId);
            return;
        }

        const expandBtn = btn || document.getElementById('staffExpandBtn_' + staffId);
        const isHidden = window.getComputedStyle(detailRow).display === 'none' || detailRow.style.display === 'none';
        if (isHidden) {
            detailRow.style.display = 'table-row';
            if (expandBtn) expandBtn.classList.add('expanded');
        } else {
            detailRow.style.display = 'none';
            if (expandBtn) expandBtn.classList.remove('expanded');
        }
    };

    // Toggle Linked Vouchers Accordion for a Bill
    window.toggleBillVouchers = function (key, btn) {
        const row = document.getElementById('billVouchers_' + key);
        if (!row) return;

        const expandBtn = btn || document.getElementById('billExpandBtn_' + key);
        const isHidden = window.getComputedStyle(row).display === 'none' || row.style.display === 'none';
        if (isHidden) {
            row.style.display = 'table-row';
            if (expandBtn) expandBtn.classList.add('expanded');
        } else {
            row.style.display = 'none';
            if (expandBtn) expandBtn.classList.remove('expanded');
        }
    };
</script>
}
