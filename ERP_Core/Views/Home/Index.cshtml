                    if (filterText) filterText.textContent = 'Filter';
                    if (err.name !== 'AbortError') {
                        console.warn('Dashboard summary data fetch failed, submitting form fallback:', err);
                        const form = document.getElementById('dashFilterForm');
                        if (form) form.submit();
                    }
                });
        }

        window.applyDashboardFilter = function () {
            fetchDashboardSummaries();
        };

        window.handleFilterSubmit = function (e) {
            if (e) e.preventDefault();
            fetchDashboardSummaries();
            return false;
        };

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

