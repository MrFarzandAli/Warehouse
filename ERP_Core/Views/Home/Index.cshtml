                                const branchText = b.branchOrLocation || (isCash ? 'Cash Counter' : 'Main Branch');
                                const ibanText = (b.ibanNo && b.ibanNo !== '-') ? b.ibanNo : 'N/A';

                                const ledgerAccParam = (b.chartOfAccountId && b.chartOfAccountId > 0)
                                    ? `accountId=${encodeURIComponent(b.chartOfAccountId)}`
                                    : `account=${encodeURIComponent(b.accountName || b.bankName || '')}`;
                                const dateParams = (fromVal && toVal) ? `&fromDate=${encodeURIComponent(fromVal)}&toDate=${encodeURIComponent(toVal)}` : '';
