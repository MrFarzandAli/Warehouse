                                            </div>
                                            <div style="font-size:12px;color:var(--text-dim);">
                                                Total Manual Voucher Volume: <strong class="tnum" style="color:var(--teal-text);">Rs @s.TotalVouchersVolume.ToString("N0")</strong>
                                            </div>
                                        </div>

                                        @if (s.ManualVouchers != null && s.ManualVouchers.Any())
                                        {
