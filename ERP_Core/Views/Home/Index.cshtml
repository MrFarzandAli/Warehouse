                const totalSales = s.totalSalesVolume ?? s.TotalSalesVolume ?? 0;
                const totalComm = s.totalCommission ?? s.TotalCommission ?? 0;
                const totalVcVol = s.totalVouchersVolume ?? s.TotalVouchersVolume ?? 0;
