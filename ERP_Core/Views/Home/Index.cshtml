                                                                <td style="padding:8px 10px;">
                                                                    <strong style="color:var(--text);">@mv.PartyOrAccount</strong>
                                                                </td>
                                                                <td class="tnum font-weight-bold" style="padding:8px 10px;text-align:right;color:var(--teal-text);">
