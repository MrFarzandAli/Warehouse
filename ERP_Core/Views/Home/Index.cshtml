                    <span class="bar-val tnum" style="@(bar.IsToday ? "color:var(--brass-text);font-weight:700;" : "color:var(--text);")">Rs @bar.Amount.ToString("N0")</span>
                </div>
            }
        }
        else
        {
            <div style="padding:25px 0;text-align:center;color:var(--text-faint);width:100%;font-size:12px;">No monthly trends recorded</div>
        }
    </div>
</div>

