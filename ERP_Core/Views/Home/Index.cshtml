                        if (window.ERPDataTables && tableEl) {
                            window.ERPDataTables.init(tableEl);
                        }
                    }

                    // 10. Update Bank & Cash Accounts Liquidity
                    const liquidPill = document.getElementById('totalLiquidFundsPill');
                    const bankPill = document.getElementById('totalBankFundsPill');
                    const cashPill = document.getElementById('totalCashInHandPill');
                    if (liquidPill) liquidPill.textContent = 'Rs ' + Number(data.totalLiquidFunds || 0).toLocaleString('en-US');
                    if (bankPill) bankPill.textContent = 'Rs ' + Number(data.totalBankFunds || 0).toLocaleString('en-US');
                    if (cashPill) cashPill.textContent = 'Rs ' + Number(data.totalCashInHand || 0).toLocaleString('en-US');

                    const dashBankGrid = document.getElementById('dashBankGrid');
                    if (dashBankGrid) {
                        if (data.bankBalances && data.bankBalances.length > 0) {
                            dashBankGrid.innerHTML = data.bankBalances.map(b => {
                                const isCash = !!b.isCash;
                                const cardClass = isCash ? 'bank-asset-card is-cash' : 'bank-asset-card';
                                const iconSvg = isCash
                                    ? '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>'
                                    : '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 3l9 7H3z"/></svg>';
