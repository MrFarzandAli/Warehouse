<!-- Full-Width Commission Trend Graph (Weekly or Monthly Dynamic) -->
<div class="card dash-trend-card">
    <div class="card-head">
        <h3 id="trendCardTitle">Weekly commission trend</h3>
        <a asp-controller="ProfitLoss" asp-action="Index" class="link-btn">Full report →</a>
    </div>

    <!-- Weekly Trend Bars (Default) -->
    <div class="bars" id="weeklyBars">
        @if (Model.WeeklyTrends != null && Model.WeeklyTrends.Any())
        {
            @foreach (var bar in Model.WeeklyTrends)
            {
                <div class="bar-col">
                    <div class="bar" style="height:@(bar.Percent)%; @(bar.IsToday ? "background:linear-gradient(180deg,var(--brass),var(--brass-dim));" : "")"></div>
                    <span class="bar-day">@bar.Day</span>
                    <span class="bar-val tnum" style="@(bar.IsToday ? "color:var(--brass-text);font-weight:700;" : "color:var(--text);")">Rs @bar.Amount.ToString("N0")</span>
                </div>
            }
        }
        else
        {
            <div style="padding:25px 0;text-align:center;color:var(--text-faint);width:100%;font-size:12px;">No commission trends recorded for this period</div>
        }
    </div>

    <!-- Monthly Trend Bars (Shown when 'Month' duration is selected) -->
    <div class="bars" id="monthlyBars" style="display:none;">
        @if (Model.MonthlyTrends != null && Model.MonthlyTrends.Any())
        {
            @foreach (var bar in Model.MonthlyTrends)
            {
                <div class="bar-col">
                    <div class="bar" style="height:@(bar.Percent)%; @(bar.IsToday ? "background:linear-gradient(180deg,var(--brass),var(--brass-dim));" : "")"></div>
