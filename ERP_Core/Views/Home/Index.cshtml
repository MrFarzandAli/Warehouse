                                                <div>
                                                    <div class="bank-title">${escapeHtml(b.bankName)}</div>
                                                    <div class="bank-branch">${escapeHtml(branchText)}</div>
                                                </div>
                                            </div>
                                            <span class="${badgeClass}" style="font-size:10px;padding:2px 7px;">
