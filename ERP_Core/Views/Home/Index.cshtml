<!-- Bank & Cash Accounts Liquidity Section -->
<div class="card" style="margin-bottom:24px;padding:20px;">
    <div class="card-head" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:18px;">
        <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:36px;height:36px;border-radius:8px;background:rgba(198,138,62,0.18);border:1px solid var(--brass);display:flex;align-items:center;justify-content:center;color:var(--brass-text);">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 3l9 7H3z"/></svg>
            </div>
            <div>
                <h3 style="margin:0;font-size:15px;font-family:var(--font-head);font-weight:600;">Bank &amp; Cash Accounts Liquidity</h3>
                <div style="font-size:11.5px;color:var(--text-dim);">Live available balance in each bank account, inflow deposits &amp; payments outflow</div>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <span class="role-pill" style="background:rgba(46,125,50,0.18);color:var(--green-text);border:1px solid rgba(46,125,50,0.3);font-size:12px;padding:4px 10px;">
                    Total Liquid Funds: <strong id="totalLiquidFundsPill">Rs @Model.TotalLiquidFunds.ToString("N0")</strong>
                </span>
                <span class="role-pill" style="background:var(--surface2);color:var(--teal-text);font-size:12px;padding:4px 10px;">
                    Banks: <strong id="totalBankFundsPill">Rs @Model.TotalBankFunds.ToString("N0")</strong>
                </span>
                <span class="role-pill" style="background:var(--surface2);color:var(--brass-text);font-size:12px;padding:4px 10px;">
                    Cash (Rokad): <strong id="totalCashInHandPill">Rs @Model.TotalCashInHand.ToString("N0")</strong>
                </span>
            </div>
            <a asp-controller="BankMaster" asp-action="Index" class="link-btn" style="font-size:12.5px;">Manage banks →</a>
        </div>
    </div>

    <!-- Grid of Bank Account Cards -->
    <div class="dash-bank-grid" id="dashBankGrid">
        @if (Model.BankBalances != null && Model.BankBalances.Any())
        {
            @foreach (var bank in Model.BankBalances)
            {
                <div class="bank-asset-card @(bank.IsCash ? "is-cash" : "")">
                    <div class="bank-card-top">
                        <div class="bank-identity">
                            <div class="bank-icon-wrap">
                                @if (bank.IsCash)
                                {
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 3l9 7H3z"/></svg>
                                }
                            </div>
                            <div>
                                <div class="bank-title">@bank.BankName</div>
                                <div class="bank-branch">@bank.BranchOrLocation</div>
                            </div>
                        </div>
                        <span class="badge @(bank.IsCash ? "brass" : "teal")" style="font-size:10px;padding:2px 7px;">
                            @(bank.IsCash ? "Cash in Hand" : "Commercial Bank")
                        </span>
                    </div>

                    <div class="bank-meta-row">
                        <div>
                            <span class="meta-lbl">A/C Title:</span>
                            <strong class="meta-val">@bank.AccountName</strong>
                        </div>
                        <div>
                            <span class="meta-lbl">A/C No:</span>
                            <span class="meta-val font-mono" style="color:var(--teal-text);">@bank.AccountNo</span>
                        </div>
                    </div>

                    <div class="bank-balance-box">
                        <div class="bal-lbl">AVAILABLE BALANCE IN ACCOUNT</div>
                        <div class="bal-amount tnum font-weight-bold" style="color:@(bank.IsCash ? "var(--brass-text)" : "var(--green-text)");">
                            Rs @bank.CurrentBalance.ToString("N0")
                        </div>
                    </div>

                    <div class="bank-flux-row">
                        <div class="flux-item in">
                            <span class="flux-lbl">Inflow (Wasooli / Dep)</span>
                            <span class="flux-val tnum">+ Rs @bank.InflowAmount.ToString("N0")</span>
                        </div>
                        <div class="flux-divider"></div>
                        <div class="flux-item out">
                            <span class="flux-lbl">Outflow (Payments / With)</span>
                            <span class="flux-val tnum">- Rs @bank.OutflowAmount.ToString("N0")</span>
                        </div>
                    </div>

                    <div class="bank-card-foot">
                        <span class="iban-text" title="@bank.IbanNo">IBAN: @(string.IsNullOrEmpty(bank.IbanNo) || bank.IbanNo == "-" ? "N/A" : bank.IbanNo)</span>
                        @if (bank.ChartOfAccountId.HasValue && bank.ChartOfAccountId.Value > 0)
                        {
                            <a asp-controller="AccountLedger" asp-action="Index" asp-route-accountId="@bank.ChartOfAccountId" asp-route-fromDate="@Model.SelectedFromDate" asp-route-toDate="@Model.SelectedToDate" class="link-btn" style="font-size:11.5px;">View ledger →</a>
                        }
                        else
                        {
                            <a asp-controller="AccountLedger" asp-action="Index" asp-route-account="@(bank.AccountName ?? bank.BankName)" asp-route-fromDate="@Model.SelectedFromDate" asp-route-toDate="@Model.SelectedToDate" class="link-btn" style="font-size:11.5px;">View ledger →</a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column:1 / -1;padding:25px;text-align:center;color:var(--text-faint);">No bank or cash accounts configured yet in Bank Master.</div>
        }
    </div>
</div>

<!-- Recent Bills Table -->
<div class="card" style="margin-bottom:24px;">
    <div class="card-head">
        <h3>Recent bills</h3>
        <a asp-controller="NewBill" asp-action="Index" class="link-btn">+ New bill →</a>
    </div>
    <div class="table-wrap">
        <table class="dynamic-table" id="recentBillsTable">
            <thead>
                <tr>
                    <th>Bill #</th>
                    <th>Date</th>
                    <th>Supplier (Boat)</th>
                    <th>Lots</th>
                    <th>Total sale</th>
                    <th>Commission</th>
                    <th>Net payable</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="recentBillsTbody">
                @if (Model.RecentBills != null && Model.RecentBills.Any())
                {
                    @foreach (var bill in Model.RecentBills)
                    {
                        <tr>
                            <td><span class="tcode">@bill.BillNo</span></td>
                            <td>@bill.Date</td>
                            <td><strong>@bill.SupplierName</strong></td>
                            <td><span class="badge badge-gray">@bill.LotsCount lots</span></td>
                            <td class="tnum font-weight-bold">Rs @bill.TotalSale.ToString("N0")</td>
                            <td class="tnum" style="color:var(--brass-text);">Rs @bill.Commission.ToString("N0")</td>
                            <td class="tnum font-weight-bold" style="color:var(--green-text);">Rs @bill.NetPayable.ToString("N0")</td>
                            <td>
                                @if (bill.Status == "Paid")
                                {
                                    <span class="stamp paid"><span class="ring"></span><span>PAID</span></span>
                                }
                                else if (bill.Status == "Due")
                                {
                                    <span class="stamp due"><span class="ring"></span><span>DUE</span></span>
                                }
                                else
                                {
                                    <span class="stamp partial"><span class="ring"></span><span>PARTIAL</span></span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:25px;color:var(--text-faint);">
                            No bills recorded yet
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Staff Activity & Audit Records (Bills Worked On and Standalone Vouchers) -->
<div class="card" style="margin-top:20px;padding:0;overflow:hidden;border:1px solid var(--border);">
    <div style="padding:14px 18px;background:var(--surface2);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
        <div style="display:flex;align-items:center;gap:8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--brass)" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <h3 style="font-size:14.5px;margin:0;color:var(--text);font-weight:600;font-family:var(--font-head);">Staff Activity &amp; Audit Records</h3>
            <span class="badge gray" id="staffMembersCountBadge" style="background:var(--surface3);color:var(--text-dim);font-size:11px;padding:3px 8px;border-radius:10px;">@(Model.StaffMembers?.Count ?? 0) staff members</span>
        </div>
        <div style="font-size:12px;color:var(--text-dim);">
            Click <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;"><polyline points="9 18 15 12 9 6"/></svg> to <strong>Expand Bills &amp; Vouchers Handled</strong> (CreatedBy &amp; ModifiedBy audit).
        </div>
    </div>

    <div class="table-wrap" style="overflow-x:auto;">
        <table id="staffActivityTable" class="staff-activity-table" style="width:100%;">
            <thead>
                <tr>
                    <th style="width:36px;text-align:center;" title="Expand Details"></th>
                    <th style="min-width:180px;">STAFF MEMBER</th>
                    <th style="min-width:170px;">ROLE / DESIGNATION</th>
                    <th style="width:120px;text-align:center;">CREATED</th>
                    <th style="width:120px;text-align:center;">MODIFIED</th>
                    <th style="width:120px;text-align:center;">TOTAL HANDLED</th>
                    <th style="width:140px;text-align:right;">TOTAL SALES / VOL</th>
                    <th style="width:130px;min-width:120px;text-align:right;padding-right:16px;">COMMISSION</th>
                    <th style="width:160px;min-width:140px;text-align:center;padding:0 12px;">LAST ACTIVITY</th>
                    <th style="width:80px;text-align:center;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.StaffMembers != null && Model.StaffMembers.Any())
                {
                    @foreach (var s in Model.StaffMembers)
                    {
                        <tr id="staffRow_@s.StaffId">
                            <td style="text-align:center;padding:6px;">
                                <button type="button" class="btn-expand-toggle" id="staffExpandBtn_@s.StaffId" onclick="toggleStaffDetails(@s.StaffId, this)" title="Expand / Collapse Bills and Vouchers Handled">
                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                                </button>
                            </td>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px;cursor:pointer;" onclick="toggleStaffDetails(@s.StaffId, document.getElementById('staffExpandBtn_@s.StaffId'))">
                                    <div style="width:30px;height:30px;border-radius:50%;background:rgba(198,138,62,0.18);border:1px solid var(--brass);display:flex;align-items:center;justify-content:center;color:var(--brass-text);font-weight:700;font-size:12px;">
                                        @(string.IsNullOrEmpty(s.StaffName) ? "S" : s.StaffName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <strong style="color:var(--text);font-size:13px;">@s.StaffName</strong>
                                        <div style="font-size:11px;color:var(--text-faint);">@@@s.Username</div>
                                    </div>
                                </div>
                            </td>
                            <td><span style="font-size:12px;color:var(--text-dim);">@s.Role</span></td>
                            <td style="text-align:center;">
                                <div style="display:flex;flex-direction:column;align-items:center;gap:3px;">
                                    <span class="badge" style="background:rgba(198,138,62,0.15);color:var(--brass-text);border:1px solid rgba(198,138,62,0.3);font-size:11px;padding:2px 7px;border-radius:5px;font-weight:600;">@s.BillsCreatedCount bills</span>
                                    @if (s.VouchersCreatedCount > 0)
                                    {
                                        <span class="badge" style="background:rgba(47,158,140,0.15);color:var(--teal-text);border:1px solid rgba(47,158,140,0.3);font-size:11px;padding:2px 7px;border-radius:5px;font-weight:600;" title="Standalone manual vouchers created without bill">@s.VouchersCreatedCount vouchers</span>
                                    }
                                </div>
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex;flex-direction:column;align-items:center;gap:3px;">
                                    <span class="badge" style="background:rgba(47,158,140,0.15);color:var(--teal-text);border:1px solid rgba(47,158,140,0.3);font-size:11px;padding:2px 7px;border-radius:5px;font-weight:600;">@s.BillsModifiedCount bills</span>
                                    @if (s.VouchersModifiedCount > 0)
                                    {
                                        <span class="badge" style="background:rgba(198,138,62,0.15);color:var(--brass-text);border:1px solid rgba(198,138,62,0.3);font-size:11px;padding:2px 7px;border-radius:5px;font-weight:600;" title="Standalone manual vouchers modified">@s.VouchersModifiedCount vouchers</span>
                                    }
                                </div>
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                                    <strong><span class="badge gray" style="font-size:11.5px;padding:3px 8px;">@s.TotalHandled total</span></strong>
                                    @if (s.TotalVouchersHandled > 0 && s.TotalBillsHandled > 0)
                                    {
                                        <span style="font-size:10px;color:var(--text-faint);">(@s.TotalBillsHandled b · @s.TotalVouchersHandled vc)</span>
                                    }
                                </div>
                            </td>
                            <td style="text-align:right;">
                                <div class="tnum font-weight-bold" style="color:var(--text);">Rs @s.TotalSalesVolume.ToString("N0")</div>
                                @if (s.TotalVouchersVolume > 0)
                                {
                                    <div class="tnum" style="font-size:10.5px;color:var(--teal-text);" title="Total volume of standalone manual vouchers">
                                        Vc: Rs @s.TotalVouchersVolume.ToString("N0")
                                    </div>
                                }
                            </td>
                            <td class="tnum" style="text-align:right;color:var(--brass-text);font-weight:600;padding-right:16px;white-space:nowrap;">Rs @s.TotalCommission.ToString("N0")</td>
                            <td style="font-size:11.5px;color:var(--text-dim);text-align:center;white-space:nowrap;padding:0 12px;">@s.LastActivity</td>
                            <td style="text-align:center;">
                                <button type="button" class="btn ghost icon-only" title="Expand / View Bills &amp; Vouchers" onclick="toggleStaffDetails(@s.StaffId, document.getElementById('staffExpandBtn_@s.StaffId'))" style="padding:4px 8px;color:var(--teal-text);">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </td>
                        </tr>

                        <!-- Expandable Sub-table Row for Bills and Vouchers Worked On by this Staff Member -->
                        <tr class="staff-expand-row" id="staffDetails_@s.StaffId" style="display:none;">
                            <td colspan="10" style="padding:0;background:var(--bg);">
                                <div class="staff-expand-card">
                                    <!-- Expand Card Header -->
                                    <div class="staff-expand-header">
                                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                            <span class="badge brass" style="font-family:monospace;font-size:12.5px;font-weight:700;">@s.StaffName</span>
                                            <span class="badge gray" style="font-size:11.5px;">@s.Role</span>
                                            <span style="font-size:12px;color:var(--text-dim);">
                                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                                Audit: @s.BillsWorkedOn.Count Bills · @s.ManualVouchers.Count Manual Vouchers
                                            </span>
                                        </div>
                                        <div style="font-size:12px;color:var(--text-dim);">
                                            Audit Tracking: <code style="color:var(--brass-text);">CreatedBy</code> &amp; <code style="color:var(--teal-text);">ModifiedBy</code>
                                        </div>
                                    </div>

                                    <!-- 1. Sub-table of Bills Worked On -->
                                    <div style="font-size:12.5px;font-weight:600;color:var(--text-dim);margin:12px 0 6px 0;display:flex;align-items:center;gap:6px;">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                        Bills Worked On (@s.BillsWorkedOn.Count records)
                                    </div>

                                    @if (s.BillsWorkedOn != null && s.BillsWorkedOn.Any())
                                    {
                                        <div style="overflow-x:auto;">
                                            <table style="width:100%;font-size:12px;border-collapse:collapse;background:var(--surface);border:1px solid var(--border);border-radius:6px;">
                                                <thead>
                                                    <tr style="border-bottom:1px solid var(--border);background:var(--surface2);">
                                                        <th style="padding:8px 10px;text-align:center;width:35px;">#</th>
                                                        <th style="padding:8px 10px;width:100px;">BILL #</th>
                                                        <th style="padding:8px 10px;width:100px;">DATE</th>
                                                        <th style="padding:8px 10px;">SUPPLIER (BOAT / FARMER)</th>
                                                        <th style="padding:8px 10px;text-align:center;width:70px;">LOTS</th>
                                                        <th style="padding:8px 10px;text-align:right;width:110px;">TOTAL SALE</th>
                                                        <th style="padding:8px 10px;text-align:right;width:100px;">COMMISSION</th>
                                                        <th style="padding:8px 10px;text-align:right;width:110px;">NET PAYABLE</th>
                                                        <th style="padding:8px 10px;text-align:center;width:130px;">ACTIVITY</th>
                                                        <th style="padding:8px 10px;width:150px;">TIMESTAMP</th>
                                                        <th style="padding:8px 10px;text-align:center;width:80px;">STATUS</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{ int itemIdx = 1; }
                                                    @foreach (var bill in s.BillsWorkedOn)
                                                    {
                                                        var billKey = $"{s.StaffId}_{bill.BillNo}";
                                                        var hasVouchers = bill.LinkedVouchers != null && bill.LinkedVouchers.Any();
                                                        <tr style="border-bottom:1px solid var(--border-soft);">
                                                            <td style="padding:8px 10px;text-align:center;color:var(--text-faint);">@itemIdx</td>
                                                            <td style="padding:8px 10px;">
                                                                <div style="display:flex;align-items:center;gap:6px;">
                                                                    @if (hasVouchers)
                                                                    {
