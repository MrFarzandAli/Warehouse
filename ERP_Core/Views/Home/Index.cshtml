                                                                            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                                                                        </button>
                                                                        <span class="badge brass" style="font-family:monospace;font-weight:700;cursor:pointer;" onclick="toggleBillVouchers('@billKey', document.getElementById('billExpandBtn_@billKey'))">
                                                                            @bill.BillNo
                                                                        </span>
                                                                        <span class="badge" style="background:rgba(47,158,140,0.15);color:var(--teal-text);font-size:10px;padding:1px 6px;cursor:pointer;border:1px solid rgba(47,158,140,0.3);" onclick="toggleBillVouchers('@billKey', document.getElementById('billExpandBtn_@billKey'))" title="Click to view @bill.LinkedVouchers.Count linked vouchers">
                                                                            @bill.LinkedVouchers.Count vc ▾
                                                                        </span>
                                                                    }
                                                                    else
