                                        <td class="tnum font-weight-bold" style="color:var(--green-text);">Rs ${Number(b.netPayable || 0).toLocaleString('en-US')}</td>
                                        <td><span class="stamp ${statusClass}"><span class="ring"></span><span>${escapeHtml(status.toUpperCase())}</span></span></td>
                                    </tr>
                                `;
