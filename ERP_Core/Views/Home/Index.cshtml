@section Scripts {
<script>
    // Global Accordion Helpers (Immediately available)
    window.toggleStaffDetails = function (staffId, btn) {
        const detailRow = document.getElementById('staffDetails_' + staffId);
        if (!detailRow) return;
        const expandBtn = btn || document.getElementById('staffExpandBtn_' + staffId);
        const isHidden = window.getComputedStyle(detailRow).display === 'none' || detailRow.style.display === 'none';
        if (isHidden) {
            detailRow.style.display = 'table-row';
            if (expandBtn) expandBtn.classList.add('expanded');
        } else {
            detailRow.style.display = 'none';
            if (expandBtn) expandBtn.classList.remove('expanded');
        }
    };

    window.toggleBillVouchers = function (key, btn) {
        const row = document.getElementById('billVouchers_' + key);
        if (!row) return;
        const expandBtn = btn || document.getElementById('billExpandBtn_' + key);
        const isHidden = window.getComputedStyle(row).display === 'none' || row.style.display === 'none';
        if (isHidden) {
            row.style.display = 'table-row';
            if (expandBtn) expandBtn.classList.add('expanded');
        } else {
            row.style.display = 'none';
            if (expandBtn) expandBtn.classList.remove('expanded');
        }
    };

    window.handleFilterSubmit = function (e) {
        if (e && e.preventDefault) e.preventDefault();
        if (typeof window.applyDashboardFilter === 'function') {
            window.applyDashboardFilter();
        } else {
            const form = document.getElementById('dashFilterForm');
            if (form) form.submit();
        }
        return false;
    };

    (function () {
        const sel = document.getElementById('dashDurationSelect');
        const fromInput = document.getElementById('dashFromDate');
        const toInput = document.getElementById('dashToDate');
        const trendTitle = document.getElementById('trendCardTitle');
        const weeklyBars = document.getElementById('weeklyBars');
        const monthlyBars = document.getElementById('monthlyBars');

        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

        function pad2(n) {
            return n < 10 ? '0' + n : n;
        }

        function formatDateOnly(d) {
            const day = pad2(d.getDate());
            const mon = monthNames[d.getMonth()];
            const year = d.getFullYear();
            return `${day}-${mon}-${year}`;
        }

        function formatDateTime(d) {
            const dateStr = formatDateOnly(d);
            const hours = pad2(d.getHours());
            const mins = pad2(d.getMinutes());
            return `${dateStr} ${hours}:${mins}`;
        }

        function formatIsoDate(d) {
            return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
        }

        function formatIsoDateFromDisplay(str) {
            if (!str) return '';
            if (str.indexOf('-') > 0 && str.length === 10 && str.split('-')[0].length === 4) {
                return str;
            }
            const parts = str.trim().split(/[- /]/);
            if (parts.length >= 3) {
                const day = parts[0];
                const monStr = parts[1].toLowerCase();
                const year = parts[2];
                const mIdx = monthNames.findIndex(m => m.toLowerCase() === monStr);
                if (mIdx !== -1) {
                    return `${year}-${pad2(mIdx + 1)}-${pad2(parseInt(day, 10))}`;
                }
            }
            return str;
        }

        function updateDurationInputs() {
            if (!sel || !fromInput || !toInput) return;

            const val = sel.value;
            const now = new Date();

            // Toggle Weekly vs Monthly Graph dynamically
            if (val === 'month') {
                if (trendTitle) trendTitle.textContent = 'Monthly commission trend';
                if (weeklyBars) weeklyBars.style.display = 'none';
                if (monthlyBars) monthlyBars.style.display = 'flex';
            } else {
                if (trendTitle) trendTitle.textContent = 'Weekly commission trend';
                if (weeklyBars) weeklyBars.style.display = 'flex';
                if (monthlyBars) monthlyBars.style.display = 'none';
            }

            if (val === 'custom_date') {
                // Selectable calendar mode
                let currentFrom = (fromInput.dataset && fromInput.dataset.isoDate) 
                    ? fromInput.dataset.isoDate 
                    : formatIsoDateFromDisplay(fromInput.value);
                let currentTo = (toInput.dataset && toInput.dataset.isoDate) 
                    ? toInput.dataset.isoDate 
                    : formatIsoDateFromDisplay(toInput.value);

                fromInput.type = 'date';
                toInput.type = 'date';
                fromInput.removeAttribute('readonly');
                toInput.removeAttribute('readonly');

                if (currentFrom && currentFrom.length === 10 && currentFrom.indexOf('-') === 4) {
                    fromInput.value = currentFrom;
                } else {
                    const defaultFrom = new Date();
                    defaultFrom.setDate(now.getDate() - 7);
                    fromInput.value = formatIsoDate(defaultFrom);
                }

                if (currentTo && currentTo.length === 10 && currentTo.indexOf('-') === 4) {
                    toInput.value = currentTo;
                } else {
                    toInput.value = formatIsoDate(now);
                }

                fromInput.dataset.isoDate = fromInput.value;
                toInput.dataset.isoDate = toInput.value;
            } else {
                // Predefined range modes (readonly text display)
                fromInput.type = 'text';
                toInput.type = 'text';
                fromInput.setAttribute('readonly', 'readonly');
                toInput.setAttribute('readonly', 'readonly');

                let fromDate = new Date();
                let toDate = new Date();

                if (val === 'today') {
                    // Display time along with date for today
                    fromDate.setHours(0, 0, 0, 0);
                    fromInput.value = formatDateTime(fromDate);
                    toInput.value = formatDateTime(toDate);
                    fromInput.dataset.isoDate = formatIsoDate(fromDate);
                    toInput.dataset.isoDate = formatIsoDate(toDate);
                    return;
                } else if (val === 'past_three_days') {
                    fromDate.setDate(now.getDate() - 3);
                } else if (val === 'past_week') {
                    fromDate.setDate(now.getDate() - 7);
                } else if (val === '14_days') {
                    fromDate.setDate(now.getDate() - 14);
                } else if (val === 'month') {
                    fromDate = new Date(now.getFullYear(), now.getMonth(), 1);
                }

                // Display date only for other predefined ranges
                fromInput.value = formatDateOnly(fromDate);
                toInput.value = formatDateOnly(toDate);
                fromInput.dataset.isoDate = formatIsoDate(fromDate);
                toInput.dataset.isoDate = formatIsoDate(toDate);
            }
        }

        let fetchAbortCtrl = null;
        function fetchDashboardSummaries() {
            const val = sel ? sel.value : 'today';
            let fromVal = '';
            let toVal = '';

            if (val === 'custom_date') {
                fromVal = (fromInput && fromInput.value) ? fromInput.value.trim() : (fromInput ? (fromInput.dataset.isoDate || '') : '');
                toVal = (toInput && toInput.value) ? toInput.value.trim() : (toInput ? (toInput.dataset.isoDate || '') : '');
                if (fromInput && fromVal) fromInput.dataset.isoDate = fromVal;
                if (toInput && toVal) toInput.dataset.isoDate = toVal;
            } else {
                fromVal = (fromInput && fromInput.dataset && fromInput.dataset.isoDate) 
                    ? fromInput.dataset.isoDate 
                    : formatIsoDateFromDisplay(fromInput ? fromInput.value : '');
                toVal = (toInput && toInput.dataset && toInput.dataset.isoDate) 
                    ? toInput.dataset.isoDate 
                    : formatIsoDateFromDisplay(toInput ? toInput.value : '');
            }

            // If custom range and both dates provided, ensure fromVal <= toVal
            if (val === 'custom_date' && fromVal && toVal && fromVal > toVal) {
                const temp = fromVal;
                fromVal = toVal;
                toVal = temp;
                if (fromInput) {
                    fromInput.value = fromVal;
                    fromInput.dataset.isoDate = fromVal;
                }
                if (toInput) {
                    toInput.value = toVal;
                    toInput.dataset.isoDate = toVal;
