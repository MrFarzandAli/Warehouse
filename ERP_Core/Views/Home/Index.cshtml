                                            </div>
                                            <div>
                                                <span class="meta-lbl">A/C No:</span>
                                                <span class="meta-val font-mono" style="color:var(--teal-text);">${escapeHtml(b.accountNo || '-')}</span>
                                            </div>
                                        </div>

                                        <div class="bank-balance-box">
                                            <div class="bal-lbl">AVAILABLE BALANCE IN ACCOUNT</div>
                                            <div class="bal-amount tnum font-weight-bold" style="color:${balColor};">
                                                Rs ${Number(b.currentBalance || 0).toLocaleString('en-US')}
                                            </div>
                                        </div>

                                        <div class="bank-flux-row">
                                            <div class="flux-item in">
                                                <span class="flux-lbl">Inflow (Wasooli / Dep)</span>
