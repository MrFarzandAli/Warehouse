                                                                else
                                                                {
                                                                    <span class="badge" style="background:rgba(47,158,140,0.18);color:var(--teal-text);border:1px solid var(--teal);font-size:10.5px;padding:2px 7px;">
                                                                        Modified (ترمیم)
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td style="padding:8px 10px;font-size:11px;color:var(--text-dim);">@bill.Timestamp</td>
