@model ERP_Core.Dtos.SupplierDistributionViewModel

@{
    ViewData["Title"] = "Farmer Child Distribution";
    ViewData["SubTitle"] = "Parent Farmer se amount minus karke child Farmers ke accounts me transfer karein.";
}

<!-- TomSelect CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />

<style>
    /* Clean Dark Theme Form Controls */
    .ts-wrapper .ts-control {
        background-color: var(--surface2, #1A2F2A) !important;
        border: 1px solid var(--border, #2C4740) !important;
        color: var(--text, #EAF1EE) !important;
        border-radius: 8px !important;
        font-size: 13px !important;
        min-height: 38px !important;
        padding: 6px 12px !important;
    }

    .ts-wrapper.focus .ts-control {
        border-color: var(--brass, #C68A3E) !important;
        box-shadow: 0 0 0 2px rgba(198, 138, 62, 0.25) !important;
    }

    .ts-wrapper .ts-control input {
        color: var(--text, #EAF1EE) !important;
    }

    .ts-dropdown {
        background-color: #0E1A17 !important;
        border: 1px solid var(--border, #2C4740) !important;
        border-radius: 8px !important;
        color: #EAF1EE !important;
        z-index: 999999 !important;
    }

    .ts-dropdown .option {
        color: #EAF1EE !important;
        padding: 8px 12px !important;
        font-size: 13px !important;
    }

    .ts-dropdown .option.active, .ts-dropdown .option:hover {
        background-color: #1B302B !important;
        color: var(--brass-text, #E3AE66) !important;
    }

    .ts-dropdown .option.selected {
        background-color: #2F6F5E !important;
        color: #FFFFFF !important;
    }

    .badge-soft-brass {
        background: rgba(198, 138, 62, 0.15);
        color: var(--brass-text, #E3AE66);
        border: 1px solid rgba(198, 138, 62, 0.3);
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-soft-green {
        background: rgba(46, 204, 113, 0.15);
        color: #2ECC71;
        border: 1px solid rgba(46, 204, 113, 0.3);
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-soft-blue {
        background: rgba(52, 152, 219, 0.15);
        color: #3498DB;
        border: 1px solid rgba(52, 152, 219, 0.3);
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    /* Print Slip Styles */
    @@media print {
        body * {
            visibility: hidden;
        }
        #printArea, #printArea * {
            visibility: visible;
        }
        #printArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: white !important;
            color: black !important;
            padding: 20px;
        }
    }
</style>

<!-- Toolbar -->
<div class="toolbar">
    <div>
        <div class="section-title" style="margin-bottom:2px;">Farmer Child Distribution</div>
        <div class="section-desc" style="margin-bottom:0;">Parent Farmer se amount minus karke child Farmers ke accounts me direct transfer karein.</div>
    </div>
    <button type="button" class="btn brass" onclick="toggleDistForm()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        <span id="btnToggleText">New Transfer</span>
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:var(--green-dim);color:var(--green-text);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid var(--border);">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background:rgba(239,68,68,0.15);color:var(--red-text,#ef4444);padding:10px 14px;border-radius:8px;font-size:12.5px;margin-bottom:18px;border:1px solid rgba(239,68,68,0.3);">
        @TempData["ErrorMessage"]
    </div>
}

<!-- ========================================================================= -->
<!-- 1. ENTRY FORM (SIMPLE & CLEAN)                                           -->
<!-- ========================================================================= -->
<div class="form-card" id="distFormCard" style="display:block;margin-bottom:20px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:10px;">
            <span style="font-size:14px;font-weight:600;color:var(--text);" id="formTitle">Add Farmer Distribution</span>
            <span class="badge-soft-brass">Doc #: <strong id="docNoSpan">@Model.DistributionNo</strong></span>
        </div>
        <button type="button" class="btn ghost" onclick="resetForm()" style="padding:4px 10px;font-size:12px;">Reset</button>
    </div>

    <form asp-controller="SupplierDistribution" asp-action="SaveDistribution" method="post" id="mainDistForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" id="formId" value="0" />
        <input type="hidden" name="DistributionNo" id="formDistributionNo" value="@Model.DistributionNo" />

        <!-- Master Fields: Date, Parent Supplier, Remarks -->
        <div class="form-grid c3" style="margin-bottom:14px;">
            <div class="field">
                <label>Date <span style="color:var(--red-text);">*</span></label>
                <input type="date" name="Date" id="txDate" value="@Model.Date" required />
            </div>

            <div class="field">
                <label>Parent Farmer (Kashti / Boat / Farmer) <span style="color:var(--red-text);">*</span></label>
                <select name="SelectedParentSupplierId" id="parentSupplierSelect" required>
                    <option value="">-- Select Parent Farmer --</option>
                    @foreach (var p in Model.ParentSuppliersList)
                    {
                        <option value="@p.Id" data-code="@p.Code" data-phone="@p.Phone" data-city="@p.CityOrVillage">
                            @p.Name @(!string.IsNullOrEmpty(p.Code) ? $"({p.Code})" : "") @(!string.IsNullOrEmpty(p.CityOrVillage) ? $"- {p.CityOrVillage}" : "")
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Narration / Remarks</label>
                <input type="text" name="Remarks" id="formRemarks" placeholder="e.g. Boat crew settlement / mallah hisaab" />
            </div>
        </div>

        <!-- Live Parent Balance Info Banner -->
        <div id="parentInfoBanner" style="display:none;background:var(--surface2);border:1px solid var(--border);border-left:3px solid var(--brass);border-radius:8px;padding:10px 14px;margin-bottom:16px;">
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
                <div>
                    <strong style="color:var(--text);font-size:13.5px;" id="parentNameDisplay">-</strong>
                    <span style="color:var(--text-faint);font-size:12px;margin-left:8px;" id="parentMetaDisplay">Code: - | Phone: -</span>
                </div>
                <div style="display:flex;align-items:center;gap:14px;">
                    <span style="font-size:12px;color:var(--text-dim);">Current Balance: <strong style="color:var(--brass-text);font-size:14px;" id="parentBalDisplay">Rs 0</strong></span>
                    <span class="badge-soft-blue" id="parentChildrenCountBadge">0 Linked Child(ren)</span>
                </div>
            </div>
        </div>

        <!-- Child Suppliers Table -->
        <div style="margin-top:16px;margin-bottom:16px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <label style="font-size:13px;font-weight:600;color:var(--brass-text);margin:0;">Child Farmers Breakdown</label>
                <button type="button" class="btn ghost" onclick="addChildRow()" style="padding:3px 10px;font-size:12px;border:1px solid var(--border);">
                    + Add Row
                </button>
            </div>

            <div class="table-wrap" style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;">
                <table style="width:100%;font-size:13px;">
                    <thead>
                        <tr>
                            <th style="width:40px;text-align:center;">#</th>
                            <th style="min-width:280px;">Child Farmer (Kashti Wala / Crew) <span style="color:var(--red-text);">*</span></th>
                            <th style="width:140px;text-align:right;">Current Balance</th>
                            <th style="width:180px;text-align:right;">Amount (Rs) <span style="color:var(--red-text);">*</span></th>
                            <th style="min-width:200px;">Remarks</th>
                            <th style="width:40px;text-align:center;"></th>
                        </tr>
                    </thead>
                    <tbody id="childrenTableBody">
                        <tr id="emptyPlaceholder">
                            <td colspan="6" style="text-align:center;padding:24px;color:var(--text-faint);">
                                Select a Parent Farmer to load linked child Farmers, or click <strong>+ Add Row</strong>.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bottom Total & Action Buttons -->
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding-top:12px;border-top:1px solid var(--border);">
            <div style="display:flex;align-items:center;gap:20px;">
                <div>
                    <span style="font-size:12px;color:var(--text-faint);">Total Deducted from Parent:</span>
                    <strong style="color:var(--red-text,#ef4444);font-size:16px;margin-left:6px;" id="totalAmountDisplay">Rs 0</strong>
                </div>
                <div>
                    <span style="font-size:12px;color:var(--text-faint);">Parent Remaining Balance:</span>
                    <strong style="color:var(--brass-text);font-size:15px;margin-left:6px;" id="remainingBalDisplay">Rs 0</strong>
                </div>
            </div>
            <div style="display:flex;gap:8px;">
                <button type="button" class="btn ghost" onclick="toggleDistForm()">Cancel</button>
                <button type="submit" class="btn brass" id="btnSave">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Save & Post JV
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ========================================================================= -->
<!-- 2. RECENT DISTRIBUTION HISTORY                                           -->
<!-- ========================================================================= -->
<div class="card" id="historyCard">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:10px;">
        <span style="font-size:14px;font-weight:600;color:var(--text);">Transfer History (@Model.RecentDistributions.Count records)</span>
        <form asp-controller="SupplierDistribution" asp-action="Index" method="get" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <input type="date" name="fromDate" value="@Model.FromDate" style="height:32px;padding:4px 8px;font-size:12px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);" />
            <input type="date" name="toDate" value="@Model.ToDate" style="height:32px;padding:4px 8px;font-size:12px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);" />
            <select name="parentSupplierId" style="height:32px;padding:4px 8px;font-size:12px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);">
                <option value="">-- All Parents --</option>
                @foreach (var p in Model.ParentSuppliersList)
                {
                    if (Model.FilterParentId == p.Id)
                    {
                        <option value="@p.Id" selected>@p.Name</option>
                    }
                    else
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                }
            </select>
            <button type="submit" class="btn brass" style="height:32px;padding:0 12px;font-size:12px;">Filter</button>
            <a asp-action="Index" class="btn ghost" style="height:32px;padding:0 10px;font-size:12px;border:1px solid var(--border);">Reset</a>
        </form>
    </div>

    <div class="table-wrap">
        <table class="dynamic-table">
            <thead>
                <tr>
                    <th style="width:110px;">Doc #</th>
                    <th style="width:110px;">Date</th>
                    <th>Parent Farmer (Debit)</th>
                    <th style="text-align:center;width:120px;">Children</th>
                    <th style="text-align:right;width:140px;">Amount (Rs)</th>
                    <th style="width:110px;">Voucher #</th>
                    <th>Remarks</th>
                    <th style="width:90px;text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentDistributions != null && Model.RecentDistributions.Any())
                {
                    @foreach (var item in Model.RecentDistributions)
                    {
                        <tr>
                            <td><strong style="color:var(--brass-text);">@item.DistributionNo</strong></td>
                            <td>@item.DateStr</td>
                            <td>
                                <div><strong>@item.ParentSupplierName</strong></div>
                                @if (!string.IsNullOrEmpty(item.ParentAccountCode))
                                {
                                    <small style="color:var(--text-faint);">Acc: @item.ParentAccountCode</small>
                                }
                            </td>
                            <td style="text-align:center;">
                                <span class="badge-soft-brass">@item.ChildrenCount Child(ren)</span>
                            </td>
                            <td style="text-align:right;font-weight:700;color:var(--green-text);">
                                Rs @item.TotalAmount.ToString("N0")
                            </td>
                            <td>
                                <span class="badge-soft-blue">@(item.VoucherNo ?? "JV")</span>
                            </td>
                            <td style="font-size:12px;color:var(--text-dim);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)
                            </td>
                            <td style="text-align:center;">
                                <div style="display:inline-flex;gap:4px;">
                                    <button type="button" class="btn ghost" style="padding:3px 6px;font-size:11px;" title="Print Slip" onclick="printDistributionSlip(@item.Id)">
                                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                    </button>
                                    <form asp-controller="SupplierDistribution" asp-action="DeleteDistribution" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this distribution and reverse the JV?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn ghost" style="padding:3px 6px;font-size:11px;color:var(--red-text);" title="Delete">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:24px;color:var(--text-faint);">
                            No distributions found for the selected period.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Print Slip Area -->
<div id="printArea" style="display:none;"></div>

<!-- TomSelect JS -->
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<script>
    const rawChildSuppliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllChildSuppliers));
    
    // Normalize data properties to handle both camelCase and PascalCase
    const allChildSuppliersData = (rawChildSuppliers || []).map(c => ({
        id: c.Id ?? c.id,
        name: c.Name ?? c.name ?? '',
        code: c.Code ?? c.code ?? '',
        phone: c.Phone ?? c.phone ?? '',
        city: c.City ?? c.city ?? '',
        parentSupplierId: c.ParentSupplierId ?? c.parentSupplierId ?? null,
        parentSupplierName: c.ParentSupplierName ?? c.parentSupplierName ?? '',
        currentBalance: c.CurrentBalance ?? c.currentBalance ?? 0
    }));

    let parentTomSelect = null;
    let currentParentBalance = 0;
    let currentParentLinkedChildren = [];
    let rowCounter = 0;

    document.addEventListener("DOMContentLoaded", function () {
        initParentSelect();
    });

    function initParentSelect() {
        parentTomSelect = new TomSelect("#parentSupplierSelect", {
            create: false,
            placeholder: "-- Select Parent Farmer --",
            onChange: function (value) {
                if (value && value > 0) {
                    loadParentSupplierDetails(value);
                } else {
                    hideParentInfo();
                }
            }
        });
    }

    function toggleDistForm() {
        const formCard = document.getElementById("distFormCard");
        if (formCard.style.display === "none") {
            formCard.style.display = "block";
            document.getElementById("btnToggleText").innerText = "Close Form";
            formCard.scrollIntoView({ behavior: 'smooth' });
        } else {
            formCard.style.display = "none";
            document.getElementById("btnToggleText").innerText = "New Transfer";
        }
    }

    function hideParentInfo() {
        document.getElementById("parentInfoBanner").style.display = "none";
        currentParentLinkedChildren = [];
        document.getElementById("childrenTableBody").innerHTML = `
            <tr id="emptyPlaceholder">
                <td colspan="6" style="text-align:center;padding:24px;color:var(--text-faint);">
                    Select a Parent Farmer to load linked child Farmers, or click <strong>+ Add Row</strong>.
                </td>
            </tr>`;
        currentParentBalance = 0;
        recalculateTotals();
    }

    async function loadParentSupplierDetails(parentId) {
        try {
            const response = await fetch(`/SupplierDistribution/GetParentSupplierDetails?parentSupplierId=${parentId}`);
            const result = await response.json();

            if (result.success && result.data) {
                const parent = result.data;
                currentParentBalance = (parent.currentBalance !== undefined ? parent.currentBalance : parent.CurrentBalance) || 0;
                const pName = parent.name || parent.Name || '-';
                const pCode = parent.code || parent.Code || '-';
                const pPhone = parent.phone || parent.Phone || '-';
                const pCity = parent.city || parent.City || '-';
                const rawChildren = parent.linkedChildren || parent.LinkedChildren || [];

                currentParentLinkedChildren = rawChildren.map(c => ({
                    id: c.id ?? c.Id,
                    name: c.name ?? c.Name ?? '',
                    code: c.code ?? c.Code ?? '',
                    phone: c.phone ?? c.Phone ?? '',
                    city: c.city ?? c.City ?? '',
                    currentBalance: c.currentBalance ?? c.CurrentBalance ?? 0
                }));

                // Update Parent Info Banner
                document.getElementById("parentNameDisplay").innerText = pName;
                document.getElementById("parentMetaDisplay").innerText = `Code: ${pCode} | Phone: ${pPhone} | City: ${pCity}`;
                document.getElementById("parentBalDisplay").innerText = `Rs ${Number(currentParentBalance).toLocaleString('en-US')}`;
                document.getElementById("parentChildrenCountBadge").innerText = `${currentParentLinkedChildren.length} Linked Child(ren)`;
                document.getElementById("parentInfoBanner").style.display = "block";

                // Reset Children Table and add one initial row for manual selection
                const tbody = document.getElementById("childrenTableBody");
                tbody.innerHTML = "";
                rowCounter = 0;

                addChildRow();

                recalculateTotals();
            } else {
                alert(result.message || "Failed to load parent Farmer details.");
            }
        } catch (e) {
            console.error("Error loading parent details:", e);
        }
    }

    function addChildRow(selectedChildId = null, initialBalance = null) {
        const parentId = parentTomSelect ? parentTomSelect.getValue() : null;
        if (!parentId && !selectedChildId) {
            alert("Please select a Parent Farmer first.");
            return;
        }

        const placeholder = document.getElementById("emptyPlaceholder");
        if (placeholder) placeholder.remove();

        const tbody = document.getElementById("childrenTableBody");
        const rowIndex = rowCounter++;

        const tr = document.createElement("tr");
        tr.id = `childRow_${rowIndex}`;

        let optionsHtml = `<option value="">-- Select Child Farmer --</option>`;
        if (currentParentLinkedChildren && currentParentLinkedChildren.length > 0) {
            currentParentLinkedChildren.forEach(c => {
                const isSel = (selectedChildId && Number(c.id) === Number(selectedChildId)) ? "selected" : "";
                const codeTxt = c.code ? ` (${c.code})` : "";
                const displayName = c.name ? `${c.name}${codeTxt}` : `Child #${c.id}`;
                optionsHtml += `<option value="${c.id}" ${isSel} data-balance="${c.currentBalance || 0}">${displayName}</option>`;
            });
        } else {
            optionsHtml += `<option value="" disabled>No child Farmers linked to this parent</option>`;
        }

        const displayBal = initialBalance !== null ? Number(initialBalance).toLocaleString('en-US') : "0";

        tr.innerHTML = `
            <td style="text-align:center;font-weight:600;color:var(--text-faint);" class="row-num">${tbody.children.length + 1}</td>
            <td>
                <select name="DistributionItems[${rowIndex}].ChildSupplierId" class="form-select form-select-sm" required onchange="onChildSelected(this, ${rowIndex})"
                        style="height:34px;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:12.5px;width:100%;padding:4px 8px;">
                    ${optionsHtml}
                </select>
            </td>
            <td style="text-align:right;">
                <span class="badge-soft-brass" id="childBalBadge_${rowIndex}">Rs ${displayBal}</span>
            </td>
            <td>
                <input type="number" name="DistributionItems[${rowIndex}].Amount" class="child-amount" min="1" step="any" placeholder="0" required oninput="recalculateTotals()"
                       style="height:34px;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--green-text);font-weight:700;font-size:13px;width:100%;text-align:right;padding:4px 8px;" />
            </td>
            <td>
                <input type="text" name="DistributionItems[${rowIndex}].Remarks" placeholder="Remarks / Note"
                       style="height:34px;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:12px;width:100%;padding:4px 8px;" />
            </td>
            <td style="text-align:center;">
                <button type="button" class="btn ghost" style="padding:2px 6px;color:var(--red-text);" title="Remove Row" onclick="removeChildRow(${rowIndex})">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </td>
        `;

        tbody.appendChild(tr);
        updateRowNumbers();
    }

    function removeChildRow(rowIndex) {
        const row = document.getElementById(`childRow_${rowIndex}`);
        if (row) {
            row.remove();
            updateRowNumbers();
            recalculateTotals();
        }
    }

    function updateRowNumbers() {
        const tbody = document.getElementById("childrenTableBody");
        const rows = tbody.querySelectorAll("tr");
        rows.forEach((r, idx) => {
            const numCell = r.querySelector(".row-num");
            if (numCell) numCell.innerText = idx + 1;
        });
    }

    function onChildSelected(selectEl, rowIndex) {
        const val = selectEl.value;
        const badge = document.getElementById(`childBalBadge_${rowIndex}`);
        if (!val) {
            if (badge) badge.innerText = "Rs 0";
            return;
        }

        const matched = currentParentLinkedChildren.find(c => Number(c.id) === Number(val));
        const bal = matched ? matched.currentBalance : (selectEl.options[selectEl.selectedIndex]?.getAttribute("data-balance") || 0);
        if (badge) {
            badge.innerText = `Rs ${Number(bal).toLocaleString('en-US')}`;
        }
    }

    function recalculateTotals() {
        const amountInputs = document.querySelectorAll(".child-amount");
        let totalTransfer = 0;

        amountInputs.forEach(input => {
            const val = parseFloat(input.value) || 0;
            totalTransfer += val;
        });

        const remainingParent = currentParentBalance - totalTransfer;

        document.getElementById("totalAmountDisplay").innerText = `Rs ${totalTransfer.toLocaleString('en-US')}`;
        document.getElementById("remainingBalDisplay").innerText = `Rs ${remainingParent.toLocaleString('en-US')}`;

        const remEl = document.getElementById("remainingBalDisplay");
        if (remainingParent < 0) {
            remEl.style.color = "var(--red-text, #ef4444)";
        } else {
            remEl.style.color = "var(--brass-text)";
        }
    }

    function resetForm() {
        document.getElementById("mainDistForm").reset();
        if (parentTomSelect) {
            parentTomSelect.clear();
        }
        hideParentInfo();
    }

    async function printDistributionSlip(id) {
        try {
            const response = await fetch(`/SupplierDistribution/GetDistributionDetails?id=${id}`);
            const result = await response.json();

            if (result.success && result.data) {
                const dist = result.data;
                let rowsHtml = "";
                dist.details.forEach((d, idx) => {
                    rowsHtml += `
                        <tr style="border-bottom:1px solid #ddd;">
                            <td style="text-align:center;padding:8px;">${idx + 1}</td>
                            <td style="padding:8px;"><strong>${d.childSupplierName}</strong> ${d.accountCode ? `(${d.accountCode})` : ''}</td>
                            <td style="text-align:right;padding:8px;font-weight:bold;">Rs ${Number(d.amount).toLocaleString('en-US')}</td>
                            <td style="padding:8px;">${d.remarks || '-'}</td>
                        </tr>
                    `;
                });

                const printContent = `
                    <div style="font-family:Arial, sans-serif;max-width:800px;margin:0 auto;color:#111;padding:20px;">
                        <div style="text-align:center;border-bottom:2px solid #333;padding-bottom:12px;margin-bottom:16px;">
                            <h2 style="margin:0;text-transform:uppercase;letter-spacing:1px;">Farmer BALANCE DISTRIBUTION VOUCHER</h2>
                            <p style="margin:4px 0 0 0;color:#555;font-size:13px;">Parent Farmer to Partner Farmer Account Transfer</p>
                        </div>

                        <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-size:13px;">
                            <div>
                                <div><strong>Distribution Doc #:</strong> ${dist.distributionNo}</div>
                                <div><strong>Parent Farmer (Debit):</strong> ${dist.parentSupplierName} ${dist.parentAccountCode ? `(${dist.parentAccountCode})` : ''}</div>
                                <div><strong>Remarks:</strong> ${dist.remarks || '-'}</div>
                            </div>
                            <div style="text-align:right;">
                                <div><strong>Date:</strong> ${dist.dateStr}</div>
                                <div><strong>JV Voucher #:</strong> ${dist.voucherNo || 'JV'}</div>
                                <div><strong>Total Amount:</strong> <span style="font-size:15px;font-weight:bold;">Rs ${Number(dist.totalAmount).toLocaleString('en-US')}</span></div>
                            </div>
                        </div>

                        <table style="width:100%;border-collapse:collapse;margin-bottom:30px;font-size:13px;">
                            <thead>
                                <tr style="background:#f2f2f2;border-bottom:2px solid #333;text-align:left;">
                                    <th style="padding:8px;text-align:center;width:40px;">#</th>
                                    <th style="padding:8px;">Partner Farmer (Credit)</th>
                                    <th style="padding:8px;text-align:right;width:160px;">Amount (Rs)</th>
                                    <th style="padding:8px;">Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${rowsHtml}
                            </tbody>
                            <tfoot>
                                <tr style="border-top:2px solid #333;font-weight:bold;background:#f9f9f9;">
                                    <td colspan="2" style="padding:10px;text-align:right;">TOTAL AMOUNT LESS FROM PARENT:</td>
                                    <td style="padding:10px;text-align:right;font-size:14px;">Rs ${Number(dist.totalAmount).toLocaleString('en-US')}</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div style="margin-top:60px;display:flex;justify-content:space-between;font-size:12px;text-align:center;">
                            <div style="border-top:1px solid #333;width:180px;padding-top:6px;">
                                Parent Farmer Signature
                            </div>
                            <div style="border-top:1px solid #333;width:180px;padding-top:6px;">
                                Accountant / Munshi
                            </div>
                            <div style="border-top:1px solid #333;width:180px;padding-top:6px;">
                                Authorized Manager
                            </div>
                        </div>
                    </div>
                `;

                const printArea = document.getElementById("printArea");
                printArea.innerHTML = printContent;
                printArea.style.display = "block";
                window.print();
                printArea.style.display = "none";
            }
        } catch (e) {
            console.error("Error printing slip:", e);
        }
    }
</script>
