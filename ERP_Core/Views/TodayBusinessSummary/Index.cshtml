    <button type="button" class="summary-tab-btn" id="btn-tab-pays" onclick="switchSummaryTab('tab-pays')">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        <span>Pays (Adaigi)</span>
        <span class="tab-badge">@Model.PaysAccountsCount</span>
    </button>
    <button type="button" class="summary-tab-btn" id="btn-tab-expenses" onclick="switchSummaryTab('tab-expenses')">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        <span>Expense Vouchers</span>
        <span class="tab-badge">@Model.TotalExpenseVouchersCount</span>
    </button>
    <button type="button" class="summary-tab-btn" id="btn-tab-commission" onclick="switchSummaryTab('tab-commission')">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
        <span>Commission</span>
        <span class="tab-badge">@Model.TotalBillsCount</span>
    </button>
    <button type="button" class="summary-tab-btn" id="btn-tab-martey" onclick="switchSummaryTab('tab-martey')">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
        <span>Martey (Deposit)</span>
        <span class="tab-badge">@Model.MarteyCount</span>
    </button>
    <button type="button" class="summary-tab-btn" id="btn-tab-parties" onclick="switchSummaryTab('tab-parties')">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1.5"/><path d="M16 8h4l3 3v5h-7V8Z"/></svg>
        <span>Farmer &amp; Supplier Balances</span>
    </button>
    <button type="button" class="summary-tab-btn" id="btn-tab-icelabour" onclick="switchSummaryTab('tab-icelabour')">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m10 15 5 5 3-3-5-5"/><path d="M4 20h7"/></svg>
        <span>Ice &amp; Labour Breakdown</span>
    </button>
</div>

<!-- ========================================================================= -->
<!-- TAB 1: OVERVIEW & AUDIT SUMMARY                                           -->
<!-- ========================================================================= -->
<div class="summary-tab-pane active" id="tab-overview">
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:20px;">
        
        <!-- Cash / Bank Liquidity Flux Box -->
        <div class="summary-table-card" style="margin:0;">
            <div class="summary-table-head">
                <h4 class="summary-table-title" style="color:var(--teal-text);">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M3 10h18"/><path d="m12 3 9 7H3z"/></svg>
                    Period Inflow &amp; Outflow Balance
                </h4>
            </div>
            <div style="padding:16px;">
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft);">
                    <span style="font-size:13px; color:var(--text-dim);">Total Receives (Cash + Bank Wasooli):</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--kpi-receives);">+ Rs @Model.TotalReceivesAmount.ToString("N0")</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft);">
                    <span style="font-size:13px; color:var(--text-dim);">Total Payments (Party Adaigi):</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--kpi-pays);">- Rs @Model.TotalPaysAmount.ToString("N0")</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft);">
                    <span style="font-size:13px; color:var(--text-dim);">Total Expense Vouchers (Aam Kharche):</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--kpi-expense);">- Rs @Model.TotalExpenseVouchersAmount.ToString("N0")</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0 0 0;">
                    <span style="font-size:13.5px; font-weight:700; color:var(--text);">Net Cash Flow in Period:</span>
                    <span class="tnum" style="font-size:16px; font-weight:700; color:@(Model.NetCashFlowToday >= 0 ? "var(--kpi-receives)" : "var(--kpi-pays)");">
                        @(Model.NetCashFlowToday >= 0 ? "+" : "") Rs @Model.NetCashFlowToday.ToString("N0")
                    </span>
                </div>
            </div>
        </div>

        <!-- Mandi Catch & Commission Box -->
        <div class="summary-table-card" style="margin:0;">
            <div class="summary-table-head">
                <h4 class="summary-table-title" style="color:var(--brass-text);">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12c4-5 11-7 16-4.5C18 7.5 17 12 18 16.5 13 19 6 17 2 12Z"/><path d="M18 7.5 22 5l-1 7 1 7-4-2.5"/></svg>
                    Catch Bills &amp; Commission Summary
                </h4>
            </div>
            <div style="padding:16px;">
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft);">
                    <span style="font-size:13px; color:var(--text-dim);">Total Catch Bills Recorded:</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--text);">@Model.TotalBillsCount bills</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft);">
                    <span style="font-size:13px; color:var(--text-dim);">Total Gross Catch Volume (Sale):</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--text);">Rs @Model.TotalCatchGrossAmount.ToString("N0")</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft);">
                    <span style="font-size:13px; color:var(--text-dim);">Commission Earned (Aarhat Munafa):</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--kpi-comm);">Rs @Model.TotalCommissionAmount.ToString("N0")</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft);">
                    <span style="font-size:13px; color:var(--text-dim);">Total Martey / Deposit Deducted:</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--kpi-martey);">Rs @Model.TotalMarteyAmount.ToString("N0")</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0 0 0;">
                    <span style="font-size:13.5px; font-weight:700; color:var(--text);">Net Farmer Bills Payable (Today):</span>
                    <span class="tnum" style="font-size:15px; font-weight:700; color:var(--kpi-farmer);">Rs @Model.TodayFarmerBillsPayable.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Side by Side: Top Receives Accounts vs Top Pays Accounts -->
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
        
        <!-- Top Receives Summary -->
        <div class="summary-table-card">
            <div class="summary-table-head">
                <h4 class="summary-table-title" style="color:var(--kpi-receives);">Top Accounts Wasooli</h4>
                <a href="javascript:void(0)" onclick="switchSummaryTab('tab-receives')" class="btn-quick-filter" style="padding:3px 8px; font-size:11.5px;">View All &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" style="font-size:12.5px;">
                    <thead>
                        <tr>
                            <th>Account / Party</th>
                            <th class="text-center">Count</th>
                            <th class="text-end">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ReceivesAccountWise.Any())
                        {
                            @foreach (var r in Model.ReceivesAccountWise.Take(6))
                            {
                                <tr>
                                    <td style="font-weight:600; color:var(--text);">@r.AccountName</td>
                                    <td class="text-center tnum" style="color:var(--text-dim);">@r.TransactionCount</td>
                                    <td class="text-end tnum" style="font-weight:700; color:var(--kpi-receives);">Rs @r.TotalAmount.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center" style="padding:20px; color:var(--text-faint);">No receives recorded in this period</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Top Pays Summary -->
        <div class="summary-table-card">
            <div class="summary-table-head">
                <h4 class="summary-table-title" style="color:var(--kpi-pays);">Top Accounts Adaigi</h4>
                <a href="javascript:void(0)" onclick="switchSummaryTab('tab-pays')" class="btn-quick-filter" style="padding:3px 8px; font-size:11.5px;">View All &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" style="font-size:12.5px;">
                    <thead>
                        <tr>
                            <th>Account / Party</th>
                            <th class="text-center">Count</th>
                            <th class="text-end">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PaysAccountWise.Any())
                        {
                            @foreach (var p in Model.PaysAccountWise.Take(6))
                            {
                                <tr>
                                    <td style="font-weight:600; color:var(--text);">@p.AccountName</td>
                                    <td class="text-center tnum" style="color:var(--text-dim);">@p.TransactionCount</td>
                                    <td class="text-end tnum" style="font-weight:700; color:var(--kpi-pays);">Rs @p.TotalAmount.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center" style="padding:20px; color:var(--text-faint);">No payments recorded in this period</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- TAB 2: RECEIVES ACCOUNT-WISE (WASOOLI)                                     -->
<!-- ========================================================================= -->
<div class="summary-tab-pane" id="tab-receives">
    
    <!-- Account Summary Mini Grid -->
    <div class="account-cards-grid">
        @foreach (var r in Model.ReceivesAccountWise)
        {
            <div class="account-kpi-card">
                <div>
                    <div class="account-card-name" title="@r.AccountName">@r.AccountName</div>
                    <div style="font-size:11px; color:var(--text-dim);">@r.AccountCategory</div>
                </div>
                <div class="account-card-meta">
                    <span class="tnum" style="font-weight:600;">@r.TransactionCount receipts</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--kpi-receives);">Rs @r.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        }
    </div>

    <!-- Detailed Receives Vouchers Table -->
    <div class="summary-table-card">
        <div class="summary-table-head">
            <h4 class="summary-table-title" style="color:var(--kpi-receives);">
                <span>All Receipts Vouchers in Period</span>
                <span class="tab-badge" style="background:var(--kpi-receives); color:#fff;">@Model.TotalReceivesCount</span>
            </h4>
            <input type="text" id="searchReceivesTable" class="table-search-input" placeholder="Search party, voucher, bank..." onkeyup="filterTable('receivesDataTable', this.value)" />
        </div>
        <div class="table-responsive">
            <table class="table mb-0" id="receivesDataTable" style="font-size:12.5px;">
                <thead>
                    <tr>
                        <th>Voucher #</th>
                        <th>Date</th>
                        <th>Received From (Account)</th>
                        <th>Received In (Cash / Bank)</th>
                        <th>Narration / Details</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllReceivesVouchers.Any())
                    {
                        @foreach (var v in Model.AllReceivesVouchers)
                        {
                            <tr>
                                <td style="font-weight:700; color:var(--teal-text);">@v.VoucherNo</td>
                                <td class="tnum" style="white-space:nowrap;">@v.Date</td>
                                <td style="font-weight:600; color:var(--text);">@v.AccountName</td>
                                <td style="color:var(--text-dim);"><span class="badge" style="background:var(--surface2); border:1px solid var(--border-soft); color:var(--text);">@v.CounterpartyOrBank</span></td>
                                <td style="color:var(--text-faint); max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(!string.IsNullOrEmpty(v.Narration) ? v.Narration : "-")</td>
                                <td class="text-end tnum" style="font-weight:700; color:var(--kpi-receives); font-size:13.5px;">Rs @v.Amount.ToString("N0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center" style="padding:30px; color:var(--text-faint);">No receipt vouchers found for this period</td></tr>
                    }
                </tbody>
                @if (Model.AllReceivesVouchers.Any())
                {
                    <tfoot>
                        <tr style="background:var(--surface2); font-weight:700;">
                            <td colspan="5" class="text-end">TOTAL WASOOLI (RECEIPTS):</td>
                            <td class="text-end tnum" style="color:var(--kpi-receives); font-size:15px;">Rs @Model.TotalReceivesAmount.ToString("N0")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- TAB 3: PAYS ACCOUNT-WISE (ADAIGI)                                         -->
<!-- ========================================================================= -->
<div class="summary-tab-pane" id="tab-pays">
    
    <!-- Account Summary Mini Grid -->
    <div class="account-cards-grid">
        @foreach (var p in Model.PaysAccountWise)
        {
            <div class="account-kpi-card">
                <div>
                    <div class="account-card-name" title="@p.AccountName">@p.AccountName</div>
                    <div style="font-size:11px; color:var(--text-dim);">@p.AccountCategory</div>
                </div>
                <div class="account-card-meta">
                    <span class="tnum" style="font-weight:600;">@p.TransactionCount payments</span>
                    <span class="tnum" style="font-size:14px; font-weight:700; color:var(--kpi-pays);">Rs @p.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        }
    </div>

    <!-- Detailed Pays Vouchers Table -->
    <div class="summary-table-card">
        <div class="summary-table-head">
            <h4 class="summary-table-title" style="color:var(--kpi-pays);">
                <span>All Payment Vouchers in Period</span>
                <span class="tab-badge" style="background:var(--kpi-pays); color:#fff;">@Model.TotalPaysCount</span>
            </h4>
            <input type="text" id="searchPaysTable" class="table-search-input" placeholder="Search supplier, voucher, bank..." onkeyup="filterTable('paysDataTable', this.value)" />
        </div>
        <div class="table-responsive">
            <table class="table mb-0" id="paysDataTable" style="font-size:12.5px;">
                <thead>
                    <tr>
                        <th>Voucher #</th>
                        <th>Date</th>
                        <th>Paid To (Account / Supplier)</th>
                        <th>Paid Via (Cash / Bank)</th>
                        <th>Narration / Details</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllPaysVouchers.Any())
                    {
                        @foreach (var v in Model.AllPaysVouchers)
                        {
                            <tr>
                                <td style="font-weight:700; color:var(--teal-text);">@v.VoucherNo</td>
                                <td class="tnum" style="white-space:nowrap;">@v.Date</td>
