        // Print All Suppliers Summary Report (Excluding Zero Balance Accounts)
        function printSupplierSummaryReportModal() {
            const fromDate = '@DateTime.Parse(Model.FromDate).ToString("dd-MMM-yyyy")';
            const toDate = '@DateTime.Parse(Model.ToDate).ToString("dd-MMM-yyyy")';
            const compName = '@(Model.CompanyName ?? "WEST WHARF WAREHOUSE")';

            let rowsHtml = '';
            @{
                var nonZeroPayables = Model.Payables?.Where(p => p.PayableBalance != 0 || (p.HasChildren && p.Children.Any(c => c.PayableBalance != 0))).ToList() ?? new List<ERP_Core.Dtos.SupplierPayableItemDto>();
                var sumOpening = Model.TotalOpeningBalance;
                var sumGross = Model.TotalPurchased;
                var sumPaid = Model.TotalPaid;
                var sumBalance = Model.TotalPayableSum;
                int totalBoatsCount = Model.TotalSuppliersCount;
            }

            @if (nonZeroPayables.Any())
            {
                int pIdx = 1;
                foreach (var s in nonZeroPayables)
                {
                    var statusBadge = s.Status == "Payable" || s.Status == "Due" ? "Payable" : (s.Status == "Advance" ? "Advance" : "Clear");
                    <text>
                    rowsHtml += `
                        <tr style="@(s.HasChildren ? "background:#faf8f5;" : "")">
                            <td class="sup-center" style="font-size:10px;padding:6px 2px;font-weight:600;">@pIdx</td>
                            <td class="sup-name" style="font-size:10.5px;padding:6px 5px;">
                                <div style="white-space:normal;word-break:break-word;overflow-wrap:anywhere;line-height:1.3;font-weight:600;">
                                    @s.SupplierName.Replace("'", "\\'")
                                    @if (s.HasChildren)
                                    {
                                        <span style="font-size:9px;color:#c68a3e;margin-left:4px;font-weight:700;">(@s.Children.Count Partner@(s.Children.Count > 1 ? "s" : ""))</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(s.AccountCode))
                                {
                                    <div style="font-size:9.5px;color:#8a5a1e;font-family:monospace;">@s.AccountCode</div>
                                }
                            </td>
                            <td class="sup-name" style="font-size:10px;padding:6px 4px;">
                                <div style="white-space:normal;word-break:break-word;overflow-wrap:anywhere;line-height:1.25;">@(string.IsNullOrWhiteSpace(s.VillageOrJetty) ? "-" : s.VillageOrJetty.Replace("'", "\\'"))</div>
                            </td>
                            <td class="sup-center" style="font-size:10px;padding:6px 2px;">@(string.IsNullOrWhiteSpace(s.Phone) || s.Phone == "0" ? "-" : s.Phone)</td>
                            <td class="sup-num" style="font-size:10px;padding:6px 4px;color:#555;">Rs @s.OpeningBalance.ToString("N0")</td>
                            <td class="sup-num" style="font-size:10.5px;padding:6px 4px;font-weight:600;color:#842029;">Rs @s.TotalSold.ToString("N0")</td>
                            <td class="sup-num" style="font-size:10.5px;padding:6px 4px;font-weight:600;color:#0f5132;">Rs @s.TotalPaid.ToString("N0")</td>
                            <td class="sup-num" style="font-size:10.5px;padding:6px 4px;font-weight:700;color:@(s.PayableBalance > 0 ? "#842029" : (s.PayableBalance < 0 ? "#0f5132" : "#333"));">
                                Rs @s.PayableBalance.ToString("N0")
                            </td>
                            <td class="sup-center" style="font-size:10px;padding:6px 2px;">
                                <span style="font-size:9.5px;padding:2px 5px;border-radius:4px;border:1px solid #ccc;font-weight:600;">@statusBadge</span>
                            </td>
                        </tr>
                    `;
                    </text>
                    if (s.HasChildren)
                    {
                        foreach (var c in s.Children)
                        {
                            var cStatus = c.Status == "Payable" || c.Status == "Due" ? "Payable" : (c.Status == "Advance" ? "Advance" : "Clear");
                            <text>
                            rowsHtml += `
                                <tr style="background:#f6f9f8;">
                                    <td class="sup-center" style="font-size:9px;color:#777;">↳</td>
                                    <td class="sup-name" style="font-size:10px;padding:5px 5px 5px 18px;">
                                        <div style="white-space:normal;word-break:break-word;overflow-wrap:anywhere;line-height:1.3;color:#1e3d34;font-weight:600;">
                                            ↳ @c.SupplierName.Replace("'", "\\'") <span style="font-size:8.5px;color:#c68a3e;font-weight:700;">(Partner)</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(c.AccountCode))
                                        {
                                            <div style="font-size:9px;color:#8a5a1e;font-family:monospace;">@c.AccountCode</div>
                                        }
                                    </td>
                                    <td class="sup-name" style="font-size:9.5px;padding:5px 4px;color:#666;">
                                        <div style="white-space:normal;word-break:break-word;overflow-wrap:anywhere;line-height:1.25;">@(string.IsNullOrWhiteSpace(c.VillageOrJetty) ? "-" : c.VillageOrJetty.Replace("'", "\\'"))</div>
                                    </td>
                                    <td class="sup-center" style="font-size:9.5px;padding:5px 2px;color:#666;">@(string.IsNullOrWhiteSpace(c.Phone) || c.Phone == "0" ? "-" : c.Phone)</td>
                                    <td class="sup-num" style="font-size:9.5px;padding:5px 4px;color:#666;">Rs @c.OpeningBalance.ToString("N0")</td>
                                    <td class="sup-num" style="font-size:10px;padding:5px 4px;font-weight:600;color:#842029;">Rs @c.TotalSold.ToString("N0")</td>
                                    <td class="sup-num" style="font-size:10px;padding:5px 4px;font-weight:600;color:#0f5132;">Rs @c.TotalPaid.ToString("N0")</td>
                                    <td class="sup-num" style="font-size:10px;padding:5px 4px;font-weight:700;color:@(c.PayableBalance > 0 ? "#842029" : (c.PayableBalance < 0 ? "#0f5132" : "#333"));">
                                        Rs @c.PayableBalance.ToString("N0")
                                    </td>
                                    <td class="sup-center" style="font-size:9.5px;padding:5px 2px;">
                                        <span style="font-size:9px;padding:1px 4px;border-radius:3px;border:1px solid #ddd;">@cStatus</span>
                                    </td>
                                </tr>
                            `;
                            </text>
                        }
                    }
                    pIdx++;
                }
            }

            const content = `
                <style>
                    #printModal .print-paper {
                        width: 215mm !important;
                        max-width: 96vw !important;
                        padding: 8mm 10mm !important;
                        box-sizing: border-box !important;
                    }
                    #printModal .print-modal-bar {
                        width: 215mm !important;
                        max-width: 96vw !important;
                    }
                    .sup-summary-tbl {
                        width: 100% !important;
                        border-collapse: collapse !important;
                        table-layout: fixed !important;
                        box-sizing: border-box !important;
                        margin-top: 14px;
                    }
                    .sup-summary-tbl th,
                    .sup-summary-tbl td {
                        box-sizing: border-box !important;
                        vertical-align: middle !important;
                    }
                    .sup-summary-tbl th {
                        background: #f4f6f5 !important;
                        color: #153229 !important;
                        font-weight: 700 !important;
                        font-size: 10px !important;
                        text-transform: uppercase !important;
                        padding: 6px 3px !important;
                        border: 1px solid #c5d6cf !important;
                        line-height: 1.2 !important;
                        text-align: center !important;
                        white-space: normal !important;
                        word-wrap: break-word !important;
                        word-break: normal !important;
                    }
                    .sup-summary-tbl td {
                        padding: 6px 4px !important;
                        font-size: 10.5px !important;
                        border: 1px solid #dde5e2 !important;
                        line-height: 1.3 !important;
                    }
                    .sup-summary-tbl tfoot td {
                        background: #f4f8f6 !important;
                        font-weight: 700 !important;
                        border-top: 2px solid #153229 !important;
                        font-size: 11px !important;
                        padding: 8px 4px !important;
                        line-height: 1.25 !important;
                    }
                    .sup-num {
                        text-align: right !important;
                        white-space: nowrap !important;
                        font-variant-numeric: tabular-nums !important;
                    }
                    .sup-center {
                        text-align: center !important;
                    }
                    .sup-name {
                        text-align: left !important;
                        white-space: normal !important;
                        word-wrap: break-word !important;
                        word-break: break-word !important;
                        overflow-wrap: anywhere !important;
                        line-height: 1.3 !important;
                    }
                    @@media print {
                        @@page {
                            size: A4 portrait;
                            margin: 8mm;
                        }
                        body.printing .print-paper {
                            width: 100% !important;
                            max-width: 100% !important;
                            padding: 0 !important;
                            box-shadow: none !important;
                        }
                    }
                </style>

                <div class="pp-head" style="margin-bottom:12px;padding-bottom:10px;">
                    <div class="pp-brand">
                        ${compName}
                        <div class="sub">Fish Commission Agents · Karachi Fish Harbour</div>
                    </div>
                    <div class="pp-doc-title">
                        <h2>Farmer PAYABLES SUMMARY</h2>
                        <div class="sub">Outstanding Balances · Zero Balance Accounts Excluded</div>
                    </div>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;background:#f8faf9;border:1px solid #cce0d8;border-radius:6px;padding:9px 14px;margin-bottom:14px;font-size:12px;">
                    <div>
                        <span style="font-size:10px;text-transform:uppercase;color:#666;font-weight:700;display:block;">Report Scope:</span>
                        <strong style="font-size:14px;color:#153229;">All Active Payables (@totalBoatsCount Boats/Farmers)</strong>
                    </div>
                    <div style="text-align:right;">
                        <span style="font-size:10px;text-transform:uppercase;color:#666;font-weight:700;display:block;">Statement Period:</span>
                        <strong style="font-size:13px;color:#153229;">${fromDate} to ${toDate}</strong>
                    </div>
                </div>

                <table class="sup-summary-tbl">
                    <thead>
                        <tr>
                            <th style="width:4%;">#</th>
                            <th style="width:23%;text-align:left;padding-left:6px !important;">Farmer Name</th>
                            <th style="width:13%;text-align:left;padding-left:5px !important;">Jetty / Village</th>
                            <th style="width:10%;">Phone</th>
                            <th style="width:10%;text-align:right;padding-right:5px !important;">Opening Bal</th>
                            <th style="width:11%;text-align:right;padding-right:5px !important;">Gross Catch</th>
                            <th style="width:11%;text-align:right;padding-right:5px !important;">Paid (Adaigi)</th>
                            <th style="width:11%;text-align:right;padding-right:5px !important;">Net Payable</th>
                            <th style="width:7%;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rowsHtml || `<tr><td colspan="9" style="text-align:center;padding:16px;">No payable records found with outstanding balance in this period.</td></tr>`}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" style="text-align:left;font-weight:700;padding-left:6px !important;">Total Summary (@totalBoatsCount Suppliers):</td>
                            <td class="sup-num" style="font-weight:700;">Rs @sumOpening.ToString("N0")</td>
                            <td class="sup-num" style="font-weight:700;color:#842029;">Rs @sumGross.ToString("N0")</td>
                            <td class="sup-num" style="font-weight:700;color:#0f5132;">Rs @sumPaid.ToString("N0")</td>
                            <td class="sup-num" style="font-weight:800;color:#8a5a1e;">Rs @sumBalance.ToString("N0")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>

                <div style="display:flex;justify-content:flex-end;margin-top:18px;margin-bottom:24px;">
                    <div style="background:#fff8ec;border:2px solid #c68a3e;border-radius:8px;padding:12px 24px;text-align:right;min-width:320px;display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:13px;font-weight:800;color:#8a5a1e;letter-spacing:0.5px;">TOTAL NET PAYABLE:</span>
                        <strong style="font-size:22px;color:#8a5a1e;margin-left:20px;">Rs @sumBalance.ToString("N0")</strong>
                    </div>
                </div>

                <div class="pp-sign" style="margin-top:35px;">
                    <div>Prepared By</div>
                    <div>Verified By</div>
                    <div>Accountant</div>
                </div>
            `;

            if (window.AarhatApp && window.AarhatApp.openPrintModal) {
                window.AarhatApp.openPrintModal("Print Farmer Payables Summary", content);
            } else {
                window.print();
            }
        }

        // Print Farmer Ledger Report
        function printSupplierLedgerReport() {
            const isSingle = @(Model.IsSingleSupplierView ? "true" : "false");
            const fromDate = '@Model.FromDate';
            const toDate = '@Model.ToDate';
            const supplierName = '@(Model.SelectedSupplierName ?? "Supplier")';
            const totalCredit = @Model.TotalPurchased;
            const totalDebit = @Model.TotalPaid;
            const closingBal = @Model.TotalPayableSum;
            const totalAdvance = @Model.TotalAdvance;
            const totalMartey = @Model.TotalMartey;
            const totalBillAmount = @Model.TotalBillAmount;

            if (isSingle) {
                const entries = [];
                // Add opening balance line
                entries.push({
                    date: fromDate,
                    ref: 'OPENING',
                    desc: 'Opening Balance Brought Forward',
                    debit: 0,
                    credit: 0,
                    balance: @Model.OpeningBalance
                });

                @if (Model.StatementTransactions != null)
                {
                    foreach (var tx in Model.StatementTransactions)
                    {
                        <text>
                        entries.push({
                            date: '@tx.DateFormatted',
                            ref: '@(tx.VoucherCode ?? tx.RefNo)',
                            desc: '@(tx.Description.Replace("'", "\\'"))@(string.IsNullOrWhiteSpace(tx.InvoiceNo) ? "" : $" (Inv: {tx.InvoiceNo})")',
                            debit: @tx.Debit,
                            credit: @tx.Credit,
                            balance: @tx.Balance
                        });
                        </text>
                    }
                }

                if (window.AarhatApp && window.AarhatApp.printLedgerStatement) {
                    window.AarhatApp.printLedgerStatement(supplierName + ' (Supplier)', fromDate, toDate, totalDebit, totalCredit, closingBal, entries, totalAdvance, totalMartey, totalBillAmount);
                } else {
                    window.print();
                }
            } else {
                printSupplierSummaryReportModal();
            }
        }
    </script>
}
