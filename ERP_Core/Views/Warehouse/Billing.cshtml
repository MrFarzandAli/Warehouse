@model List<ERP_Core.Models.WarehouseRentBill>

@{
    ViewData["Title"] = "Monthly Rent Invoicing";
    ViewData["SubTitle"] = "Remaining stock par monthly rolling bill aur lifter charges generate karein.";
    var dueLots = ViewBag.DueLots as List<ERP_Core.Models.WarehouseLot> ?? new List<ERP_Core.Models.WarehouseLot>();
    var unbilledLifter = ViewBag.UnbilledLifter as List<ERP_Core.Models.WarehouseLifterUsage> ?? new List<ERP_Core.Models.WarehouseLifterUsage>();
}

<div class="toolbar">
    <div style="display:flex;gap:10px;align-items:center;">
        <button type="button" class="btn brass" onclick="toggleGenerateBillSection()">
            <i class="fa fa-calculator me-1"></i> Generate Monthly Bill
        </button>
        <a asp-action="Inward" class="btn" style="background:var(--surface2);color:var(--text);">
            <i class="fa fa-boxes me-1"></i> Inward Lots
        </a>
    </div>

    <!-- Filter Form -->
    <form method="get" asp-action="Billing" style="display:flex;gap:10px;align-items:center;">
        <select name="partyId" style="padding:7px 12px;border-radius:6px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-size:12px;" onchange="this.form.submit()">
            <option value="">-- Tamam Parties --</option>
            @if (ViewBag.Parties != null)
            {
                foreach (var p in ViewBag.Parties)
                {
                    <option value="@p.Id" selected="@(ViewBag.SelectedPartyId == p.Id ? "selected" : null)">@p.Name</option>
                }
            }
        </select>
        <input type="date" name="billDate" value="@ViewBag.TargetDate" style="padding:6px 10px;border-radius:6px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-size:12px;" onchange="this.form.submit()" />
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:var(--green-dim);color:var(--green-text);padding:12px 16px;border-radius:8px;font-size:13px;margin-bottom:18px;border:1px solid var(--border);">
        <i class="fa fa-check-circle me-1"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="background:var(--red-dim);color:var(--red-text);padding:12px 16px;border-radius:8px;font-size:13px;margin-bottom:18px;border:1px solid var(--border);">
        <i class="fa fa-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- Generate Bill Interactive Panel -->
<div class="form-card" id="generateBillPanel" style="display:none;background:var(--surface);border:1px solid var(--border-soft);border-radius:10px;padding:20px;margin-bottom:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div>
            <h4 style="color:var(--brass);font-size:16px;font-weight:600;margin:0;">
                <i class="fa fa-file-invoice-dollar me-1"></i> Monthly Rent & Lifter Bill Generator
            </h4>
            <span style="font-size:12px;color:var(--text-dim);">Select party and review due remaining stock lots and lifter charges.</span>
        </div>
        <button type="button" class="btn" onclick="toggleGenerateBillSection()" style="padding:4px 8px;font-size:11px;background:transparent;color:var(--text-dim);">&times; Close</button>
    </div>

    <form asp-action="GenerateBill" method="post" id="genBillForm">
        @Html.AntiForgeryToken()
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:15px;margin-bottom:16px;">
            <div class="field">
                <label style="font-size:11.5px;color:var(--text-dim);margin-bottom:4px;display:block;">Select Party / Customer *</label>
                <select name="PartyId" id="billPartySelect" required style="width:100%;padding:8px 12px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);color:var(--text);font-size:13px;" onchange="onPartyChangeForBilling()">
                    <option value="">-- Party Select Karein --</option>
                    @if (ViewBag.Parties != null)
                    {
                        foreach (var p in ViewBag.Parties)
                        {
                            <option value="@p.Id" selected="@(ViewBag.SelectedPartyId == p.Id ? "selected" : null)">@p.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="field">
                <label style="font-size:11.5px;color:var(--text-dim);margin-bottom:4px;display:block;">Bill Date *</label>
                <input type="date" name="BillDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required style="width:100%;padding:8px 12px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);color:var(--text);font-size:13px;" />
            </div>

            <div class="field">
                <label style="font-size:11.5px;color:var(--text-dim);margin-bottom:4px;display:block;">Billing Month Title</label>
                <input type="text" name="BillingMonth" value="@DateTime.Today.ToString("MMMM yyyy")" style="width:100%;padding:8px 12px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);color:var(--text);font-size:13px;" />
            </div>

            <div class="field">
                <label style="font-size:11.5px;color:var(--text-dim);margin-bottom:4px;display:block;">Other Charges / Adjustment (Rs)</label>
                <input type="number" step="any" name="OtherCharges" value="0" style="width:100%;padding:8px 12px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);color:var(--text);font-size:13px;" oninput="updateGrandTotalPreview()" />
            </div>
        </div>

        <!-- 1. Due Lots Section -->
        <div style="margin-bottom:16px;">
            <h5 style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:8px;">
                <i class="fa fa-boxes me-1" style="color:var(--brass);"></i> Active Lots Due For Rent (Remaining Stock × Rate)
            </h5>
            <div style="background:var(--surface2);border-radius:8px;padding:10px;overflow-x:auto;">
                <table style="width:100%;font-size:12px;border-collapse:collapse;">
                    <thead>
                        <tr style="color:var(--text-dim);border-bottom:1px solid var(--border);text-align:left;">
                            <th style="padding:6px;"><input type="checkbox" id="checkAllLots" checked onchange="toggleAllLotChecks(this)" /></th>
                            <th style="padding:6px;">Lot No</th>
                            <th style="padding:6px;">Party</th>
                            <th style="padding:6px;">Item</th>
                            <th style="padding:6px;text-align:right;">Remaining Qty</th>
                            <th style="padding:6px;text-align:right;">Monthly Rate</th>
                            <th style="padding:6px;text-align:right;">Rent Amount</th>
                            <th style="padding:6px;">Next Bill Due Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dueLots.Any())
                        {
                            foreach (var lot in dueLots)
                            {
                                decimal lotRent = lot.CurrentRemainingQty * lot.MonthlyRentRate;
                                <tr style="border-bottom:1px solid var(--border-soft);" class="lot-row" data-party-id="@lot.PartyId">
                                    <td style="padding:6px;">
                                        <input type="checkbox" name="SelectedLotIds" value="@lot.LotId" checked class="lot-check" data-amount="@lotRent" onchange="updateGrandTotalPreview()" />
                                    </td>
                                    <td style="padding:6px;font-weight:600;color:var(--brass);">@lot.LotNo</td>
                                    <td style="padding:6px;">@(lot.Party?.Name ?? "")</td>
                                    <td style="padding:6px;">@(lot.Product?.Name ?? "")</td>
                                    <td style="padding:6px;text-align:right;font-weight:700;color:var(--green);">@lot.CurrentRemainingQty.ToString("N0")</td>
                                    <td style="padding:6px;text-align:right;">Rs @lot.MonthlyRentRate.ToString("N0")</td>
                                    <td style="padding:6px;text-align:right;font-weight:700;">Rs @lotRent.ToString("N0")</td>
                                    <td style="padding:6px;color:@(lot.NextBillingDate <= DateTime.Today ? "var(--red)" : "var(--text)");">
                                        @lot.NextBillingDate.ToString("dd-MMM-yyyy")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" style="padding:14px;text-align:center;color:var(--text-dim);">
                                    Filhal koi Lot rent billing ke liye due nahi hai.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 2. Unbilled Lifter Charges Section -->
        <div style="margin-bottom:16px;">
            <h5 style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:8px;">
                <i class="fa fa-pallet me-1" style="color:var(--brass);"></i> Unbilled Lifter / Forklift Charges
            </h5>
            <div style="background:var(--surface2);border-radius:8px;padding:10px;overflow-x:auto;">
                <table style="width:100%;font-size:12px;border-collapse:collapse;">
                    <thead>
                        <tr style="color:var(--text-dim);border-bottom:1px solid var(--border);text-align:left;">
                            <th style="padding:6px;"><input type="checkbox" id="checkAllLifter" checked onchange="toggleAllLifterChecks(this)" /></th>
                            <th style="padding:6px;">Date</th>
                            <th style="padding:6px;">Party</th>
                            <th style="padding:6px;">Basis</th>
                            <th style="padding:6px;text-align:right;">Hours / Qty</th>
                            <th style="padding:6px;text-align:right;">Rate</th>
                            <th style="padding:6px;text-align:right;">Lifter Amount</th>
                            <th style="padding:6px;">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (unbilledLifter.Any())
                        {
                            foreach (var lft in unbilledLifter)
                            {
                                <tr style="border-bottom:1px solid var(--border-soft);" class="lifter-row" data-party-id="@lft.PartyId">
                                    <td style="padding:6px;">
                                        <input type="checkbox" name="SelectedLifterUsageIds" value="@lft.LifterUsageId" checked class="lifter-check" data-amount="@lft.TotalAmount" onchange="updateGrandTotalPreview()" />
                                    </td>
                                    <td style="padding:6px;">@lft.UsageDate.ToString("dd-MMM-yyyy")</td>
                                    <td style="padding:6px;">@(lft.Party?.Name ?? "")</td>
                                    <td style="padding:6px;">@lft.UsageType</td>
                                    <td style="padding:6px;text-align:right;">@lft.QuantityOrHours.ToString("N1")</td>
                                    <td style="padding:6px;text-align:right;">Rs @lft.Rate.ToString("N0")</td>
                                    <td style="padding:6px;text-align:right;font-weight:700;color:var(--brass);">Rs @lft.TotalAmount.ToString("N0")</td>
                                    <td style="padding:6px;color:var(--text-dim);">@(lft.Remarks ?? "-")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" style="padding:14px;text-align:center;color:var(--text-dim);">
                                    Koi unbilled lifter usage nahi mila.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Grand Total Summary Banner -->
        <div style="background:var(--surface2);border-left:4px solid var(--green);padding:14px 20px;border-radius:8px;margin-bottom:16px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;">
            <div>
                <span style="font-size:12px;color:var(--text-dim);display:block;">Bill Ka Grand Total (Storage + Lifter + Other):</span>
                <b id="billGrandTotalText" style="font-size:22px;color:var(--green);">Rs 0.00</b>
            </div>
            <div>
                <button type="submit" class="btn brass" style="padding:10px 28px;font-size:14px;font-weight:600;">
                    <i class="fa fa-print me-1"></i> Generate & Post Monthly Bill
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Generated Bills List -->
<div class="table-card" style="background:var(--surface);border:1px solid var(--border-soft);border-radius:10px;padding:20px;overflow-x:auto;">
    <h4 style="font-size:15px;font-weight:600;margin-bottom:14px;color:var(--text);">
        <i class="fa fa-history me-1" style="color:var(--brass);"></i> Recent Generated Warehouse Bills
    </h4>

    <table class="table" style="width:100%;border-collapse:collapse;font-size:12.5px;">
        <thead>
            <tr style="border-bottom:2px solid var(--border);color:var(--text-dim);text-align:left;">
                <th style="padding:10px 8px;">Bill No</th>
                <th style="padding:10px 8px;">Bill Date</th>
                <th style="padding:10px 8px;">Billing Month</th>
                <th style="padding:10px 8px;">Party</th>
                <th style="padding:10px 8px;text-align:right;">Storage Rent</th>
                <th style="padding:10px 8px;text-align:right;">Lifter Charges</th>
                <th style="padding:10px 8px;text-align:right;">Grand Total</th>
                <th style="padding:10px 8px;text-align:center;">Status</th>
                <th style="padding:10px 8px;text-align:center;">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var bill in Model)
                {
                    <tr style="border-bottom:1px solid var(--border-soft);">
                        <td style="padding:10px 8px;font-weight:600;color:var(--brass);">@bill.BillNo</td>
                        <td style="padding:10px 8px;">@bill.BillDate.ToString("dd-MMM-yyyy")</td>
                        <td style="padding:10px 8px;font-weight:500;">@bill.BillingMonth</td>
                        <td style="padding:10px 8px;font-weight:600;">@(bill.Party?.Name ?? "N/A")</td>
                        <td style="padding:10px 8px;text-align:right;">Rs @bill.StorageRentTotal.ToString("N0")</td>
                        <td style="padding:10px 8px;text-align:right;color:var(--brass);">Rs @bill.LifterChargesTotal.ToString("N0")</td>
                        <td style="padding:10px 8px;text-align:right;font-weight:700;color:var(--green);font-size:13px;">
                            Rs @bill.GrandTotal.ToString("N0")
                        </td>
                        <td style="padding:10px 8px;text-align:center;">
                            <span style="background:var(--amber-dim);color:var(--amber-text);padding:3px 8px;border-radius:12px;font-size:11px;font-weight:600;">@bill.Status</span>
                        </td>
                        <td style="padding:10px 8px;text-align:center;">
                            <a asp-action="PrintBill" asp-route-id="@bill.BillId" target="_blank" class="btn" style="padding:4px 10px;font-size:11px;background:var(--surface2);color:var(--text);border:1px solid var(--border);">
                                <i class="fa fa-print me-1"></i> View / Print
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" style="padding:24px;text-align:center;color:var(--text-dim);">
                        Abhi tak koi monthly bill generate nahi hua. Upar "Generate Monthly Bill" button par click karein.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
function toggleGenerateBillSection() {
    const panel = document.getElementById('generateBillPanel');
    panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    if (panel.style.display === 'block') {
        updateGrandTotalPreview();
    }
}

function toggleAllLotChecks(master) {
    document.querySelectorAll('.lot-check').forEach(cb => {
        const row = cb.closest('.lot-row');
        if (row && row.style.display !== 'none') {
            cb.checked = master.checked;
        }
    });
    updateGrandTotalPreview();
}

function toggleAllLifterChecks(master) {
    document.querySelectorAll('.lifter-check').forEach(cb => {
        const row = cb.closest('.lifter-row');
        if (row && row.style.display !== 'none') {
            cb.checked = master.checked;
        }
    });
    updateGrandTotalPreview();
}

function onPartyChangeForBilling() {
    const selectedParty = document.getElementById('billPartySelect').value;
    
    // Filter lot rows
    document.querySelectorAll('.lot-row').forEach(row => {
        const pId = row.getAttribute('data-party-id');
        if (!selectedParty || pId === selectedParty) {
            row.style.display = '';
            row.querySelector('.lot-check').checked = true;
        } else {
            row.style.display = 'none';
            row.querySelector('.lot-check').checked = false;
        }
    });

    // Filter lifter rows
    document.querySelectorAll('.lifter-row').forEach(row => {
        const pId = row.getAttribute('data-party-id');
        if (!selectedParty || pId === selectedParty) {
            row.style.display = '';
            row.querySelector('.lifter-check').checked = true;
        } else {
            row.style.display = 'none';
            row.querySelector('.lifter-check').checked = false;
        }
    });

    updateGrandTotalPreview();
}

function updateGrandTotalPreview() {
    let total = 0;

    document.querySelectorAll('.lot-check:checked').forEach(cb => {
        const row = cb.closest('.lot-row');
        if (row && row.style.display !== 'none') {
            total += parseFloat(cb.getAttribute('data-amount')) || 0;
        }
    });

    document.querySelectorAll('.lifter-check:checked').forEach(cb => {
        const row = cb.closest('.lifter-row');
        if (row && row.style.display !== 'none') {
            total += parseFloat(cb.getAttribute('data-amount')) || 0;
        }
    });

    const other = parseFloat(document.querySelector('input[name="OtherCharges"]').value) || 0;
    total += other;

    document.getElementById('billGrandTotalText').innerText = 'Rs ' + total.toLocaleString('en-US', { minimumFractionDigits: 2 });
}
</script>
}
